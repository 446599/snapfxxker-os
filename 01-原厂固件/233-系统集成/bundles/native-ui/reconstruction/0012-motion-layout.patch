 //
 // DO NOT confuse this with other drawing APIs that use centerline+stroke!
 //
+// The compact cardinal pad has eight independent 1/10 mm targets. The
+// chevrons and digits share the same radial geometry as those hit regions.
+static void draw_fixed_ring_labels(lv_obj_t* obj, lv_layer_t* layer, lv_coord_t cx,
+                                   lv_coord_t cy, lv_coord_t radius, bool show_hub) {
+    lv_draw_label_dsc_t label;
+    lv_draw_label_dsc_init(&label);
+    label.base.obj = obj;
+    label.font = get_distance_font(radius);
+    label.color = theme_manager_get_color("text");
+    label.align = LV_TEXT_ALIGN_CENTER;
+    const lv_coord_t line_h = lv_font_get_line_height(label.font);
+    const lv_coord_t label_w = radius * 3 / 10;
+
+    lv_draw_line_dsc_t chevron;
+    lv_draw_line_dsc_init(&chevron);
+    chevron.color = label.color;
+    chevron.width = 2;
+    chevron.opa = LV_OPA_COVER;
+    const lv_coord_t arm = LV_MAX(3, radius / 25);
+    const int direction[4][2] = {{0, -1}, {1, 0}, {0, 1}, {-1, 0}};
+    for (int ring = 0; ring < 2; ++ring) {
+        const lv_coord_t text_r = radius * (ring == 0 ? 36 : 76) / 100;
+        const lv_coord_t arrow_r = radius * (ring == 0 ? 54 : 93) / 100;
+        label.text = ring == 0 ? "1" : "10";
+        for (const auto& dir : direction) {
+            const lv_coord_t x = cx + dir[0] * text_r;
+            const lv_coord_t y = cy + dir[1] * text_r;
+            lv_area_t area = {x - label_w / 2, y - line_h / 2,
+                              x - label_w / 2 + label_w - 1, y - line_h / 2 + line_h - 1};
+            lv_draw_label(layer, &label, &area);
+
+            const lv_coord_t tip_x = cx + dir[0] * arrow_r;
+            const lv_coord_t tip_y = cy + dir[1] * arrow_r;
+            chevron.p1.x = tip_x - dir[0] * arm - dir[1] * arm;
+            chevron.p1.y = tip_y - dir[1] * arm + dir[0] * arm;
+            chevron.p2.x = tip_x;
+            chevron.p2.y = tip_y;
+            lv_draw_line(layer, &chevron);
+            chevron.p1.x = tip_x - dir[0] * arm + dir[1] * arm;
+            chevron.p1.y = tip_y - dir[1] * arm - dir[0] * arm;
+            lv_draw_line(layer, &chevron);
+        }
+    }
+    if (show_hub) {
+        label.text = "XY\nmm";
+        const lv_coord_t hub_w = radius / 2;
+        lv_area_t area = {cx - hub_w / 2, cy - line_h,
+                          cx - hub_w / 2 + hub_w - 1, cy + line_h - 1};
+        lv_draw_label(layer, &label, &area);
+    }
+}
