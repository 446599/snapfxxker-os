diff --git a/src/ui/overlay_geometry.cpp b/src/ui/overlay_geometry.cpp
index acc0871..e6d1255 100644
--- a/src/ui/overlay_geometry.cpp
+++ b/src/ui/overlay_geometry.cpp
@@ -52,6 +52,10 @@ const char* nav_width_suffix(int32_t hor_res, int32_t ver_res) {
 
 OverlayWidths compute_overlay_widths(int32_t hor_res, int32_t ver_res, int32_t nav_width,
                                      int32_t gap) {
+    // A horizontal navbar occupies no width; both overlay classes span its content area.
+    if (nav_width == 0) {
+        return {hor_res, hor_res};
+    }
     // Classified from raw dimensions rather than LayoutManager::type(): this
     // runs in Application phase 6 and the layout manager is not initialised
     // until phase 8b. detect_layout_type() is the same function the variant
@@ -106,6 +110,17 @@ void ui_set_overlay_geometry(lv_obj_t* obj, bool is_destination) {
     lv_obj_t* screen = lv_obj_get_screen(obj);
     const lv_coord_t screen_width = screen ? lv_obj_get_width(screen) : 800;
     const lv_coord_t screen_height = screen ? lv_obj_get_height(screen) : 480;
+    lv_obj_t* navbar = screen ? lv_obj_find_by_name(screen, "navbar") : nullptr;
+    if (navbar && lv_obj_get_width(navbar) >= screen_width) {
+        lv_area_t nav_area;
+        lv_area_t screen_area;
+        lv_obj_get_coords(navbar, &nav_area);
+        lv_obj_get_coords(screen, &screen_area);
+        lv_obj_set_width(obj, screen_width);
+        lv_obj_set_height(obj, nav_area.y1 - screen_area.y1);
+        lv_obj_set_align(obj, LV_ALIGN_TOP_MID);
+        return;
+    }
     const bool portrait =
         helix::is_portrait_layout(helix::detect_layout_type(screen_width, screen_height));
 
