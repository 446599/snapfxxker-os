<component>
  <!-- WiFi Network List Item - Reusable Component -->
  <!-- Displays network SSID, signal strength icon, and security status -->
  <!-- Uses responsive theme tokens: #space_lg for padding, #font_body for text -->
  <!-- Connected network is indicated via LV_STATE_CHECKED - adds left border accent -->
  <!-- Click triggers the owner's callback, named by the click_callback prop -->
  <api>
    <prop name="click_callback" type="string" default=""/>
  </api>
  <styles>
    <!-- Style applied when item has LV_STATE_CHECKED (connected network) -->
    <style name="checked_style" border_width="#space_xs" border_side="left" border_color="#primary" bg_color="#elevated_bg"/>
  </styles>
  <view extends="lv_button" width="100%" scrollable="false" clickable="true" style_bg_opa="255" style_border_width="#u1_border" style_shadow_width="0" style_pad_ver="#space_sm" style_pad_hor="#space_md" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#u1_card_gap" style_min_height="#u1_touch_target" style_pad_all="#u1_page_pad" style_radius="#u1_card_radius" style_border_color="#border" style_border_opa="255" style_bg_color="#card_bg">
    <style name="checked_style" selector="checked"/>
    <event_cb trigger="clicked" callback="$click_callback"/>
    <!-- Signal strength icons - 8 variants controlled by signal_icon_state subject -->
    <!-- States 1-4: unsecured networks, States 5-8: secured networks (with lock) -->
    <!-- Only one icon visible at a time via bind_flag_if_not_eq binding -->
    <lv_obj name="signal_icons" style_pad_all="0" clickable="false">
      <!-- Unsecured: strength 1 (weak) -->
      <icon name="sig_1" src="wifi_strength_1" size="sm" variant="primary" clickable="false" hidden="true"/>
      <!-- Unsecured: strength 2 (fair) -->
      <icon name="sig_2" src="wifi_strength_2" size="sm" variant="primary" clickable="false" hidden="true"/>
      <!-- Unsecured: strength 3 (good) -->
      <icon name="sig_3" src="wifi_strength_3" size="sm" variant="primary" clickable="false" hidden="true"/>
      <!-- Unsecured: strength 4 (strong) - default visible -->
      <icon name="sig_4" src="wifi_strength_4" size="sm" variant="primary" clickable="false"/>
      <!-- Secured: strength 1 (weak) -->
      <icon name="sig_1_lock" src="wifi_strength_1_lock" size="sm" variant="primary" clickable="false" hidden="true"/>
      <!-- Secured: strength 2 (fair) -->
      <icon name="sig_2_lock" src="wifi_strength_2_lock" size="sm" variant="primary" clickable="false" hidden="true"/>
      <!-- Secured: strength 3 (good) -->
      <icon name="sig_3_lock" src="wifi_strength_3_lock" size="sm" variant="primary" clickable="false" hidden="true"/>
      <!-- Secured: strength 4 (strong) -->
      <icon name="sig_4_lock" src="wifi_strength_4_lock" size="sm" variant="primary" clickable="false" hidden="true"/>
    </lv_obj>
    <!-- SSID and security type column (center) -->
    <lv_obj flex_grow="1" style_pad_all="0" style_radius="0" style_pad_gap="#space_xs" scrollable="false" clickable="false" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="start">
      <!-- Network SSID - uses responsive font_body from theme -->
      <text_body name="ssid_label" clickable="false" width="100%" flex_grow="0" long_mode="dots" style_text_font="#font_body_bold"/>
      <!-- Right-justified metadata: band badge then security type -->
      <lv_obj width="content" height="content" style_pad_all="0" style_radius="0" style_pad_gap="#space_xs" scrollable="false" clickable="false" flex_flow="row" style_flex_cross_place="center">
        <!-- Band badge ("2.4G" / "5G" / "2.4/5G"). Hidden unless the scan saw
             more than one band; text and visibility are driven by per-item
             subjects owned by the C++ list builder. -->
        <text_small name="band_label" clickable="false" hidden="true"/>
        <!-- Security type -->
        <text_small name="security_label" clickable="false"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
