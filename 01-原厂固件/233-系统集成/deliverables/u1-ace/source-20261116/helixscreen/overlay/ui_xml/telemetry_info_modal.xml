<!-- Telemetry Info Modal - Explains what we collect and why -->
<!-- Used from wizard summary step "Learn more" link -->
<component>
  <view name="telemetry_info_modal" extends="ui_dialog" width="90%" height="80%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" clickable="true" scrollable="false" style_max_height="94%" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Header -->
    <lv_obj width="100%" height="content" style_pad_left="#u1_page_pad" style_pad_right="#u1_page_pad" style_pad_top="#u1_page_pad" style_pad_bottom="#u1_page_pad" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#u1_card_gap" scrollable="true" style_max_height="#dialog_content_max" scroll_dir="ver" scrollbar_mode="auto">
      <icon src="chart_line" size="md" variant="primary"/>
      <text_heading text="What We Collect"/>
    </lv_obj>
    <!-- Scrollable markdown content — flex_grow fills space between header and button -->
    <lv_obj name="content_area" width="100%" flex_grow="1" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0" style_pad_bottom="#space_md" scrollable="true" scroll_snap_y="none">
      <ui_markdown name="info_text" width="100%" bind_text="telemetry_info_text"/>
    </lv_obj>
    <!-- Single OK button, always visible at bottom -->
    <modal_button_row hide_secondary="true" primary_text="Got it"/>
  </view>
</component>
