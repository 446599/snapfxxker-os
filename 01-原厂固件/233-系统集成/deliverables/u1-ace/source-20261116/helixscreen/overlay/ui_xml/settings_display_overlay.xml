<!-- Display Settings Overlay: brightness, dim, sleep, screensaver, rotation, UI scale -->
<!-- Uses setting_* components for consistency with main settings panel -->
<component>
  <view name="settings_display_overlay" extends="overlay_panel" title="Display" bg_color="#screen_bg" title_transform="none" title_color="#text">
    <lv_obj name="overlay_content" width="100%" height="0" flex_grow="1" scrollable="true" flex_flow="column" scrollbar_mode="auto" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" scroll_dir="ver">
      <setting_group name="group_display" style_margin_left="0" style_margin_right="0" style_margin_bottom="0">
        <style name="styles.u1_card"/>
        <!-- Screen Rotation: first in the group so a user staring at a sideways
             screen reaches it with the least scrolling. Hidden where the display
             backend ignores /display/rotate (SDL desktop builds). -->
        <setting_dropdown_row name="row_display_rotation" label="Screen Rotation" icon="rotate_right" description="Turn the picture to match how the screen is mounted. Applies after restart." options="Normal&#10;90° Clockwise&#10;180° Upside Down&#10;270° Clockwise" options_tag="Normal&#10;90° Clockwise&#10;180° Upside Down&#10;270° Clockwise" callback="on_display_rotation_changed">
          <bind_flag_if_eq subject="settings_rotation_available" flag="hidden" ref_value="0"/>
        </setting_dropdown_row>
        <!-- UI Scale (options populated dynamically in C++ — the Automatic row
             carries the DPI-resolved percentage) -->
        <setting_dropdown_row name="row_ui_scale" label="UI Scale" icon="magnify" description="Interface size. Applies after restart." options="" callback="on_ui_scale_changed"/>
        <!-- Brightness (conditional - hidden when no hardware backlight) -->
        <lv_obj name="brightness_section" width="100%" height="content" scrollable="false" flex_flow="column">
          <bind_flag_if_eq subject="settings_has_dimming" flag="hidden" ref_value="0"/>
          <bind_style_if_le name="styles.setting_row_compact" subject="ui_breakpoint" ref_value="1"/>
          <bind_style_if_ge name="styles.setting_row_standard" subject="ui_breakpoint" ref_value="2"/>
          <!-- Label row with value display -->
          <lv_obj width="100%" height="content" flex_flow="row" style_flex_track_place="center" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false">
            <lv_obj width="#u1_icon_badge" height="#u1_icon_badge" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false">
              <icon src="light" size="sm" variant="secondary" align="center"/>
            </lv_obj>
            <text_body width="0" flex_grow="1" text="Brightness" style_text_font="#font_body_bold"/>
            <lv_obj name="info_btn" width="#u1_touch_target" height="#u1_touch_target" style_pad_all="0" style_bg_opa="0" style_border_width="0" clickable="true" scrollable="false">
              <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="2"/>
              <icon src="info_outline" size="sm" variant="muted" align="center" clickable="false" event_bubble="true"/>
              <event_cb trigger="clicked" callback="on_setting_info_clicked"/>
            </lv_obj>
            <text_muted name="brightness_value_label" bind_text="brightness_value"/>
          </lv_obj>
          <!-- Description -->
          <text_small name="description" width="100%" text="Adjust screen brightness level" long_mode="wrap">
            <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="2"/>
          </text_small>
          <!-- Slider with min/max icons -->
          <lv_obj width="100%" height="#u1_touch_target" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false">
            <icon src="light_off" size="xs" variant="secondary"/>
            <lv_slider name="brightness_slider" width="0" flex_grow="1" ext_click_area="18" min_value="10" max_value="100" value="50">
              <event_cb trigger="value_changed" callback="on_brightness_changed"/>
              <!-- Persist once on release; value_changed only previews (settings.json
                 is fsync'd twice + backed up, and some backlight backends fork). -->
              <event_cb trigger="released" callback="on_brightness_commit"/>
            </lv_slider>
            <icon src="light" size="xs" variant="primary"/>
          </lv_obj>
        </lv_obj>
        <!-- Screen Dim -->
        <setting_dropdown_row name="row_display_dim" label="Screen Dim" icon="lightbulb_on_50" description="Screen dims to lower brightness after period of inactivity" options="Never&#10;30 seconds&#10;1 minute&#10;2 minutes&#10;5 minutes&#10;10 minutes" options_tag="Never&#10;30 seconds&#10;1 minute&#10;2 minutes&#10;5 minutes&#10;10 minutes" callback="on_dim_changed">
          <bind_flag_if_not_eq subject="settings_dim_row_kind" flag="hidden" ref_value="1"/>
        </setting_dropdown_row>
        <!-- No dimmable backlight: the same dim timeout starts the screensaver -->
        <setting_dropdown_row name="row_screensaver_after" label="Screensaver after" icon="television_classic" description="Screensaver starts after this period of inactivity" options="Never&#10;30 seconds&#10;1 minute&#10;2 minutes&#10;5 minutes&#10;10 minutes" options_tag="Never&#10;30 seconds&#10;1 minute&#10;2 minutes&#10;5 minutes&#10;10 minutes" callback="on_dim_changed">
          <bind_flag_if_not_eq subject="settings_dim_row_kind" flag="hidden" ref_value="2"/>
        </setting_dropdown_row>
        <!-- Display Sleep -->
        <setting_dropdown_row name="row_display_sleep" label="Display Sleep" icon="clock" description="Screen sleeps after the selected period of inactivity" options="Never&#10;1 minute&#10;5 minutes&#10;10 minutes&#10;20 minutes&#10;30 minutes&#10;1 hour" options_tag="Never&#10;1 minute&#10;5 minutes&#10;10 minutes&#10;20 minutes&#10;30 minutes&#10;1 hour" callback="on_sleep_changed"/>
        <!-- Screensaver: the full list is the translation source; DisplaySettingsOverlay
             rebuilds the options without the savers too heavy for this board. Hidden in
             builds without screensavers (settings_has_screensaver = 0). -->
        <setting_dropdown_row name="row_screensaver" label="Screensaver" icon="television_classic" description="Show instead of dimming" options="Off&#10;Flying Toasters&#10;Starfield&#10;3D Pipes&#10;Bouncing Printer&#10;Fireworks&#10;Bouncing Logo&#10;3D Maze&#10;Hyperspace&#10;Flip Clock&#10;Fireflies&#10;Aqua Surface&#10;High Fly&#10;Random" options_tag="Off&#10;Flying Toasters&#10;Starfield&#10;3D Pipes&#10;Bouncing Printer&#10;Fireworks&#10;Bouncing Logo&#10;3D Maze&#10;Hyperspace&#10;Flip Clock&#10;Fireflies&#10;Aqua Surface&#10;High Fly&#10;Random" callback="on_screensaver_changed" hidden="true">
          <bind_flag_if_eq subject="settings_has_screensaver" flag="hidden" ref_value="0"/>
        </setting_dropdown_row>
        <!-- Test Screensaver button (hidden when Off is selected). Starts hidden so it
             stays hidden wherever the binding cannot resolve. -->
        <lv_obj name="container_test_screensaver" width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_sm" style_pad_bottom="#space_md" style_pad_gap="0" flex_flow="row" style_flex_main_place="end" scrollable="false" hidden="true">
          <bind_flag_if_eq subject="settings_screensaver_type" flag="hidden" ref_value="0"/>
          <ui_button name="btn_test_screensaver" width="content" height="#u1_touch_target" style_pad_ver="#u1_compact_gap" variant="outline" text="Test Screensaver" icon="play">
            <event_cb trigger="clicked" callback="on_test_screensaver"/>
          </ui_button>
        </lv_obj>
        <!-- Print progress card on savers without their own print display; hidden with the
             screensaver off or not built. Starts hidden for the same reason as the Test button. -->
        <setting_toggle_row name="row_screensaver_print_progress" label="Show Print Progress" icon="progress_clock" description="Show time left on screensavers during a print" subject="settings_screensaver_print_progress" callback="on_screensaver_print_progress_changed" hidden="true">
          <bind_flag_if cond="settings_screensaver_type eq 0 or settings_has_screensaver eq 0" flag="hidden"/>
        </setting_toggle_row>
        <!-- Sleep While Printing -->
        <setting_toggle_row name="row_sleep_while_printing" label="Sleep While Printing" icon="sleep" description="Allow display to sleep during active prints" subject="settings_sleep_while_printing" callback="on_sleep_while_printing_changed"/>
        <!-- Info Note -->
        <info_note icon="info" text="Touch screen to wake from sleep" style_pad_left="#space_lg" style_pad_right="#space_lg"/>
      </setting_group>
    </lv_obj>
  </view>
</component>
