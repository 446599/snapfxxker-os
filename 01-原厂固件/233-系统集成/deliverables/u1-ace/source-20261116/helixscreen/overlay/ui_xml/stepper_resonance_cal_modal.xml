<component>
  <api>
    <prop name="message" type="string" default=""/>
  </api>
  <!-- Stepper resonance calibration on a printer whose routine runs with one
       chosen tool. The tool options and the message come from
       StepperResonanceCalModal. Backdrop created by the Modal system. -->
  <view name="stepper_resonance_cal_modal" extends="ui_dialog" width="94%" height="94%" style_min_width="0" style_max_width="480" style_max_height="94%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" scrollable="false" style_radius="#u1_card_radius">
    <lv_obj width="100%" height="44" style_pad_all="8" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
      <icon src="sine_wave" size="md" variant="primary"/>
      <text_heading text="Vertical Artifact Compensation" long_mode="wrap" flex_grow="1"/>
    </lv_obj>
    <lv_obj width="100%" height="0" style_pad_left="12" style_pad_right="12" style_pad_top="8" style_pad_bottom="8" flex_flow="column" style_flex_cross_place="start" style_pad_gap="#u1_card_gap" scrollable="true" scroll_snap_y="none" style_pad_all="8" flex_grow="1">
      <text_small width="100%" long_mode="wrap" text="$message" style_text_color="#text_muted" style_text_align="left"/>
      <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="space_between" style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="false">
        <text_body text="Tool" flex_grow="1"/>
        <lv_dropdown name="tool_dropdown" width="100%" style_radius="#border_radius" style_min_height="#u1_touch_target" height="#u1_touch_target"/>
      </lv_obj>
    </lv_obj>
    <modal_button_row primary_text="Start" secondary_text="Cancel" primary_moves_machine="true"/>
  </view>
</component>
