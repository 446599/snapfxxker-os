<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- Button handlers belong to whichever screen shows the modal -->
  <api>
    <prop name="cancel_callback" type="string" default=""/>
    <prop name="connect_callback" type="string" default=""/>
  </api>
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="wifi_password_modal" extends="ui_dialog" width="90%" style_max_width="#u1_modal_width" height="content" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" style_max_height="94%" scrollable="false" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- ============================================================ -->
    <!-- STATE: IDLE - Password entry form (hidden when connecting) -->
    <!-- ============================================================ -->
    <modal_header title="Enter WiFi Password" title_name="modal_title" icon_src="wifi" icon_variant="muted">
      <bind_flag_if_eq subject="wifi_connecting" flag="hidden" ref_value="1"/>
    </modal_header>
    <lv_obj name="password_form_container" width="100%" height="content" style_pad_hor="#u1_card_pad_roomy" style_pad_top="0" style_pad_bottom="#u1_card_pad" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#u1_card_gap" style_max_height="#dialog_content_max" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
      <!-- Hide form when wifi_connecting == 1 -->
      <bind_flag_if_eq subject="wifi_connecting" flag="hidden" ref_value="1"/>
      <!-- Network SSID -->
      <text_small name="modal_ssid" width="100%" long_mode="wrap" style_text_font="#u1_aux_font" bind_text="wifi_password_modal_ssid" style_text_align="left" style_text_color="#text_muted"/>
      <!-- Password input with visibility toggle -->
      <lv_obj width="100%" height="#input_height" style_min_height="#u1_touch_target" flex_flow="row" style_pad_all="0" style_pad_gap="#u1_compact_gap">
        <text_input name="password_input" width="0" height="100%" flex_grow="1" placeholder_text="Password" placeholder_tag="Password" translation_tag="Password" password_mode="true" style_min_height="#u1_touch_target" style_radius="#u1_card_radius"/>
        <ui_button name="eye_toggle" width="#u1_touch_target" height="100%" variant="ghost" icon="eye_off" click_focusable="false" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
          <event_cb trigger="clicked" callback="on_toggle_password_visibility"/>
        </ui_button>
      </lv_obj>
      <!-- Status message (hidden by default, shown on error) -->
      <text_small name="modal_status" width="100%" long_mode="wrap" style_text_font="#u1_aux_font" text="" style_text_align="left" style_text_color="#danger" hidden="true"/>
    </lv_obj>
    <!-- ============================================================ -->
    <!-- STATE: CONNECTING - Spinner and status (shown when connecting) -->
    <!-- ============================================================ -->
    <lv_obj name="connecting_container" width="100%" height="#dialog_content_max" style_pad_all="#u1_card_pad_roomy" hidden="true" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
      <!-- Show spinner when wifi_connecting == 1 -->
      <bind_flag_if_eq subject="wifi_connecting" flag="hidden" ref_value="0"/>
      <spinner size="lg" align="center"/>
      <text_muted text="Connecting..." style_margin_top="#u1_card_gap" align="center"/>
    </lv_obj>
    <!-- Connect is withdrawn while a connection attempt runs; Cancel stays. -->
    <modal_button_row secondary_name="modal_cancel_btn" secondary_text="Cancel" secondary_callback="$cancel_callback" primary_name="modal_connect_btn" primary_text="Connect" primary_callback="$connect_callback" primary_hide_subject="wifi_connecting"/>
  </view>
</component>
