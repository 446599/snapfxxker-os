<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <api>
    <prop name="title" type="string" default="Exclude Object?"/>
    <prop name="message" type="string" default="Stop printing this object?"/>
  </api>
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="exclude_object_modal" extends="ui_dialog" width="94%" height="content" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" style_max_height="94%" style_pad_all="0" style_bg_color="#card_bg" style_bg_opa="255" style_radius="#border_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Header row with warning icon + title -->
    <lv_obj width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg" style_pad_bottom="#space_sm" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm">
      <!-- Warning icon (always shown for exclude action) -->
      <icon name="icon_warning" src="alert" size="md" variant="warning"/>
      <!-- Title -->
      <text_heading name="dialog_title" text="$title" style_text_align="left" flex_grow="1" style_max_height="#button_height_lg" long_mode="dots"/>
    </lv_obj>
    <!-- Message content area -->
    <lv_obj name="content_container" width="100%" height="content" style_min_height="40" style_max_height="#dialog_content_max" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="0" style_pad_bottom="#space_lg" scrollable="true" scrollbar_mode="active">
      <text_body name="dialog_message" width="100%" text="$message" style_text_align="left" long_mode="wrap"/>
    </lv_obj>
    <!-- Button row -->
    <!-- Buttons are wired in ExcludeObjectModal::on_show() via wire_ok_button()/
         wire_cancel_button(); no XML callback names to resolve. -->
    <modal_button_row secondary_text="Cancel" primary_text="Exclude"/>
  </view>
</component>
