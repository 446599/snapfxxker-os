<?xml version='1.0' encoding='UTF-8'?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Four everyday controls, with the complete native dashboard retained under System. -->
<component>
  <consts>
    <px name="u1_controls_tile_min_width" value="160"/>
    <px name="u1_controls_tile_h_small" value="80"/>
    <px name="u1_controls_tile_h_tiny" value="72"/>
    <px name="u1_controls_tile_h_medium" value="104"/>
    <px name="u1_controls_tile_h_large" value="120"/>
  </consts>
  <styles>
    <style name="home_btn_homed" bg_color="#primary" bg_opa="255"/>
    <style name="home_btn_unhomed" bg_color="#elevated_bg" bg_opa="255"/>
    <style name="indicator_homed" bg_color="#success"/>
    <style name="indicator_unhomed" bg_color="#text_muted"/>
  </styles>
  <view name="controls_panel" extends="lv_obj" width="100%" height="100%" flex_flow="column" style_pad_all="0" style_pad_gap="0" style_border_width="0" style_bg_color="#screen_bg" scrollable="false">
    <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
    <lv_obj name="u1_controls_main" width="100%" height="100%" flex_flow="column"
            style_pad_all="0" style_pad_gap="0" scrollable="false">
      <bind_flag_if_eq subject="u1_controls_show_all" flag="hidden" ref_value="1"/>
      <u1_controls_overview/>
    </lv_obj>
    <lv_obj name="u1_controls_all_panel" width="100%" height="100%" flex_flow="column"
            style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver">
      <bind_flag_if_eq subject="u1_controls_show_all" flag="hidden" ref_value="0"/>
      <ui_button name="u1_controls_back_main" width="100%" height="#u1_touch_target" text="常用控制" icon="arrow_left" variant="ghost">
        <event_cb trigger="clicked" callback="on_u1_controls_main"/>
      </ui_button>
      <text_heading text="设备控制" width="100%"/>
      <responsive_grid name="u1_controls_grid" min_col_width="#u1_controls_tile_min_width" max_cols="2" fit_items="false" style_pad_column="#u1_card_gap" style_pad_row="#u1_card_gap">
        <lv_obj name="card_position" height="#u1_controls_tile_h" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#space_xs" style_flex_main_place="center" clickable="true" scrollable="false">
          <style name="styles.u1_card"/>
          <style name="styles.press_wash" selector="pressed"/>
          <event_cb trigger="clicked" callback="on_controls_quick_actions"/>
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
            <icon src="axis_arrow" size="sm" variant="text" clickable="false" event_bubble="true"/>
            <text_body text="移动" flex_grow="1" clickable="false" event_bubble="true"/>
            <icon src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true"/>
          </lv_obj>
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false" clickable="false" event_bubble="true">
            <text_small text="X"/>
            <text_small name="pos_x" bind_text="controls_pos_x" long_mode="dots" width="0" flex_grow="1"/>
            <text_small text="Y"/>
            <text_small name="pos_y" bind_text="controls_pos_y" long_mode="dots" width="0" flex_grow="1"/>
            <text_small text="Z"/>
            <text_small name="pos_z" bind_text="controls_pos_z" long_mode="dots" width="0" flex_grow="1"/>
          </lv_obj>
        </lv_obj>
        <lv_obj name="card_temperatures" height="#u1_controls_tile_h" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#space_xs" style_flex_main_place="center" clickable="true" scrollable="false">
          <style name="styles.u1_card"/>
          <style name="styles.press_wash" selector="pressed"/>
          <event_cb trigger="clicked" callback="on_nozzle_temp_clicked"/>
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
            <icon src="nozzle" size="sm" variant="text" clickable="false" event_bubble="true"/>
            <text_body text="喷头温度" flex_grow="1" clickable="false" event_bubble="true"/>
            <icon src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true"/>
          </lv_obj>
          <temp_display name="nozzle_temp_display" size="sm" show_target="true" bind_current="extruder_temp" bind_target="extruder_target" clickable="false" event_bubble="true"/>
        </lv_obj>
        <lv_obj name="btn_bed_temp" height="#u1_controls_tile_h" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#space_xs" style_flex_main_place="center" clickable="true" scrollable="false">
          <style name="styles.u1_card"/>
          <style name="styles.press_wash" selector="pressed"/>
          <event_cb trigger="clicked" callback="on_bed_temp_clicked"/>
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
            <icon src="radiator" size="sm" variant="text" clickable="false" event_bubble="true"/>
            <text_body text="热床温度" flex_grow="1" clickable="false" event_bubble="true"/>
            <icon src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true"/>
          </lv_obj>
          <temp_display name="bed_temp_display" size="sm" show_target="true" bind_current="bed_temp" bind_target="bed_target" clickable="false" event_bubble="true"/>
        </lv_obj>
        <lv_obj name="card_cooling" height="#u1_controls_tile_h" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#space_xs" style_flex_main_place="center" clickable="true" scrollable="false">
          <style name="styles.u1_card"/>
          <style name="styles.press_wash" selector="pressed"/>
          <event_cb trigger="clicked" callback="on_controls_cooling"/>
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
            <icon src="fan" size="sm" variant="text" clickable="false" event_bubble="true"/>
            <text_body text="风扇" flex_grow="1" clickable="false" event_bubble="true"/>
            <icon src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true"/>
          </lv_obj>
          <text_body name="fan_speed_display" bind_text="controls_fan_speed" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
        </lv_obj>
        <lv_obj name="btn_home_all" height="#u1_controls_tile_h" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#space_xs" style_flex_main_place="center" clickable="true" scrollable="false">
          <style name="styles.u1_card"/>
          <style name="styles.press_wash" selector="pressed"/>
          <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
          <bind_state_if cond="machine_motion_blocked" state="disabled"/>
          <event_cb trigger="clicked" callback="on_controls_home_all"/>
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
            <icon src="home" size="sm" variant="text" clickable="false" event_bubble="true"/>
            <text_body text="全部归零" flex_grow="1" clickable="false" event_bubble="true"/>
            <icon src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true"/>
          </lv_obj>
          <text_small text="X / Y / Z" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
        </lv_obj>
        <lv_obj name="btn_motors" height="#u1_controls_tile_h" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#space_xs" style_flex_main_place="center" clickable="true" scrollable="false">
          <style name="styles.u1_card"/>
          <style name="styles.press_wash" selector="pressed"/>
          <bind_state_if cond="machine_motion_blocked" state="disabled"/>
          <event_cb trigger="clicked" callback="on_calibration_motors"/>
          <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
            <icon src="engine_off" size="sm" variant="text" clickable="false" event_bubble="true"/>
            <text_body text="释放电机" flex_grow="1" clickable="false" event_bubble="true"/>
            <icon src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true"/>
          </lv_obj>
          <text_small text="手动移动前关闭" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
          <bind_state_if_eq subject="motors_enabled" state="disabled" ref_value="0"/>
        </lv_obj>
      </responsive_grid>
      <lv_obj name="btn_chamber_temp" width="100%" height="#u1_touch_target" flex_flow="row" style_pad_all="#u1_page_pad" style_pad_gap="#space_md" style_flex_cross_place="center" clickable="true" scrollable="false">
        <style name="styles.u1_card"/>
        <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_chamber_temp_clicked"/>
        <text_body text="腔体温度" flex_grow="1" clickable="false" event_bubble="true"/>
        <temp_display name="chamber_temp_display" size="sm" show_target="true" bind_current="chamber_temp" bind_target="chamber_effective_target" bind_mode="chamber_mode" clickable="false" event_bubble="true"/>
      </lv_obj>
      <lv_obj name="secondary_temps_list" width="100%" height="#u1_touch_target" style_pad_all="#u1_page_pad" clickable="true" scrollable="false">
        <style name="styles.u1_card"/>
        <bind_flag_if_eq subject="controls_more_sensors_count" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_controls_more_sensors"/>
        <text_body name="more_sensors_label" bind_text="controls_more_sensors" align="left_mid" clickable="false" event_bubble="true"/>
      </lv_obj>
      <lv_obj name="secondary_fans_list" width="100%" height="content" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#space_sm" clickable="true" scrollable="false">
        <style name="styles.u1_card"/>
        <event_cb trigger="clicked" callback="on_controls_secondary_fans"/>
      </lv_obj>
      <text_heading text="校准与维护" width="100%"/>
      <responsive_grid name="calib_tools_grid" min_col_width="#u1_controls_tile_min_width" max_cols="2" fit_items="false" style_pad_column="#u1_card_gap" style_pad_row="#u1_card_gap">
        <ui_button name="btn_bed_mesh" text="热床网格" icon="grid_large" height="#u1_touch_target" variant="secondary">
          <event_cb trigger="clicked" callback="on_calibration_bed_mesh"/>
        </ui_button>
        <ui_button name="btn_z_calibration" text="Z 高度校准" icon="z_closer" height="#u1_touch_target" variant="secondary" moves_machine="true">
          <bind_flag_if cond="z_offset_reapplied_per_head eq 1 or (printer_has_tool_offset_cal eq 1 and hide_manual_z_calibration eq 1)" flag="hidden"/>
          <event_cb trigger="clicked" callback="on_calibration_zoffset"/>
        </ui_button>
        <ui_button name="btn_tool_offsets" text="四头偏移校准" icon="axis_arrow" height="#u1_touch_target" variant="secondary" moves_machine="true" hidden="true">
          <bind_flag_if_eq subject="printer_has_tool_offset_cal" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_calibration_tool_offsets"/>
        </ui_button>
        <ui_button name="btn_qgl" text="QGL" icon="spirit_level" height="#u1_touch_target" variant="secondary" moves_machine="true" hidden="true">
          <bind_flag_if cond="printer_has_qgl eq 0" flag="hidden"/>
          <bind_state_if cond="controls_operation_in_progress eq 1" state="disabled"/>
          <event_cb trigger="clicked" callback="on_controls_qgl"/>
        </ui_button>
        <ui_button name="btn_z_tilt" text="Z-Tilt" icon="spirit_level" height="#u1_touch_target" variant="secondary" moves_machine="true" hidden="true">
          <bind_flag_if cond="printer_has_z_tilt eq 0" flag="hidden"/>
          <bind_state_if cond="controls_operation_in_progress eq 1" state="disabled"/>
          <event_cb trigger="clicked" callback="on_controls_z_tilt"/>
        </ui_button>
        <ui_button name="btn_pa_cal" text="压力提前校准" icon="gauge" height="#u1_touch_target" variant="secondary" moves_machine="true" hidden="true">
          <bind_flag_if cond="printer_has_pa_cal eq 0" flag="hidden"/>
          <event_cb trigger="clicked" callback="on_calibration_pa"/>
        </ui_button>
        <ui_button name="btn_screws" text="热床螺丝" icon="wrench" height="#u1_touch_target" variant="secondary" moves_machine="true" hidden="true">
          <bind_flag_if cond="printer_has_screws_tilt eq 0" flag="hidden"/>
          <event_cb trigger="clicked" callback="on_calibration_screws"/>
        </ui_button>
      </responsive_grid>
      <lv_obj name="u1_zoffset_row" width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false">
        <ui_button name="btn_zoffset_tune" width="0" flex_grow="1" height="#u1_touch_target" text="Z 偏移微调" variant="secondary">
          <event_cb trigger="clicked" callback="on_zoffset_tune"/>
        </ui_button>
        <ui_button name="btn_save_z_offset" width="0" flex_grow="1" height="#u1_touch_target" text="保存 Z 偏移" variant="primary" moves_machine="true">
          <bind_flag_if_eq subject="z_offset_save_available" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_controls_save_z_offset"/>
        </ui_button>
      </lv_obj>
      <ui_card name="card_quick_actions" width="100%" height="content" flex_grow="0" flex_flow="column" style_flex_main_place="space_between" style_radius="#u1_card_radius" style_pad_all="#u1_page_pad" scrollable="false" style_pad_gap="#u1_card_gap">
        <lv_obj flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_all="0" style_pad_gap="#space_sm">
          <bind_flag_if_eq subject="macro_header_visible" flag="hidden" ref_value="0"/>
          <icon src="flash" size="sm" variant="primary"/>
          <text_small text="快捷操作" style_translate_y="2" style_text_color="#text"/>
        </lv_obj>
        <lv_obj width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs">
          <text_small text="归零" style_min_width="40"/>
          <button_group flex_grow="0" height="content">
            <button_group_item name="btn_home_all_shortcut" width="0" style_min_width="content" style_pad_hor="#space_xs" text="全部" flex_grow="1" style_border_width="0" moves_machine="true" height="#u1_touch_target">
              <bind_style name="home_btn_homed" subject="all_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="all_homed" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_all"/>
            </button_group_item>
            <button_group_item name="btn_home_x" width="0" style_min_width="content" style_pad_hor="#space_xs" text="X" flex_grow="1" moves_machine="true" height="#u1_touch_target">
              <bind_style name="home_btn_homed" subject="x_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="x_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_x"/>
            </button_group_item>
            <button_group_item name="btn_home_y" width="0" style_min_width="content" style_pad_hor="#space_xs" text="Y" flex_grow="1" moves_machine="true" height="#u1_touch_target">
              <bind_style name="home_btn_homed" subject="y_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="y_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_y"/>
            </button_group_item>
            <button_group_item name="btn_home_xy" width="0" style_min_width="content" style_pad_hor="#space_xs" text="XY" flex_grow="1" moves_machine="true" height="#u1_touch_target">
              <bind_style name="home_btn_homed" subject="xy_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="xy_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_xy"/>
            </button_group_item>
            <button_group_item name="btn_home_z" width="0" style_min_width="content" style_pad_hor="#space_xs" text="Z" flex_grow="1" moves_machine="true" height="#u1_touch_target">
              <bind_style name="home_btn_homed" subject="z_homed" ref_value="1"/>
              <bind_style name="home_btn_unhomed" subject="z_homed" ref_value="0"/>
              <bind_flag_if_eq subject="printer_has_individual_xyz_homing" flag="hidden" ref_value="0"/>
              <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_controls_home_z"/>
            </button_group_item>
          </button_group>
        </lv_obj>
        <lv_obj width="100%" flex_grow="0" style_pad_all="0" scrollable="false" flex_flow="column" style_pad_gap="#space_xs" style_flex_main_place="end" height="content">
          <lv_obj width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
            <ui_button name="btn_macro_1" width="0" height="#u1_touch_target" style_pad_ver="0" flex_grow="1" bind_text="macro_1_name" variant="secondary" style_text_font="#font_small" long_mode="wrap" moves_machine="true">
              <bind_flag_if_eq subject="macro_1_visible" flag="hidden" ref_value="0"/>
              <bind_state_if cond="macro_1_available eq 0" state="disabled"/>
              <event_cb trigger="clicked" callback="on_controls_macro" user_data="0"/>
            </ui_button>
            <lv_obj name="macro_1_light_cell" width="0" height="#button_height" flex_grow="1" style_pad_all="0" scrollable="false" hidden="true">
              <bind_flag_if cond="macro_1_light eq 0 or led_controllable eq 0" flag="hidden"/>
              <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
              <ui_button name="light_button" width="100%" height="#u1_touch_target" style_pad_ver="0" variant="secondary" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_xs" focusable="false">
                <bind_state_if cond="printer_connection_state ne 2 or led_command_in_flight eq 1" state="disabled"/>
                <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
                <icon name="light_icon" src="lightbulb_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
                <text_small text="Light" clickable="false" event_bubble="true"/>
                <event_cb trigger="clicked" callback="light_toggle_cb"/>
              </ui_button>
            </lv_obj>
            <ui_button name="btn_macro_2" width="0" height="#u1_touch_target" style_pad_ver="0" flex_grow="1" bind_text="macro_2_name" variant="secondary" style_text_font="#font_small" long_mode="wrap" moves_machine="true">
              <bind_flag_if_eq subject="macro_2_visible" flag="hidden" ref_value="0"/>
              <bind_state_if cond="macro_2_available eq 0" state="disabled"/>
              <event_cb trigger="clicked" callback="on_controls_macro" user_data="1"/>
            </ui_button>
            <lv_obj name="macro_2_light_cell" width="0" height="#button_height" flex_grow="1" style_pad_all="0" scrollable="false" hidden="true">
              <bind_flag_if cond="macro_2_light eq 0 or led_controllable eq 0" flag="hidden"/>
              <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
              <ui_button name="light_button" width="100%" height="#u1_touch_target" style_pad_ver="0" variant="secondary" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_xs" focusable="false">
                <bind_state_if cond="printer_connection_state ne 2 or led_command_in_flight eq 1" state="disabled"/>
                <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
                <icon name="light_icon" src="lightbulb_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
                <text_small text="Light" clickable="false" event_bubble="true"/>
                <event_cb trigger="clicked" callback="light_toggle_cb"/>
              </ui_button>
            </lv_obj>
          </lv_obj>
          <lv_obj width="100%" height="content" style_pad_all="0" scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
            <ui_button name="btn_macro_3" width="0" height="#u1_touch_target" style_pad_ver="0" flex_grow="1" bind_text="macro_3_name" variant="secondary" style_text_font="#font_small" long_mode="wrap" moves_machine="true">
              <bind_flag_if_eq subject="macro_3_visible" flag="hidden" ref_value="0"/>
              <bind_state_if cond="macro_3_available eq 0" state="disabled"/>
              <event_cb trigger="clicked" callback="on_controls_macro" user_data="2"/>
            </ui_button>
            <lv_obj name="macro_3_light_cell" width="0" height="#button_height" flex_grow="1" style_pad_all="0" scrollable="false" hidden="true">
              <bind_flag_if cond="macro_3_light eq 0 or led_controllable eq 0" flag="hidden"/>
              <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
              <ui_button name="light_button" width="100%" height="#u1_touch_target" style_pad_ver="0" variant="secondary" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_xs" focusable="false">
                <bind_state_if cond="printer_connection_state ne 2 or led_command_in_flight eq 1" state="disabled"/>
                <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
                <icon name="light_icon" src="lightbulb_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
                <text_small text="Light" clickable="false" event_bubble="true"/>
                <event_cb trigger="clicked" callback="light_toggle_cb"/>
              </ui_button>
            </lv_obj>
            <ui_button name="btn_macro_4" width="0" height="#u1_touch_target" style_pad_ver="0" flex_grow="1" bind_text="macro_4_name" variant="secondary" style_text_font="#font_small" long_mode="wrap" moves_machine="true">
              <bind_flag_if_eq subject="macro_4_visible" flag="hidden" ref_value="0"/>
              <bind_state_if cond="macro_4_available eq 0" state="disabled"/>
              <event_cb trigger="clicked" callback="on_controls_macro" user_data="3"/>
            </ui_button>
            <lv_obj name="macro_4_light_cell" width="0" height="#button_height" flex_grow="1" style_pad_all="0" scrollable="false" hidden="true">
              <bind_flag_if cond="macro_4_light eq 0 or led_controllable eq 0" flag="hidden"/>
              <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
              <ui_button name="light_button" width="100%" height="#u1_touch_target" style_pad_ver="0" variant="secondary" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_xs" focusable="false">
                <bind_state_if cond="printer_connection_state ne 2 or led_command_in_flight eq 1" state="disabled"/>
                <!-- DUPLICATE_NAME_OK: each slot cell is scoped to its own LedWidget lookup -->
                <icon name="light_icon" src="lightbulb_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
                <text_small text="Light" clickable="false" event_bubble="true"/>
                <event_cb trigger="clicked" callback="light_toggle_cb"/>
              </ui_button>
            </lv_obj>
          </lv_obj>
        </lv_obj>
      </ui_card>
    </lv_obj>
  </view>
</component>
