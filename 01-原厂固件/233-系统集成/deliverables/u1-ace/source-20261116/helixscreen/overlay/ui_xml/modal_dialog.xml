<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <api>
    <prop name="title" type="string"/>
    <prop name="title_tag" type="string" default=""/>
    <prop name="message" type="string"/>
    <prop name="message_tag" type="string" default=""/>
    <prop name="primary_text" type="string" default="OK"/>
    <prop name="secondary_text" type="string" default="Cancel"/>
    <prop name="hide_info" type="string" default="false"/>
    <prop name="hide_warning" type="string" default="true"/>
    <prop name="hide_error" type="string" default="true"/>
    <prop name="hide_secondary" type="string" default="true"/>
    <prop name="primary_variant" type="string" default="primary"/>
  </api>
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="modal_dialog" extends="ui_dialog" width="90%" style_max_width="#u1_modal_width" height="content" style_max_height="94%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" scrollable="false" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Header row with icon + title -->
    <lv_obj width="100%" height="content" style_pad_hor="#u1_card_pad_roomy" style_pad_ver="#u1_card_pad" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#u1_card_gap" style_min_height="#u1_header_height">
      <!-- Exactly one severity icon is visible; the caller passes the hide_* flags. -->
      <icon name="icon_info" src="info" size="sm" variant="primary" hidden="$hide_info"/>
      <icon name="icon_warning" src="alert" size="sm" variant="warning" hidden="$hide_warning"/>
      <icon name="icon_error" src="alert_octagon" size="sm" variant="danger" hidden="$hide_error"/>
      <!-- Title -->
      <text_heading name="dialog_title" width="0" style_text_font="#font_display_small" style_text_color="#text" max_lines="2" text="$title" translation_tag="$title_tag" style_text_align="left" flex_grow="1" long_mode="dots"/>
    </lv_obj>
    <!-- Message content area (scrollable for long content) -->
    <!-- Max height ensures long content scrolls instead of making dialog huge -->
    <lv_obj name="content_container" width="100%" height="content" style_max_height="#dialog_content_max" style_pad_hor="#u1_card_pad_roomy" style_pad_top="0" style_pad_bottom="#u1_card_pad_roomy" scrollable="true" scroll_dir="ver" scrollbar_mode="auto" scroll_snap_y="none">
      <text_body name="dialog_message" width="100%" style_text_font="#u1_body_font" style_text_color="#text" style_text_line_space="#u1_compact_gap" text="$message" translation_tag="$message_tag" style_text_align="left" long_mode="wrap"/>
    </lv_obj>
    <!-- Shared footer row: the cancel button (and its divider) stay hidden
         unless hide_secondary is "false". Callbacks are wired
         programmatically per-instance, not via XML. -->
    <modal_button_row hide_secondary="$hide_secondary" primary_text="$primary_text" secondary_text="$secondary_text" primary_variant="$primary_variant"/>
  </view>
</component>
