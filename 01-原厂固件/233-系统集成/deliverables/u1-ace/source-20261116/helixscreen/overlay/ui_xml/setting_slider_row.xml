<!-- Reusable Settings Slider Row Component -->
<!-- Responsive: compact padding on micro breakpoint, info icon for descriptions -->
<component>
  <api>
    <prop name="label" type="string" default="Setting"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
    <prop name="description" type="string" default=""/>
    <prop name="description_tag" type="string" default=""/>
    <prop name="min" type="string" default="0"/>
    <prop name="max" type="string" default="100"/>
    <prop name="value" type="string" default="50"/>
    <prop name="callback" type="string" default=""/>
    <prop name="user_data" type="string" default=""/>
    <!-- Event trigger: "value_changed" fires per-tick during drag (default,
         back-compat for sliders whose callback is cheap or wants live readout);
         "released" fires once when the user lifts. Use "released" when the
         callback persists settings or pops a modal. -->
    <prop name="trigger" type="string" default="value_changed"/>
    <!-- Optional second handler for the apply-vs-persist split. A slider that
         needs live feedback (backlight, volume readout) must keep firing on
         value_changed, but persisting there writes settings.json — fsync'd
         twice, plus a rolling backup — on EVERY drag tick. Point `callback` at
         the cheap live apply and `commit_callback` at the save; the latter
         fires once, on release. Defaults to the globally registered no-op. -->
    <prop name="commit_callback" type="string" default=""/>
    <prop name="commit_trigger" type="string" default="released"/>
    <prop name="min_icon" type="string" default=""/>
    <prop name="max_icon" type="string" default=""/>
    <prop name="disabled" type="string" default=""/>
    <!-- Tap-to-type: a registered callback turns the value display into a
         setting_value_field showing value_text, for a range too wide for a slider
         to land on an exact number. Empty keeps the plain value label. -->
    <prop name="value_callback" type="string" default=""/>
    <prop name="value_text" type="string" default=""/>
  </api>
  <styles>
    <style name="label_enabled" text_color="#text"/>
    <style name="label_disabled" text_color="#text_subtle"/>
    <style name="slider_standard" pad_top="#space_sm" pad_bottom="#space_sm" margin_top="#space_xs"/>
    <style name="slider_micro" pad_top="#space_xs" pad_bottom="#space_xs" margin_top="0"/>
  </styles>
  <view name="slider_row" extends="lv_obj" width="100%" height="content" flex_flow="column" style_bg_opa="0" style_border_width="0" scrollable="false" style_min_height="#u1_touch_target">
    <bind_style_if_le name="styles.setting_row_compact" subject="ui_breakpoint" ref_value="1"/>
    <bind_style_if_ge name="styles.setting_row_standard" subject="ui_breakpoint" ref_value="2"/>
    <!-- Top row: Icon, label, info icon, value display -->
    <lv_obj width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false" style_flex_track_place="center">
      <!-- Left side: Icon and label -->
      <lv_obj width="0" height="content" flex_grow="1" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#u1_card_gap" style_pad_all="0" scrollable="false" style_flex_track_place="center">
        <lv_obj scrollable="false">
          <style name="styles.u1_setting_icon_slot"/>
          <icon hidden_if_empty="$icon" name="row_icon" src="$icon" size="sm" variant="secondary" align="center"/>
        </lv_obj>
        <text_body name="label" width="0" flex_grow="1" long_mode="wrap" text="$label" translation_tag="$label_tag" style_text_font="#font_body_bold">
          <bind_style name="label_enabled" subject="$disabled" ref_value="0"/>
          <bind_style name="label_disabled" subject="$disabled" ref_value="1"/>
        </text_body>
        <!-- Info icon: hidden if no description, hidden on medium+ -->
        <lv_obj width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" hidden_if_empty="$description">
          <lv_obj name="info_btn" width="#u1_touch_target" height="#u1_touch_target" style_pad_all="0" style_bg_opa="0" style_border_width="0" clickable="true" event_bubble="false" scrollable="false" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
            <bind_flag_if_gt subject="ui_breakpoint" flag="hidden" ref_value="1"/>
            <icon src="info_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
            <event_cb trigger="clicked" callback="on_setting_info_clicked"/>
          </lv_obj>
        </lv_obj>
      </lv_obj>
      <!-- Right side: Current value -->
      <text_muted name="value_label" text="$value" hidden_if_prop_not_eq="$value_callback|"/>
      <setting_value_field name="value_field" value="$value_text" callback="$value_callback" hidden_if_empty="$value_callback"/>
    </lv_obj>
    <!-- Description: hidden on micro/tiny by default -->
    <lv_obj width="100%" height="content" style_pad_all="0" style_border_width="0" style_bg_opa="0" scrollable="false" hidden_if_empty="$description">
      <text_small name="description" style_text_font="#u1_aux_font" width="100%" text="$description" translation_tag="$description_tag" long_mode="wrap">
        <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="2"/>
      </text_small>
    </lv_obj>
    <!-- Slider with optional min/max icons -->
    <lv_obj name="slider_container" width="100%" height="#u1_touch_target" flex_flow="row" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false" style_flex_track_place="center">
      <bind_style_if_le name="slider_micro" subject="ui_breakpoint" ref_value="1"/>
      <bind_style_if_ge name="slider_standard" subject="ui_breakpoint" ref_value="2"/>
      <icon name="min_icon" src="$min_icon" size="xs" variant="secondary" hidden_if_empty="$min_icon"/>
      <lv_slider name="slider" width="0" flex_grow="1" ext_click_area="18" min_value="$min" max_value="$max" value="$value">
        <bind_state_if_eq subject="$disabled" state="disabled" ref_value="1"/>
        <event_cb trigger="$trigger" callback="$callback" user_data="$user_data"/>
        <event_cb trigger="$commit_trigger" callback="$commit_callback" user_data="$user_data"/>
      </lv_slider>
      <icon name="max_icon" src="$max_icon" size="xs" variant="secondary" hidden_if_empty="$max_icon"/>
    </lv_obj>
  </view>
</component>
