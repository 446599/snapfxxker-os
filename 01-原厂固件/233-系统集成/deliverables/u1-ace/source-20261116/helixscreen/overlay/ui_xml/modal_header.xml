<!-- Reusable modal header: optional leading icon + title + optional trailing close (X). -->
<!-- The flexible title leaves room for the close target. -->
<!-- Usage A (icon + title, no X):  <modal_header icon_src="alert" icon_variant="danger" title="Factory Reset" title_tag="Factory Reset"/> -->
<!-- Usage B (title + X):           <modal_header title="Edit" title_tag="Edit" hide_icon="true" hide_close="false" close_callback="my_close_cb"/> -->
<!-- Usage C (bound title + X):     <modal_header title_subject="my_title_subj" hide_icon="true" hide_close="false" close_callback="my_close_cb"/> -->
<component>
  <api>
    <prop name="icon_src" type="string" default=""/>
    <prop name="icon_variant" type="string" default="accent"/>
    <!-- Icon shown by default (existing icon+title consumers). Title-only modals pass hide_icon="true". -->
    <prop name="hide_icon" type="string" default="false"/>
    <prop name="title" type="string" default=""/>
    <prop name="title_tag" type="string" default=""/>
    <!-- No default: when omitted the bind_text attribute is dropped (no empty-subject warning). -->
    <prop name="title_subject" type="string"/>
    <prop name="hide_close" type="string" default="true"/>
    <!-- Empty default resolves to the registered no-op callback (xml_registration.cpp) — no warning. -->
    <prop name="close_callback" type="string" default=""/>
    <prop name="close_user_data" type="string" default=""/>
    <prop name="icon_name" type="string" default="header_icon"/>
    <prop name="title_name" type="string" default="header_title"/>
    <prop name="close_name" type="string" default="btn_close"/>
  </api>
  <view extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_pad_hor="#u1_card_pad_roomy" style_pad_ver="#u1_compact_gap" style_pad_gap="#u1_card_gap" style_flex_track_place="center" scrollable="false" style_min_height="#u1_header_height" style_bg_opa="0" style_border_width="0">
    <icon name="$icon_name" src="$icon_src" size="sm" variant="$icon_variant" hidden="$hide_icon"/>
    <text_heading name="$title_name" width="0" style_text_font="#font_display_small" style_text_color="#text" text="$title" translation_tag="$title_tag" bind_text="$title_subject" style_text_align="left" flex_grow="1" long_mode="dots" max_lines="2"/>
    <ui_button name="$close_name" width="#u1_touch_target" height="#u1_touch_target" hidden="$hide_close" icon="close" variant="ghost" focusable="false">
      <event_cb trigger="clicked" callback="$close_callback" user_data="$close_user_data"/>
    </ui_button>
  </view>
</component>
