<!-- Settings > Plugins: the frame; PluginsOverlay builds one row per plugin. -->
<component>
  <api>
    <prop name="title" type="string" default="Plugins"/>
    <prop name="title_tag" type="string" default="Plugins"/>
  </api>
  <view name="plugins_overlay" extends="overlay_panel" title="$title" title_tag="$title_tag" bg_color="#screen_bg" title_transform="none">
    <!-- Content Area - no padding, rows handle their own -->
    <lv_obj name="overlay_content" width="100%" flex_grow="1" style_pad_top="#u1_page_pad" style_pad_left="#u1_page_pad" style_pad_right="#u1_page_pad" style_pad_bottom="#u1_page_pad" scrollable="true" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" scrollbar_mode="auto">
      <lv_obj name="plugins_rows" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="column"/>
    </lv_obj>
  </view>
</component>
