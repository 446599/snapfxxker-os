<!-- Sound Settings Overlay: master toggle, volume, UI sounds, theme, output device -->
<!-- Uses setting_* components for consistency with main settings panel -->
<component>
  <view name="settings_sound_overlay" extends="overlay_panel" title="Sound" bg_color="#screen_bg" title_transform="none" title_color="#text">
    <lv_obj name="overlay_content" width="100%" height="0" flex_grow="1" scrollable="true" flex_flow="column" scrollbar_mode="auto" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" scroll_dir="ver">
      <setting_group name="group_sound" style_margin_left="0" style_margin_right="0" style_margin_bottom="0">
        <style name="styles.u1_card"/>
        <bind_flag_if_eq subject="printer_has_speaker" flag="hidden" ref_value="0"/>
        <!-- Master Sounds Toggle -->
        <lv_obj name="container_sounds" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="printer_has_speaker" flag="hidden" ref_value="0"/>
          <setting_toggle_row name="row_sounds" label="Sounds" icon="notifications" description="Enable audio feedback" subject="settings_sounds_enabled" callback="on_sounds_changed"/>
        </lv_obj>
        <!-- Volume Slider (hidden when master sounds off) -->
        <lv_obj name="container_volume" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="settings_sounds_enabled" flag="hidden" ref_value="0"/>
          <setting_slider_row name="row_volume" label="Volume" icon="volume_high" description="Master volume level" min="0" max="100" value="80" min_icon="volume_off" max_icon="volume_high" callback="on_volume_changed" commit_callback="on_volume_commit"/>
        </lv_obj>
        <!-- UI Sounds Toggle (hidden when master sounds off) -->
        <lv_obj name="container_ui_sounds" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="settings_sounds_enabled" flag="hidden" ref_value="0"/>
          <setting_toggle_row name="row_ui_sounds" label="UI Sounds" icon="notifications" description="Button taps and navigation sounds" subject="settings_ui_sounds_enabled" callback="on_ui_sounds_changed"/>
        </lv_obj>
        <!-- Sound Theme Dropdown (hidden when master sounds off) -->
        <lv_obj name="container_sound_theme" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="settings_sounds_enabled" flag="hidden" ref_value="0"/>
          <setting_dropdown_row name="row_sound_theme" label="Sound Theme" icon="tune" description="Choose sound style" callback="on_sound_theme_changed"/>
        </lv_obj>
        <!-- Output Device Dropdown: shown only when sounds are on AND an ALSA
             backend with device selection is active. This one compound cond owns
             the row's visibility; a second hide in C++ would race the binding. -->
        <lv_obj name="container_audio_device" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if cond="settings_sounds_enabled eq 0 or settings_audio_device_available eq 0" flag="hidden"/>
          <setting_dropdown_row name="row_audio_device" label="Output Device" icon="volume_high" description="Where UI sounds play" callback="on_audio_device_changed"/>
        </lv_obj>
        <!-- Preview Sounds (hidden when master sounds off) -->
        <lv_obj name="container_preview_sounds" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if_eq subject="settings_sounds_enabled" flag="hidden" ref_value="0"/>
          <setting_action_row name="row_preview_sounds" label="Preview Sounds" icon="play" description="Listen to all theme sounds" callback="on_preview_sounds"/>
        </lv_obj>
        <!-- Test Tracker (hidden when sounds are off or the backend plays tones only) -->
        <lv_obj name="container_test_tracker" width="100%" style_pad_all="0" scrollable="false">
          <bind_flag_if cond="settings_sounds_enabled eq 0 or settings_music_available eq 0" flag="hidden"/>
          <setting_action_row name="row_test_tracker" label="Test Tracker" icon="tune" description="Play / stop Crockett's Theme" callback="on_test_tracker"/>
        </lv_obj>
      </setting_group>
    </lv_obj>
  </view>
</component>
