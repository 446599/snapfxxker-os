<!-- Theme Save As Modal - Save theme with new name -->
<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <!-- Dialog card (backdrop created programmatically) -->
  <view name="theme_save_as_modal" extends="ui_dialog" width="90%" height="content" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" style_max_height="94%" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Content area -->
    <lv_obj name="save_as_form_container" width="100%" height="content" style_pad_left="#u1_page_pad" style_pad_right="#u1_page_pad" style_pad_top="#u1_page_pad" style_pad_bottom="#u1_page_pad" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#u1_card_gap" style_max_height="#dialog_content_max" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
      <!-- Title -->
      <text_heading width="100%" text="Save Theme As" style_text_align="center"/>
      <!-- Instructions -->
      <text_small width="100%" text="Enter a name for your custom theme:" style_text_align="center" style_text_color="#text_muted"/>
      <!-- Theme name input -->
      <text_input name="theme_name_input" width="100%" height="#input_height" placeholder_text="My Custom Theme" placeholder_tag="My Custom Theme" translation_tag="My Custom Theme" style_margin_top="#space_sm" style_min_height="#u1_touch_target" style_radius="#u1_card_radius"/>
      <!-- Status message (hidden by default) -->
      <text_small name="save_as_status" width="100%" text="" style_text_align="center" style_text_color="#danger" hidden="true"/>
    </lv_obj>
    <modal_button_row primary_text="Save" secondary_text="Cancel" primary_callback="on_theme_save_as_confirm" secondary_callback="on_theme_save_as_cancel"/>
  </view>
</component>
