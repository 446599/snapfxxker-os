      <icon src="alert_octagon" size="lg" variant="danger"/>
      <!-- Title -->
      <text_heading width="100%" text="Emergency Stop?" style_text_align="center"/>
      <!-- Warning message -->
      <text_muted width="100%" text="This will immediately halt all printer operations. The printer will require a restart to resume." long_mode="wrap" style_text_align="center"/>
    </lv_obj>
    <!-- Button row -->
    <modal_button_row secondary_text="Cancel" secondary_callback="estop_dialog_cancel_clicked" primary_text="STOP" primary_callback="estop_dialog_confirm_clicked" primary_variant="danger"/>
  </view>
</component>
