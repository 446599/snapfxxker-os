<!-- Spaghetti / print-issue detection response modal. -->
<!-- NOTE: Backdrop is created programmatically by the Modal class in C++. -->
<!-- Buttons are wired programmatically in SpaghettiDetectionModal::on_show() -->
<!-- via wire_ok_button / wire_cancel_button / wire_tertiary_button. -->
<component>
  <view name="spaghetti_detection_modal" extends="ui_dialog" width="94%" height="94%" style_max_height="94%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" style_pad_all="0" style_bg_color="#card_bg" style_bg_opa="255" style_radius="#border_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Header row with warning icon + title -->
    <modal_header icon_src="alert" icon_variant="warning" title="Print issue detected"/>
    <!-- Content area: optional camera frame preview + message -->
    <lv_obj width="100%" height="0" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_sm" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_md" flex_grow="1" scrollable="true" scrollbar_mode="active" style_pad_all="#space_md">
      <!-- Camera frame preview. Image source is fed from C++ on_show() when a
           frame is available; otherwise it stays empty. -->
      <lv_image name="detection_preview" align="center" inner_align="contain" style_max_width="100%" width="100%" height="40%" style_max_height="40%"/>
      <!-- Detection message text, published on spaghetti_message by on_show(). -->
      <text_body name="detection_text" width="100%" long_mode="wrap" style_text_align="left" bind_text="spaghetti_message"/>
    </lv_obj>
    <!-- Button row, left to right: Abort (btn_secondary, danger), Reduce Sensitivity
         (btn_tertiary, hidden via spaghetti_tune_available when the source cannot tune),
         Turn off detection (btn_quaternary), Resume (btn_primary). The names follow the
         Modal wire_*_button() roles, not the row's slots.
         Wired programmatically; no XML callbacks to avoid double-wiring. -->
    <modal_button_row hide_quaternary="false" quaternary_name="btn_secondary" quaternary_variant="danger" quaternary_text="停止打印" hide_tertiary="false" tertiary_name="btn_tertiary" tertiary_variant="primary" tertiary_text="降低灵敏度" tertiary_show_subject="spaghetti_tune_available" secondary_name="btn_quaternary" secondary_variant="primary" secondary_text="关闭检测" primary_text="继续打印"/>
  </view>
</component>
