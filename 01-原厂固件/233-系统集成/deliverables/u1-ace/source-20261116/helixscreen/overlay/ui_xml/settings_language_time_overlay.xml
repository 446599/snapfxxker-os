<!-- Language &amp; Time Settings Overlay: language, timezone, time format -->
<!-- Uses setting_* components for consistency with main settings panel -->
<component>
  <view name="settings_language_time_overlay" extends="overlay_panel" title="Language &amp; Time" bg_color="#screen_bg" title_transform="none" title_color="#text">
    <lv_obj name="overlay_content" width="100%" height="0" flex_grow="1" scrollable="true" flex_flow="column" scrollbar_mode="auto" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" scroll_dir="ver">
      <setting_group name="group_language_time" style_margin_left="0" style_margin_right="0" style_margin_bottom="0">
        <style name="styles.u1_card"/>
        <!-- Language Dropdown -->
        <setting_dropdown_row name="row_language" label="Language" icon="translate" description="Choose display language" callback="on_language_changed"/>
        <!-- Timezone Dropdown (options populated dynamically in C++) -->
        <setting_dropdown_row name="row_timezone" label="Timezone" icon="clock" description="Set local timezone for time display" options="" callback="on_timezone_changed"/>
        <!-- Time Format Dropdown -->
        <setting_dropdown_row name="row_time_format" label="Time Format" icon="clock" description="Choose 12-hour or 24-hour time display" options="12 Hour&#10;24 Hour" options_tag="12 Hour&#10;24 Hour" bind_selected="settings_time_format" callback="on_time_format_changed"/>
      </setting_group>
    </lv_obj>
  </view>
</component>
