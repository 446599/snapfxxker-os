<!-- Progress sits beside a single row of touch-height actions on landscape
     screens and above them on narrow screens. The fitter measures the same
     progress rows, card chrome and button height. -->
<component>
  <styles>
    <style name="strip_row" layout="flex" flex_flow="row" flex_cross_place="center"/>
    <style name="strip_stacked" layout="flex" flex_flow="column"/>
    <style name="buttons_row" width="54%"/>
    <style name="buttons_compact_row" width="60%"/>
    <style name="buttons_stacked" width="100%"/>
    <style name="progress_row" height="content" min_height="#u1_touch_target" flex_grow="1" flex_main_place="center"/>
    <style name="progress_stacked" width="100%" height="content"/>
  </styles>
  <view extends="ui_card" width="100%" height="content" style_pad_hor="#u1_card_pad" style_pad_ver="#u1_compact_gap" style_pad_gap="#u1_card_gap" style_radius="#u1_card_radius" scrollable="false">
    <bind_style_if_eq name="strip_row" subject="ps_strip_stacked" ref_value="0"/>
    <bind_style_if_eq name="strip_stacked" subject="ps_strip_stacked" ref_value="1"/>

    <!-- Progress: the phase line, its bar, the filament line and what is up
         next. -->
    <lv_obj name="ps_strip_progress" style_min_width="0" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
      <bind_style_if_eq name="progress_row" subject="ps_strip_stacked" ref_value="0"/>
      <bind_style_if_eq name="progress_stacked" subject="ps_strip_stacked" ref_value="1"/>
      <!-- Printing: percent, time left, clock time of the finish, time elapsed. -->
      <lv_obj name="ps_strip_print_line" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false">
        <bind_flag_if_eq subject="preparing_visible" flag="hidden" ref_value="1"/>
        <text_body name="print_percent" bind_text="print_progress_text" style_text_font="#font_progress"/>
        <icon name="remaining_icon" src="clock" size="xs" variant="secondary" clickable="false"/>
        <text_heading name="print_remaining" bind_text="print_remaining" style_text_color="#text"/>
        <text_small name="print_eta" bind_text="print_eta" style_text_color="#text_muted" flex_grow="1" long_mode="dots">
          <bind_flag_if cond="ui_breakpoint le 2" flag="hidden"/>
        </text_small>
        <icon name="elapsed_icon" src="hourglass" size="xs" variant="secondary" clickable="false">
          <bind_flag_if cond="ui_breakpoint le 2" flag="hidden"/>
        </icon>
        <text_small name="print_elapsed" bind_text="print_elapsed" style_text_color="#text_muted">
          <bind_flag_if cond="ui_breakpoint le 2" flag="hidden"/>
        </text_small>
      </lv_obj>
      <!-- Pre-print: what the start sequence has left. -->
      <lv_obj name="ps_strip_prepare_line" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false" hidden="true">
        <bind_flag_if_eq subject="preparing_visible" flag="hidden" ref_value="0"/>
        <text_body name="preparing_heading" text="Preparing" style_text_font="#font_body_bold"/>
        <text_small name="preparing_eta" bind_text="print_start_time_left" style_text_color="#text_muted" flex_grow="1" long_mode="dots"/>
      </lv_obj>
      <progress_bar name="print_progress" bind_value="print_progress_display">
        <bind_flag_if_eq subject="preparing_visible" flag="hidden" ref_value="1"/>
      </progress_bar>
      <!-- Its sweep runs at every value, 0 included, because the value is an
           estimate that can stall through a long phase. -->
      <progress_bar_estimate name="preparing_progress_bar" bind_value="preparing_progress">
        <bind_flag_if_eq subject="preparing_visible" flag="hidden" ref_value="0"/>
      </progress_bar_estimate>
      <!-- Filament: the runout glyph without an AMS, the active lane with one,
           and tool changes done of expected. -->
      <lv_obj name="filament_ams_status_row" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
        <!-- Stands down whenever ams_status_row shows, which carries the same
             glyph beside its lane; an AMS printer between lanes (no active
             tool) shows it here instead. -->
        <lv_obj name="filament_status_row" width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm">
          <bind_flag_if cond="filament_sensor_count eq 0 or (ams_slot_count gt 0 and ams_current_tool ge 0)" flag="hidden"/>
          <filament_sensor_indicator subject="filament_runout_scoped"/>
        </lv_obj>
        <lv_obj name="ams_status_row" height="content" flex_grow="1" style_min_width="0" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm">
          <bind_flag_if_eq subject="ams_slot_count" flag="hidden" ref_value="0"/>
          <ams_current_tool name="ams_current_tool_indicator" runout_subject="filament_runout_scoped"/>
        </lv_obj>
        <lv_obj name="toolchange_status" width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs">
          <bind_flag_if_eq subject="toolchange_visible" flag="hidden" ref_value="0"/>
          <icon src="swap_vertical" size="xs" variant="muted"/>
          <text_small name="toolchange_label" bind_text="toolchange_text" style_text_color="#text_muted"/>
        </lv_obj>
      <bind_flag_if cond="ui_breakpoint le 1" flag="hidden"/></lv_obj>
      <!-- Up next: the first queued job, up while the queue is not empty. Tap
           starts it when the printer is free, otherwise opens the job queue. -->
      <lv_obj name="up_next_row" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false" clickable="true" style_radius="#border_radius">
        <style name="styles.press_wash" selector="pressed"/>
        <bind_flag_if cond="job_queue_count eq 0 or ui_breakpoint le 1" flag="hidden"/>
        <!-- A micro landscape strip gives its height to the tiles; the queue
             stays reachable from the job queue. -->
        <event_cb trigger="clicked" callback="on_up_next_tap"/>
        <icon src="progress_clock" size="xs" variant="muted" clickable="false" event_bubble="true"/>
        <text_small name="up_next_label" flex_grow="1" bind_text="job_queue_up_next_text" style_text_color="#text_muted" long_mode="dots" clickable="false" event_bubble="true"/>
      </lv_obj>
    </lv_obj>

    <!-- Pause, Tune, More, Cancel / Reprint. -->
    <lv_obj name="ps_strip_buttons" height="#u1_touch_target" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_main_place="end" style_flex_cross_place="center" style_pad_gap="#u1_compact_gap" scrollable="false">
      <bind_style_if name="buttons_row" cond="ps_strip_stacked eq 0 and (ui_is_portrait or ui_breakpoint gt 1)"/>
      <bind_style_if name="buttons_compact_row" cond="ps_strip_stacked eq 0 and not ui_is_portrait and ui_breakpoint le 1"/>
      <bind_style_if_eq name="buttons_stacked" subject="ps_strip_stacked" ref_value="1"/>
      <ui_button name="btn_pause" width="0" height="100%" flex_grow="1" style_min_width="#u1_touch_target" style_radius="#u1_card_radius" style_pad_hor="0" style_pad_ver="0" bind_icon="print_control_primary_icon" icon_size="xs" text="Pause" bind_text="print_control_primary_label" icon_position="left" variant="primary">
        <event_cb trigger="clicked" callback="on_print_control_primary"/>
        <bind_state_if_eq subject="print_control_primary_enabled" state="disabled" ref_value="0"/>
      </ui_button>
      <ui_button name="btn_tune" width="0" height="100%" flex_grow="1" style_min_width="#u1_touch_target" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" style_pad_ver="0" text="Tune" icon_position="left" variant="outline">
        <event_cb trigger="clicked" callback="on_print_status_tune"/>
        <bind_state_if_eq subject="print_controls_enabled" state="disabled" ref_value="0"/>
      </ui_button>
      <!-- Filled grey: the actions behind it are secondary. Hidden when every
           entry of the menu is. -->
      <ui_button name="btn_more" width="0" height="100%" flex_grow="1" style_min_width="#u1_touch_target" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" style_pad_ver="0" variant="ghost" style_bg_color="#elevated_bg" style_bg_opa="255" text="More" icon_position="left">
        <bind_flag_if cond="print_status_camera_available or timelapse_owner eq 1 or led_controllable" flag="hidden" invert="true"/>
        <event_cb trigger="clicked" callback="on_print_status_more"/>
      </ui_button>
      <!-- Cancel while a print runs (outcome NONE), Reprint once it has an outcome. -->
      <ui_button name="btn_cancel" width="0" height="100%" flex_grow="1" style_min_width="#u1_touch_target" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" style_pad_ver="0" variant="danger" text="Cancel" icon_position="left">
        <bind_flag_if_not_eq subject="print_outcome" flag="hidden" ref_value="0"/>
        <bind_state_if_eq subject="print_control_stop_enabled" state="disabled" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_print_control_stop"/>
      </ui_button>
      <ui_button name="btn_reprint" width="0" height="100%" flex_grow="1" style_min_width="#u1_touch_target" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" style_pad_ver="0" text="Reprint" icon_position="left" hidden="true" variant="primary">
        <bind_flag_if_eq subject="print_outcome" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_print_status_reprint"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
