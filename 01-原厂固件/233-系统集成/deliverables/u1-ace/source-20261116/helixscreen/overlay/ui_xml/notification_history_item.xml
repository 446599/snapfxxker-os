<component>
  <consts><px name="notice_action_w" value="104"/></consts>
  <!-- One row of a history list. Severity: 0 info, 1 success, 2 warning, 3 error. -->
  <styles>
    <style name="item_info" bg_color="#info"/>
    <style name="item_success" bg_color="#success"/>
    <style name="item_warning" bg_color="#warning"/>
    <style name="item_error" bg_color="#danger"/>
  </styles>
  <api>
    <prop name="severity_subject" type="string" default=""/>
    <prop name="title_subject" type="string" default=""/>
    <prop name="message_subject" type="string" default=""/>
    <prop name="has_message_subject" type="string" default=""/>
    <prop name="timestamp_subject" type="string" default=""/>
    <prop name="has_action_subject" type="string" default=""/>
    <prop name="action_label_subject" type="string" default=""/>
    <prop name="click_callback" type="string" default=""/>
    <prop name="row_index" type="string" default=""/>
  </api>
  <view name="notification_item" width="100%" height="content" style_pad_left="16" style_pad_right="14"
        style_pad_top="12" style_pad_bottom="12" style_bg_opa="0" style_border_width="1"
        style_border_side="bottom" style_border_color="#border" style_radius="0" scrollable="false"
        clickable="true" gesture_bubble="false" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_pad_gap="12" style_min_height="52">
    <event_cb trigger="clicked" callback="$click_callback" user_data="$row_index"/>
    <lv_obj width="10" height="10" style_radius="5" style_border_width="0" style_bg_opa="255"
            style_pad_all="0" clickable="false" event_bubble="true">
      <bind_style_if_eq name="item_info" subject="$severity_subject" ref_value="0"/>
      <bind_style_if_eq name="item_success" subject="$severity_subject" ref_value="1"/>
      <bind_style_if_eq name="item_warning" subject="$severity_subject" ref_value="2"/>
      <bind_style_if_eq name="item_error" subject="$severity_subject" ref_value="3"/>
    </lv_obj>
    <lv_obj flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="4" clickable="false" event_bubble="true">
      <text_body name="item_title" bind_text="$title_subject" long_mode="dots" style_text_font="#font_body_bold" width="100%"/>
      <text_small name="item_message" width="100%" bind_text="$message_subject" long_mode="wrap" style_text_color="#text_muted">
        <bind_flag_if_eq subject="$has_message_subject" flag="hidden" ref_value="0"/>
      </text_small>
    </lv_obj>
    <lv_obj width="content" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs" style_flex_cross_place="end" scrollable="false">
      <text_small name="item_timestamp" bind_text="$timestamp_subject" style_text_color="#text_subtle"/>
      <ui_button name="item_action" bind_text="$action_label_subject" text="查看" variant="outline" width="#notice_action_w" height="#u1_touch_target" style_pad_hor="#space_sm" style_shadow_width="0" style_text_font="#u1_body_font">
        <bind_flag_if_eq subject="$has_action_subject" flag="hidden" ref_value="0"/>
        <event_cb trigger="clicked" callback="$click_callback" user_data="$row_index"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
