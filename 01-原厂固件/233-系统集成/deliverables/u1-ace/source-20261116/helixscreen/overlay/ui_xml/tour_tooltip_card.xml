<component>
  <!-- Width is set programmatically in TourOverlay::build_tree based on -->
  <!-- screen breakpoint (screen_w clamped to [220, 480]) — responsive.     -->
  <!-- ui_card provides bg_color, border, and #space_md padding via theme.  -->
  <!-- Heavier shadow than ui_card for floating-tooltip feel.               -->
  <view name="tour_tooltip_card" extends="ui_card" height="content" style_shadow_width="8" style_shadow_opa="24" flex_flow="column" style_pad_gap="#u1_card_gap" style_radius="#u1_card_radius" style_pad_all="#u1_page_pad" style_border_width="#u1_border" style_border_color="#border">
    <text_heading name="tour_title" width="100%" text="" translation_tag=""/>
    <text_body name="tour_body" width="100%" text="" translation_tag="" long_mode="wrap"/>
    <!-- A sample of the Print Status screen. Its height and the printer picture come
         from TourOverlay::update_preview. -->
    <lv_obj name="tour_preview" width="100%" hidden="true" flex_flow="column" scrollable="false" clickable="false" style_bg_color="#screen_bg" style_bg_opa="255" style_border_width="#border_width" style_border_color="#text_muted" style_border_opa="80" style_radius="#border_radius" style_pad_all="#space_xs" style_pad_gap="#space_xs">
      <lv_image name="tour_preview_printer" width="100%" height="100%" inner_align="contain"/></lv_obj>
    <lv_obj name="tour_footer" width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center">
      <text_small name="tour_counter" text=""/>
      <lv_obj name="tour_buttons" width="content" height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm">
        <!-- Buttons wired programmatically from TourOverlay::build_tree — the -->
        <!-- click handlers need the per-instance `this` pointer, which XML    -->
        <!-- event_cb registration doesn't support. -->
        <ui_button name="tour_skip_btn" variant="ghost" text="Skip" height="#u1_touch_target" style_min_width="88" style_radius="#u1_card_radius"/>
        <ui_button name="tour_next_btn" variant="primary" text="Next" height="#u1_touch_target" style_min_width="88" style_radius="#u1_card_radius"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
