<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <view name="filament_mapping_modal" extends="ui_dialog" width="94%" height="90%" style_max_width="640" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0">
    <modal_header icon_src="palette" icon_variant="info" title="Filament Mapping"/>
    <!-- The note and tool rows share one vertical scroll area. -->
    <lv_obj width="100%" height="0" flex_grow="1" style_pad_all="#u1_card_pad_roomy"
            flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true"
            scroll_dir="ver" scrollbar_mode="auto">
      <lv_obj name="start_macro_note_row" width="100%" height="content"
              style_bg_color="#warning" style_bg_opa="25" style_radius="#u1_card_radius"
              style_border_width="#u1_border" style_border_color="#warning"
              style_pad_all="#u1_card_pad" flex_flow="row" style_flex_cross_place="center"
              style_pad_gap="#u1_card_gap" scrollable="false">
        <bind_flag_if_eq subject="filament_mapping_note_visible" flag="hidden" ref_value="0"/>
        <icon src="alert" size="sm" variant="warning"/>
        <text_small name="start_macro_note" width="0" flex_grow="1" long_mode="wrap" bind_text="filament_mapping_note"/>
      </lv_obj>
      <lv_obj name="mapping_tool_list" width="100%" height="content" style_pad_all="0"
              flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="false">
        <!-- Rows populated dynamically in C++. -->
      </lv_obj>
    </lv_obj>
    <modal_button_row secondary_text="Cancel" secondary_callback="on_modal_cancel_clicked" primary_text="Done" primary_callback="on_modal_ok_clicked"/>
  </view>
</component>
