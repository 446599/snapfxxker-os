+++ b/tests/test_slow_progress.py
@@ -0,0 +1,86 @@
+import unittest
+
+from test_feed_handoff import feed, observer
+
+
+class SlowProgressTests(unittest.TestCase):
+    def setUp(self):
+        self.a, self.s = observer()
+        self.sent = []
+        self.reply = True
+        original = self.a.send_request_to
+
+        def send(idx, request, callback):
+            if request['method'] != 'update_feeding_speed':
+                return original(idx, request, callback)
+            self.assertIsNone(request.get('length'))
+            self.assertEqual(request['params'], {'index': 0, 'speed': 20})
+            self.assertFalse(self.s.allows_wire(1, request, self.s.transport))
+            self.assertTrue(self.s.allows_wire(idx, request, self.s.transport))
+            self.assertFalse(self.s.allows_wire(idx, request, self.s.transport))
+            self.sent.append(request)
+            request['id'] = 123
+            if self.reply:
+                callback(self.a, dict(id=123, code=0, _v2_command=10,
+                                      _v2_frame_valid=True, _v2_payload_valid=True))
+            return True
+
+        self.a.send_request_to = send
+
+    def observe(self, t, motor, material):
+        self.a.reactor.now = t
+        self.a.motor, self.a.decoder, self.a.steps = motor, material, motor * 10
+        return self.s.check()
+
+    def reproduce(self):
+        self.observe(0, 0, 0)
+        self.observe(.64, 51, 46)
+        self.observe(1.28, 104, 55)
+        self.observe(1.92, 156, 55)
+        self.assertFalse(self.observe(2.03, 156, 55))
+        self.assertEqual(len(self.sent), 1)
+        self.assertFalse(self.observe(2.4, 161, 55))
+
+    def test_latest_trace_then_head_triggers_during_slow_check(self):
+        self.reproduce()
+        self.a.head = True
+        self.assertTrue(self.observe(2.4, 162, 55))
+
+    def test_recovered_progress_keeps_slow_feed_until_the_head(self):
+        self.reproduce()
+        self.assertFalse(self.observe(3.55, 187, 81))
+        self.assertTrue(self.s.slow_recovered)
+        self.a.head = True
+        self.assertTrue(self.observe(6.5, 236, 122))
+        self.assertEqual(len(self.sent), 1)
+
+    def test_persistent_low_readings_stop_on_distance(self):
+        self.reproduce()
+        self.observe(3.5, 188, 58)
+        self.observe(4.78, 213, 59)
+        with self.assertRaisesRegex(feed.FeedSupervisionError, '低速复核后'):
+            self.observe(4.88, 213, 59)
+        self.assertEqual(len(self.sent), 1)
+
+    def test_zero_motion_stops_on_time(self):
+        self.reproduce()
+        for t in (2.5, 3.2, 4.1, 4.8):
+            self.observe(t, 161, 55)
+        with self.assertRaisesRegex(feed.FeedSupervisionError, '低速复核后'):
+            self.observe(5.1, 161, 55)
+
+    def test_lost_speed_reply_stops_without_resending(self):
+        self.reply = False
+        self.reproduce()
+        with self.assertRaisesRegex(feed.FeedSupervisionError, '降速'):
+            self.observe(2.6, 180, 55)
+        self.assertEqual(len(self.sent), 1)
+
+    def test_new_slip_after_recovery_has_no_second_budget(self):
+        self.reproduce()
+        self.observe(3.6, 187, 82)
+        self.observe(4.6, 218, 85)
+        self.observe(5.6, 249, 86)
+        with self.assertRaisesRegex(feed.FeedSupervisionError, '低速复核后'):
+            self.observe(5.7, 249, 86)
+        self.assertEqual(len(self.sent), 1)
