@@ -0,0 +1,177 @@
+"""Exercise the reported ACE 1 / slot 4 handoff with the real CMD6/STOP code."""
+import ast
+import logging
+from pathlib import Path
+from types import SimpleNamespace
+from importlib import import_module
+import unittest
+
+from test_print_assist_recovery import Reactor, response, ready, PACKAGE
+
+standstill = import_module(PACKAGE + '.ace_v2_standstill')
+EXTRAS = Path(__file__).resolve().parents[1] / 'runtime/klipper/extras'
+
+
+def actual(file, method):
+    root = ast.parse((EXTRAS / file).read_text())
+    node = next(n for n in ast.walk(root) if isinstance(n, ast.FunctionDef)
+                and n.name == method)
+    env = dict(logging=logging, stop_and_verify=standstill.stop_and_verify,
+               STOP_DEFAULT_ZERO_MM=standstill.STOP_DEFAULT_ZERO_MM,
+               unload_source_matches=getattr(ready, 'unload_source_matches', None))
+    exec(compile(ast.Module(body=[node], type_ignores=[]), file, 'exec'), env)
+    return env[method]
+
+
+wait_before = actual('filament_feed_ace.py', '_wait_before_unload_retract')
+retract = actual('ace.py', '_retract')
+
+
+class Fixture:
+    def __init__(self, decoder=True):
+        self.reactor = Reactor()
+        self.uid = (1, 2, 3)
+        self.transport = object()
+        self.states = {3: 'assist_error'}
+        self.decoder = decoder
+        self.clear_on_move = True
+        self.cmds = []
+        self.gate = True
+        self.mask_flip = False
+        self.ace = SimpleNamespace(
+            reactor=self.reactor, host='u1', _ace_mode='multi',
+            _serials={0: self.transport}, _connected_per_ace={0: True},
+            _reconnecting_per_ace={}, _gate_status_per_ace={0: [1]*4},
+            _location_identity=lambda idx: ('port', self.uid),
+            _latch_stop_fault=lambda *a, **k: self.cmds.append(('latched', a[1])),
+            _raise_ace_gone=lambda idx, msg: self.fail(msg),
+            _is_v2_idx=lambda idx: True, head_uses_ace=lambda h: True,
+            _active_device_index=0, _protocols={0: SimpleNamespace(NAME='v2')},
+            _head_source={3: dict(ace_index=0, slot=3, load_failed=False,
+                                  connection_identity=dict(port='port', uid=list(self.uid)))},
+            _feed_assist_per_ace={0: -1}, head_is_manual=lambda head: False,
+            _clear_fa_cache_for=lambda idx, slot: None, send_request_to=self.send,
+            wait_ace_ready_on=lambda idx, slot=None, **kw: ready.wait_ready(
+                self.ace, idx, timeout=2, slot=slot, **kw),
+            _require_no_stop_fault=lambda **kw: None,
+            _travel_legacy_start=lambda *args: None, _travel_legacy_finish=lambda *args: None,
+            _fa_trace=lambda *args: None, dwell=lambda delay: None)
+
+    @staticmethod
+    def fail(msg):
+        raise ready.ReadyWaitError(msg)
+
+    def send(self, idx, request, callback):
+        req = request
+        req['id'] = len(self.cmds) + 1
+        method = req['method']
+        self.cmds.append((method, req['params'].get('index')))
+        if method == 'get_status':
+            data = response(req, self.states)
+            if 'feeding' in self.states.values():
+                data['result']['status'] = 'busy'
+        elif method == 'get_feed_info':
+            data = response(req, {}, command=76)
+            data['result'] = dict(_feed_wire_valid=True, feed_info=[
+                dict(index=3, steps=100, length=8,
+                     decoder=8 if self.decoder else 0,
+                     _decoder_present=self.decoder, _wire_valid=True)])
+        elif method == 'get_key_state':
+            data = response(req, {}, command=73)
+            self.mask_flip = not self.mask_flip
+            data['result'] = dict(_key_wire_valid=True, buffer_keys=dict(
+                raw_mask=((1 << 12) if self.gate else 0) |
+                         (((1 << 14) | (1 << 16)) if self.mask_flip else 0)))
+        elif method == 'unwind_filament':
+            if self.clear_on_move:
+                self.states[3] = 'ready'
+            data = response(req, {}, command=4)
+        else:
+            data = response(req, {}, command=9)
+        callback(self.ace, data)
+        return True
+
+
+class UnloadAssistHandoffTest(unittest.TestCase):
+    def test_reported_131_can_handoff_to_original_slot_rollback(self):
+        f = Fixture()
+        stop = wait_before(f, 0, 3, head=3)
+        retract(f.ace, 3, 150, 50, head=3, unload_stop=stop)
+        f.ace.wait_ace_ready_on(0, slot=3)
+        self.assertEqual([c for c in f.cmds if c[0] == 'unwind_filament'],
+                         [('unwind_filament', 3)])
+
+    def test_buffer_bits_do_not_affect_inlet_fallback(self):
+        f = Fixture(decoder=False)
+        stop = wait_before(f, 0, 3, head=3)
+        self.assertEqual(stop['slot_status'], 'assist_error')
+        self.assertIn(('get_key_state', None), f.cmds)
+        self.assertNotIn(('get_feed_info', None), f.cmds)
+        self.assertNotIn(('latched', 3), f.cmds)
+
+    def test_load_or_completion_still_reports_131(self):
+        f = Fixture()
+        f.clear_on_move = False
+        stop = wait_before(f, 0, 3, head=3)
+        retract(f.ace, 3, 150, 50, head=3, unload_stop=stop)
+        with self.assertRaisesRegex(ready.ReadyWaitError, '槽 4=assist_error'):
+            f.ace.wait_ace_ready_on(0, slot=3)
+
+    def test_handoff_still_requires_acknowledged_stop(self):
+        f = Fixture()
+        wire = f.ace.send_request_to
+        def send(idx, request, callback):
+            if request['method'] == 'stop_feed_filament':
+                request['id'] = 55
+                callback(f.ace, {'id':55, 'code':1, 'msg':'error_1'})
+                return True
+            return wire(idx, request, callback)
+        f.ace.send_request_to = send
+        with self.assertRaises(standstill.StopUnconfirmedError):
+            wait_before(f, 0, 3, head=3)
+        self.assertIn(('latched',3), f.cmds)
+        self.assertFalse(any(c[0] == 'unwind_filament' for c in f.cmds))
+
+    def test_other_errors_on_same_slot_remain_faults(self):
+        for state in ('motor_error', 'tangled_error', 'stuck_error', 'rollback_error'):
+            with self.subTest(state=state):
+                f = Fixture()
+                f.states[3] = state
+                with self.assertRaisesRegex(ready.ReadyWaitError, state):
+                    wait_before(f, 0, 3, head=3)
+
+    def test_unload_receipt_does_not_apply_to_new_transport_or_source(self):
+        for change in ('connection', 'source', 'slot'):
+            with self.subTest(change=change):
+                f = Fixture()
+                stop = wait_before(f, 0, 3, head=3)
+                if change == 'connection':
+                    f.ace._serials[0] = object()
+                elif change == 'source':
+                    f.ace._head_source[3]['slot'] = 2
+                with self.assertRaisesRegex(ready.ReadyWaitError, '退料原槽或连接已改变'):
+                    f.ace.wait_ace_ready_on(0, slot=2 if change == 'slot' else 3,
+                                            unload_stop=stop)
+
+    def test_still_feeding_is_not_ready(self):
+        f = Fixture()
+        stop = wait_before(f, 0, 3, head=3)
+        f.states[3] = 'feeding'
+        with self.assertRaisesRegex(ready.ReadyWaitError, '等待 ready 达到总时限'):
+            f.ace.wait_ace_ready_on(0, slot=3, unload_stop=stop)
+
+    def test_unproven_source_is_not_exempted(self):
+        f = Fixture()
+        f.ace._head_source[3]['connection_identity']['uid'] = [4, 5, 6]
+        with self.assertRaisesRegex(ready.ReadyWaitError, '槽 4=assist_error'):
+            wait_before(f, 0, 3, head=3)
+
+    def test_no_decoder_no_inlet_still_requires_recovery(self):
+        f = Fixture(decoder=False)
+        f.gate = False
+        with self.assertRaisesRegex(standstill.StopUnconfirmedError, '原槽入口无料'):
+            wait_before(f, 0, 3, head=3)
+
+
+if __name__ == '__main__':
+    unittest.main()
