+        self.sd = SimpleNamespace(current_file=object(), file_position=695324,
+                                  is_cmd_from_sd=lambda: True)
+        self.pause = SimpleNamespace(is_paused=True)
+        self.variables = dict(last_extruder_index=2, extruder1_temp=215.)
+        self.saved = dict(base_position=[1., -3., .4, 52.],
+                          last_position=[*self.chute, 193.])
+        self.move = SimpleNamespace(get_status=lambda: {'gcode_position': self.start},
+                                    speed=40., absolute_coord=True,
+                                    absolute_extrude=False, last_position=[0., 0., 0., 0.],
+                                    base_position=[0., 0., 0., 0.],
+                                    saved_states={'PAUSE_STATE': self.saved})
+        self.origin_tool = 'extruder2'
+        self.a = a = MagicMock()
+        self.objects = {
+            'virtual_sdcard': self.sd, 'gcode_move': self.move, 'pause_resume': self.pause,
+            'gcode_macro INNER_RESUME': SimpleNamespace(get_status=lambda t: self.variables),
+        }
+        a.printer.lookup_object.side_effect = self.objects.get
+        a.swap_anti_ooze_retract = 0.
+        a._ace_mode = 'multi'
+        a._ghost_heads = a._fa_load_disable = a._bg_left_empty = set()
+        a._gate_status_per_ace = a._feed_assist_per_ace = {}
+        a._head_source = {2: {'ace_index': 1, 'slot': 2}}
+        a._active_device_index = 1
