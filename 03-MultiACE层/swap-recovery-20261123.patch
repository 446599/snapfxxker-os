+        a.toolhead.get_extruder.return_value.get_name.side_effect = lambda: self.origin_tool
+        a._file_swap_origin.side_effect = lambda move, name: methods._file_swap_origin(a, move, name)
+        self.commands = []
+        self.fail_unload = True
+        def dispatch(command):
+            self.commands.append(command)
+            if command in ('G90', 'G91'):
+                self.move.absolute_coord = command == 'G90'
+            if command in ('M82', 'M83'):
+                self.move.absolute_extrude = command == 'M82'
+            if self.fail_unload and command.startswith('ACE_UNLOAD_HEAD'):
+                raise RuntimeError('短退范围内喷头仍有料')
