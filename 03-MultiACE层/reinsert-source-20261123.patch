+def same_slot_reinsert(ace, source, idx, slot):
+    """A later inlet observation on the same live ACE can reuse its tube."""
+    if source_route(source) != (idx, slot) or 'insert_epoch' not in source:
+        return False
+    session = getattr(ace, '_insert_session', None)
+    if not session or source.get('insert_session') != session:
+        return False
+    saved = source['insert_epoch']
+    if saved is None:
+        saved = 0  # No inlet changes observed when the route was first recorded.
+    current = ace._insert_epochs.get((idx, slot))
+    floor = ace._last_disconnect_epoch.get((idx, slot), 0)
+    return (type(saved) is int and type(current) is int and floor <= saved < current
+            and isinstance(source.get('connection_identity'), dict)
+            and source['connection_identity'] == ace._rfid_identity_status(idx))
 
 
