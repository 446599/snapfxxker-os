+def stopped_assist_eject_allowed(ace, idx, slot, heads, proof):
+    """Permit a sensor-ended reverse of the same source after verified STOP."""
+    if (proof.get('status') != 'assist_error' or proof.get('gate') is not True
+            or proof.get('assist_keys') != 1 << (slot * 4)
+            or proof.get('samples') != 3 or len(heads) != 1):
+        return False
+    head = heads[0]
+    source = ace._head_source.get(head) or {}
+    return (raw_head_state(ace, head) is False
+            and (source.get('ace_index'), source.get('slot')) == (idx, slot)
+            and source.get('load_failed') is False
+            and source_conflict(ace, head, idx, slot) is None)
 
 
