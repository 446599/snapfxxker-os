+_screen_lanes: dict = {}
+_screen_lanes_until = 0.0
+_screen_lanes_lock = asyncio.Lock()
+
+
+async def _dashboard_state(status: dict) -> dict:
+    """Read the touchscreen's saved lane colors for dashboard display."""
+    global _screen_lanes, _screen_lanes_until
+    if not _homing_active() and time.monotonic() >= _screen_lanes_until:
+        async with _screen_lanes_lock:
+            if not _homing_active() and time.monotonic() >= _screen_lanes_until:
+                try:
+                    data = await asyncio.wait_for(
+                        _mr_get("/server/database/item?namespace=lane_data"), timeout=0.75
+                    )
+                    lanes = data.get("result", {}).get("value")
+                    _screen_lanes = lanes if isinstance(lanes, dict) else {}
+                except (httpx.HTTPError, TimeoutError, ValueError):
+                    _screen_lanes = {}
+                _screen_lanes_until = time.monotonic() + 2.0
+    return _parse_state(status, screen_lanes=_screen_lanes)
+
