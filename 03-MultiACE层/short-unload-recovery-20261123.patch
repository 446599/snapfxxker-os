+    def test_lost_ack_or_fault_does_not_trigger_hot_retry(self):
+        for fault in ('ack', 'motor', 'disconnect'):
+            h, a, scripts = self.setup_route(900)
+            if fault == 'ack':
+                a.reject_move = 1
+            elif fault == 'motor':
+                a._lane_states = lambda idx, monitor=None: {0:'motor_error'}
+            else:
+                advance = a.advance
+                def disconnect(reactor, target):
+                    advance(reactor, target)
+                    if a.active_move and reactor.now > .2:
+                        a._connected_per_ace[0] = False
+                a.advance = disconnect
+            with self.subTest(fault=fault), self.assertRaises(RuntimeError):
+                self.run_loop(LOOPS[0], h)
+            self.assertEqual(self.lengths(a), [150])
+            self.assertFalse(scripts)
