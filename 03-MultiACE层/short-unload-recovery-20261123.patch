--- /dev/null
+++ b/tests/test_swap_short_retry.py
@@ -0,0 +1,140 @@
+"""Exercise both real _do_feed retry loops with simulated ACE and head switches."""
+import ast
+import logging
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+import test_endpoint_unload
+import test_feed_handoff
+from test_fixed_park import park
+
+
+SOURCE = Path(__file__).resolve().parents[1] / 'runtime/klipper/extras/filament_feed_ace.py'
+TREE = ast.parse(SOURCE.read_text())
+LOOPS = sorted((n for n in ast.walk(TREE) if isinstance(n, ast.For)
+                and isinstance(n.target, ast.Name) and n.target.id == 'unload_attempt'),
+               key=lambda n: n.lineno)
+
+
+class SwapShortRetryTests(unittest.TestCase):
+    def setup_route(self, position):
+        fixture = test_endpoint_unload.EndpointUnloadTests()
+        old, a, saved = fixture.foreground_fixture()
+        h = test_feed_handoff.IntegrationTests.harness({'_try_unload_park'})
+        h._try_unload_park.__func__.__globals__['SwapShortStillLoaded'] = park.SwapShortStillLoaded
+        old._try_unload_park = h._try_unload_park
+        h._finish_fixed_unload = old._finish_fixed_unload
+        h.filament_ch = [0]
+        old._wait_before_unload_retract = lambda idx, slot, head: dict(
+            slot_status='assist_error', sample=None, transport=a._serials[idx],
+            identity=a._location_identity(idx), ace=idx, slot=slot, head=head)
+        a._active_device_index = 0
+        a.position = position
+        old.reactor, old.runout_sensor = a.reactor, [a]
+        scripts = []
+        old.gcode = SimpleNamespace(run_script_from_command=scripts.append)
+        old.toolhead = SimpleNamespace(wait_moves=lambda: None, get_extruder=lambda:
+                                       SimpleNamespace(nozzle_diameter=.4, get_name=lambda: 'extruder'))
+        return old, a, scripts
+
+    def run_loop(self, loop, h, retries=3):
+        scope = dict(self=h, logging=logging, ch=0, _hot_park_context=None, head_idx=0,
+                     _ace_slot=0, _short_retract=150, _retract_speed=80, _short_total=0,
+                     retry_motion=None, fixed_parked=False, unload_ok=False, unload_max=retries,
+                     filament_feed_temp_db=215, filament_unload_temp=205, filament_soft=0,
+                     precool_temp=0, probe_push=5, probe_pull=7, probe_temp=175,
+                     FEED_UNLOAD_TRIGGER_SETTLE=.5)
+        exec(compile(ast.Module(body=[loop], type_ignores=[]), str(SOURCE), 'exec'), scope)
