+"""Continuous screen EXIT: single motion, bounded head edge and fail-closed cleanup."""
+from importlib import import_module
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock, patch
+
+from test_print_assist_recovery import PACKAGE, Reactor
+
+actions = import_module(PACKAGE + '.ace_slot_actions')
+
+
+class ContinuousExit(unittest.TestCase):
+    def setUp(self):
+        self.clock = Reactor()
+        self.transport = object()
+        self.identity = ('port', (1, 2, 3))
+        self.source = {1: {'ace_index': 0, 'slot': 1, 'load_failed': False}}
+        self.pin = True
+        self.lane = 'rollback'
+        self.gate = True
+        self.start = None
+        self.moves = 0
+        self.stops = 0
+        self.commit = 0
+        self.behavior = 'normal'
+        self.owner = object()
+        self.ace = SimpleNamespace(
+            reactor=self.clock, _serials={0: self.transport},
+            _location_identity=lambda idx: self.identity,
+            _head_source=self.source, _insert_epochs={(0, 1): 7},
+            _rfid_route_heads=lambda idx, slot: [1], _ace_mode='multi',
+            _require_no_stop_fault=lambda **kw: None,
+            _error_recovery=SimpleNamespace(begin=lambda *args: self.owner, end=Mock()),
+            _latch_stop_fault=Mock())
+        self.action = a = actions.SlotActions.__new__(actions.SlotActions)
+        a.ace = self.ace
+        a.state = dict(state='preparing', kind='eject', seq=2, ace=0, slot=1)
+        a.cancel = False
+        a._prepare_command = object()
+        a._continuous_exit = (2, 0, 1, 1, self.transport, self.identity)
+        a._continuous_attempted = False
+        a._check = self.check
+        a._bind_legacy_route = self.bind
+        a._arm_route_hold = Mock()
+        a._eject_stop_ready = self.stop
+        a._send_eject_motion = self.move
+        a._lane_states = self.states
+        a._gate = self.inlet
+        a._commit_ejected = self.finish
+        self.sensor = patch.object(actions, 'raw_head_state', side_effect=lambda ace, head: self.pin)
+        self.sensor.start()
+        self.addCleanup(self.sensor.stop)
+        self.handoff = patch.object(actions, 'stop_and_verify', side_effect=self.preflight)
+        self.stop_handoff = self.handoff.start()
+        self.addCleanup(self.handoff.stop)
+        self.clock.on_pause = self.tick
+
+    def preflight(self, ace, idx, slot, **kw):
+        self.assertTrue(kw['stock_unload'])
+        self.assertTrue(kw['assist_handoff'])
+        kw['monitor']()
+        self.stops += 1
+        return {'slot_status': 'assist_error'}
+
+    def check(self, idx, slot, transport=None, **kwargs):
+        if transport is not None and self.ace._serials.get(idx) is not transport:
+            raise RuntimeError('reconnected')
+
+    def bind(self, idx, slot, transport, **kw):
+        a = self.action
+        a._eject_identity = self.identity
+        a._eject_epoch = 7
+        a._eject_heads = (1,)
+        a._eject_peers = {}
+        a._eject_mode = 'multi'
+        a._eject_sources = {1: dict(self.source[1])}
+        a._eject_lease = (idx, slot, transport)
+
+    def stop(self, idx, slot, transport, *args, **kwargs):
+        self.stops += 1
+        if self.behavior == 'stop_error' and self.stops > 1:
+            raise RuntimeError('STOP lost')
+        self.action._last_eject_stop = dict(status='assist_error' if self.stops == 1 else 'ready',
+            gate=self.stops == 1, assist_keys=1 << 4, samples=3)
+        return self.stops == 1
+
+    def move(self, idx, slot, length, speed, monitor):
+        monitor()
+        self.moves += 1
+        self.action._motor_pending = True
+        self.start = self.clock.monotonic()
+        if self.behavior == 'ack_lost':
+            raise RuntimeError('ACK lost')
+        # Model delayed ACK: monitor keeps running while the command is in flight.
+        for _ in range(10):
+            self.clock.pause(self.clock.monotonic() + .02)
+            monitor()
+
+    def tick(self):
+        if self.start is None:
+            return
+        elapsed = self.clock.monotonic() - self.start
+        if self.behavior != 'missed' and elapsed >= .10:
+            self.pin = False
+        if self.behavior == 'bounce' and elapsed >= .12:
+            self.pin = True
+        if self.behavior == 'cancel' and elapsed >= .12:
+            self.action.cancel = True
+        if self.behavior == 'reconnect' and elapsed >= .12:
+            self.ace._serials[0] = object()
+        if self.behavior == 'epoch' and elapsed >= .12:
+            self.ace._insert_epochs[(0, 1)] = 8
+        if elapsed >= .35:
+            self.gate = False
+            if self.behavior == 'natural_removal':
+                self.ace._insert_epochs[(0, 1)] = 8
+        if self.behavior == 'fault' and elapsed >= .2:
+            self.lane = 'motor_error'
+
+    def states(self, idx, monitor):
+        monitor()
+        return {1: self.lane}
+
+    def inlet(self, idx, slot, monitor):
+        monitor()
+        return self.gate
+
+    def finish(self, idx, slot, transport):
+        self.assertFalse(self.pin)
+        self.assertFalse(self.gate)
+        self.assertEqual(self.stops, 2)
+        self.commit += 1
+
+    def run_exit(self):
+        return self.action.try_continuous_exit(0, 1, 1, 150)
+
+    def test_single_motion_to_confirmed_stop(self):
+        self.assertTrue(self.run_exit())
+        self.assertEqual((self.moves, self.stops, self.commit), (1, 2, 1))
+        self.assertTrue(self.action.state['ejected'])
+        self.ace._error_recovery.end.assert_called_once_with(self.owner)
+
+    def test_natural_removal_epoch_is_accepted_at_empty_gate(self):
+        self.behavior = 'natural_removal'
+        self.assertTrue(self.run_exit())
+        self.assertEqual(self.moves, 1)
+
+    def test_unowned_returns_false_without_any_motion(self):
+        for changes in ((3, 0, 1, 1, self.transport, self.identity),
+                        (2, 0, 2, 1, self.transport, self.identity)):
+            self.action._continuous_exit = changes
+            self.assertFalse(self.run_exit())
+        self.assertEqual((self.moves, self.stops), (0, 0))
+
+    def test_missed_edge_bounce_cancel_reconnect_and_epoch_fail_closed(self):
+        for scenario in ('missed', 'bounce', 'cancel', 'reconnect', 'epoch', 'fault', 'ack_lost'):
+            with self.subTest(scenario=scenario):
+                self.setUp()
+                self.behavior = scenario
+                with self.assertRaises(RuntimeError):
+                    self.run_exit()
+                self.assertEqual(self.moves, 1)
+                self.assertEqual(self.commit, 0)
+                self.assertEqual(self.stops, 2)
+                if scenario == 'missed':
+                    self.assertLess(self.clock.monotonic() - self.start, 150 / 80)
+                self.doCleanups()
+
+    def test_stop_failure_latches_and_no_commit(self):
+        self.behavior = 'stop_error'
+        with self.assertRaises(RuntimeError):
+            self.run_exit()
+        self.assertEqual(self.moves, 1)
+        self.assertEqual(self.commit, 0)
+        self.ace._latch_stop_fault.assert_called_once()
+
+    def test_real_fault_never_starts_motion(self):
+        def forbidden(**kw):
+            raise RuntimeError('real fault')
+        self.ace._require_no_stop_fault = forbidden
+        with self.assertRaisesRegex(RuntimeError, 'real fault'):
+            self.run_exit()
+        self.assertEqual(self.moves, 0)
+        self.assertEqual(self.commit, 0)
+
+    def test_loaded_head_authorization_is_only_for_handoff(self):
+        a = self.action
+        self.bind(0, 1, self.transport)
+        a.state['state'] = 'running'
+        a._eject_pending = token = object()
+        a._eject_params = params = {'index': 1, 'length': actions.MAX_MM, 'speed': actions.SPEED_MM_S}
+        a._eject_command_deadline = self.clock.monotonic() + 2
+        self.ace._connected_per_ace = {0: True}
+        self.ace._serial_failed_per_ace = {}
+        self.ace._stop_message = lambda *args: None
+        self.ace.printer = SimpleNamespace(lookup_object=lambda *args: SimpleNamespace(state='standby'))
+        request = {'method': 'unwind_filament', 'params': params, '_eject_token': token}
+        a._continuous_head = None
+        self.assertFalse(a.eject_allows(0, request, self.transport))
+        a._continuous_head = 1
+        self.assertTrue(a.eject_allows(0, request, self.transport))
+        self.ace._head_source[1]['slot'] = 2
+        self.assertFalse(a.eject_allows(0, request, self.transport))
+
+    def test_exit_wrapper_does_not_dispatch_second_eject(self):
+        a = self.action
+        a.state = {'state': 'idle'}
+        a.seq = 0
+        self.ace.head_uses_ace = lambda head: True
+        self.ace._stop_message = lambda *args: None
+        self.ace.gcode = SimpleNamespace(create_gcode_command=lambda *args: object())
+        a._require_exit_source = Mock()
+        a._start = Mock(side_effect=AssertionError('second motion'))
+        def unload(command):
+            self.assertIs(command, a._prepare_command)
+            self.assertEqual(a._continuous_exit[:4], (1, 0, 1, 1))
+            a.state.update(state='complete', ejected=True)
+        self.ace.cmd_ACE_UNLOAD_HEAD = unload
+        gcmd = SimpleNamespace(get_int=lambda name, **kw: {'ACE': 0, 'SLOT': 1}[name],
+                               error=lambda msg: RuntimeError(msg))
+        with patch.object(actions, 'empty_head_held_eject_allowed', return_value=False), \
+             patch.object(actions, 'held_loaded_source_matches', return_value=False):
+            a.exit_slot(gcmd)
+        a._start.assert_not_called()
+        self.assertIsNone(a._continuous_exit)
+
+    def test_real_fault_in_handoff_never_runs_motion(self):
+        self.stop_handoff.side_effect = lambda *args, **kw: {'slot_status': 'motor_error'}
+        with self.assertRaisesRegex(RuntimeError, 'assist'):
+            self.run_exit()
+        self.assertEqual((self.moves, self.commit), (0, 0))
+
+    def test_already_clear_returns_false_without_ownership_or_motion(self):
+        self.pin = False
+        self.assertFalse(self.run_exit())
+        self.assertEqual((self.moves, self.stops), (0, 0))
+        self.assertEqual(self.action.state['state'], 'preparing')
+        self.assertFalse(self.action._continuous_attempted)
+        self.ace._error_recovery.end.assert_not_called()
+
+    def test_clear_during_stop_returns_false_before_motion(self):
+        def clear_during_stop(ace, idx, slot, **kw):
+            kw['monitor']()
+            self.pin = False
+            kw['monitor']()
+            self.stops += 1
+            return {'slot_status': 'assist_error'}
+        self.stop_handoff.side_effect = clear_during_stop
+        self.assertFalse(self.run_exit())
+        self.assertEqual((self.moves, self.commit), (0, 0))
+        self.assertEqual(self.action.state['state'], 'preparing')
+        self.assertFalse(self.action._continuous_attempted)
+        self.action._arm_route_hold.assert_not_called()
+
+    def test_stock_assist_handoff_uses_real_wire_proof_without_decoder(self):
+        from test_unload_assist_handoff import Fixture
+        from importlib import import_module
+        stock = import_module(PACKAGE + '.ace_v2_standstill')
+        f = Fixture(decoder=False)
+        f.states = {1: 'assist_error'}
+        original_send = f.send
+        def send(idx, request, callback):
+            if request['method'] != 'get_key_state':
+                return original_send(idx, request, callback)
+            def translate(ace, response):
+                keys = response['result']['buffer_keys']
+                # The inlet remains set while unrelated buffer bits vary.
+                keys['raw_mask'] = (1 << 4) | (keys['raw_mask'] & ~((1 << 12)))
+                callback(ace, response)
+            return original_send(idx, request, translate)
+        f.ace.send_request_to = send
+        def real_preflight(ace, idx, slot, **kw):
+            self.stops += 1
+            kw['transport'] = f.transport
+            kw['identity'] = f.ace._location_identity(idx)
+            return stock.stop_and_verify(f.ace, idx, slot, **kw)
+        self.stop_handoff.side_effect = real_preflight
+        self.assertTrue(self.run_exit())
+        self.assertNotIn('get_feed_info', [command for command, _ in f.cmds])
+        self.assertGreaterEqual([command for command, _ in f.cmds].count('stop_feed_filament'), 2)
+
+    def setup_real_commit(self):
+        a, ace = self.action, self.ace
+        self.bind(0, 1, self.transport)
+        self.pin = False
+        a.state['state'] = 'running'
+        a._check = actions.SlotActions._check.__get__(a)
+        a._commit_ejected = actions.SlotActions._commit_ejected.__get__(a)
+        ace._connected_per_ace = {0: True}
+        ace._fw_update_hold = set()
+        ace._swap_in_progress = ace._unload_all_active = False
+        ace._calibration = {'state': 'idle'}
+        ace._is_v2_idx = lambda idx: True
+        ace.printer = SimpleNamespace(lookup_object=lambda name, *args:
+                                      SimpleNamespace(state='standby') if name == 'print_stats' else None)
+        ace._save_head_source = Mock()
+        ace._location_hold = SimpleNamespace(route_token=lambda *args: 'held-token', release_route=Mock())
+        a._route_token = 'held-token'
+        a._last_eject_stop = dict(transport=self.transport, identity=self.identity,
+            slot=1, gate=False, samples=3, status='ready', at=self.clock.monotonic(),
+            acknowledged_at=self.clock.monotonic() - .1)
+
+    def test_real_monitor_and_commit_allow_retained_matching_source(self):
+        self.setup_real_commit()
+        self.action._original_monitor(0, 1, self.transport, self.clock.monotonic() + 1,
+                                      allow_removal=True)
+        self.assertIsNotNone(self.ace._head_source[1])
+        self.action._commit_ejected(0, 1, self.transport)
+        self.assertIsNone(self.ace._head_source[1])
+        self.ace._location_hold.release_route.assert_called_once()
+
+    def test_real_commit_rejects_stale_receipt_and_changed_source(self):
+        self.setup_real_commit()
+        self.action._last_eject_stop['at'] -= 3
+        with self.assertRaisesRegex(RuntimeError, 'STOP'):
+            self.action._commit_ejected(0, 1, self.transport)
+        self.assertIsNotNone(self.ace._head_source[1])
+        self.action._last_eject_stop['at'] = self.clock.monotonic()
+        self.ace._head_source[1] = dict(ace_index=0, slot=2)
+        with self.assertRaises(RuntimeError):
+            self.action._original_monitor(0, 1, self.transport, self.clock.monotonic() + 1)
+        with self.assertRaises(RuntimeError):
+            self.action._commit_ejected(0, 1, self.transport)
+        self.ace._location_hold.release_route.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
