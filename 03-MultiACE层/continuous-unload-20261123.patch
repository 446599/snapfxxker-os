@@ -0,0 +1,67 @@
+"""A single finite command crosses the head switch and parks the strand."""
+import unittest
+from test_fixed_park import ParkWire, park
+
+
+class ContinuousParkTest(unittest.TestCase):
+    def run_park(self, a, *, length=1480, budget=150, before='ready'):
+        p = park.ParkMotion(a, 0, 0, 0)
+        receipt = dict(slot_status=before, sample=None, transport=p.transport,
+                       identity=p.identity, ace=0, slot=0, head=0)
+        return p.run(length, 0, 80, head_clear_mm=budget, handoff=receipt)
+
+    def test_head_clears_without_second_command(self):
+        a=ParkWire(45)
+        self.run_park(a,before='assist_error')
+        self.assertEqual([c['params']['length'] for c in a.motion_commands],[1480])
+        self.assertNotIn('get_feed_info',[op for op,_,_ in a.calls])
+        self.assertIsNone(a.active_move)
+        self.assertFalse(a.runout_buttun_state)
+        self.assertTrue(a._gate(0,0))
+
+    def test_stuck_head_stops_early_without_replay(self):
+        a=ParkWire(900)
+        with self.assertRaisesRegex(RuntimeError, '短退范围内'):
+            self.run_park(a)
+        self.assertEqual(len(a.motion_commands),1)
+        self.assertLess(900-a.position,155)
+        self.assertIsNone(a.active_move)
+
+    def test_retrigger_after_head_cleared(self):
+        a=ParkWire(900)
+        a.transient_clear_range=(790,865)
+        with self.assertRaisesRegex(RuntimeError, '重新触发'):
+            self.run_park(a)
+        self.assertIsNone(a.active_move)
+        self.assertGreater(a.position,750)
+
+    def test_short_clear_bounce_is_not_a_confirmed_departure(self):
+        a=ParkWire(900)
+        a.transient_clear_range=(840,845)
+        with self.assertRaisesRegex(RuntimeError, '短退范围内'):
+            self.run_park(a)
+        self.assertIsNone(a.active_move)
+
+    def test_inlet_loss_stops_same_command(self):
+        a=ParkWire(45)
+        a.gate_failure_at=-250
+        with self.assertRaises(RuntimeError):
+            self.run_park(a)
+        self.assertIsNone(a.active_move)
+        self.assertEqual(len(a.motion_commands),1)
+
+    def test_lane_fault_without_arrival_does_not_replay(self):
+        a=ParkWire(45)
+        a._lane_states=lambda idx,monitor=None:{0:'rollback_error'}
+        with self.assertRaisesRegex(RuntimeError,'原槽状态异常'):
+            self.run_park(a)
+        self.assertIsNone(a.active_move)
+        self.assertEqual(len(a.motion_commands),1)
+
+    def test_lost_ack_stops_without_retry(self):
+        a=ParkWire(45)
+        a.reject_move=1
+        with self.assertRaises(park.ParkAckUnavailable):
+            self.run_park(a)
+        self.assertIsNone(a.active_move)
+        self.assertEqual(len(a.motion_commands),1)
