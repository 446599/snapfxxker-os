+"""Exercise the background head switch and ACE fault paths with no encoder."""
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+from test_print_assist_recovery import Reactor
+
+
+def background_feed():
+    root = Path(__file__).resolve().parents[1] / 'runtime/klipper/extras'
+    node = next(n for n in ast.walk(ast.parse((root/'ace_bg_swap.py').read_text()))
+                if isinstance(n, ast.FunctionDef) and n.name == '_ace_feed_to_gears')
+    scope = {'require_printer_clear': lambda *a, **k: None, 'BG_FEED_FA_RESCUE': 20}
+    exec(compile(ast.Module(body=[node], type_ignores=[]),str(root/'ace_bg_swap.py'),'exec'),scope)
+    return scope[node.name]
+
+
+feed = background_feed()
+
+
+class BackgroundFeed(unittest.TestCase):
+    def simulate(self, state, pin, ack):
+        clock = Reactor()
+        sent, stops = [], []
+        sensor = SimpleNamespace(get_status=lambda _: {'filament_detected': pin(clock.now)})
+        def send(ace, idx, req):
+            sent.append(req['method'])
+            return ack
+        fake = SimpleNamespace(reactor=clock, printer=SimpleNamespace(lookup_object=lambda *args: sensor),
+                               _ace_send=send, _ace_stop=lambda *args: None,
+                               _resp_rejected=lambda reply: reply.get('code') != 0,
+                               _stop_feed_or_latch=lambda *args: stops.append(1),
+                               _pause=lambda d: clock.pause(clock.now+d),
+                               _slot_status=lambda *args: state(clock.now), _say=lambda *args: None)
+        ace = SimpleNamespace(_is_v2_idx=lambda idx: True, _travel_legacy_start=lambda *args: None,
+                              _travel_legacy_finish=lambda *args: None, _feed_assist_per_ace={},
+                              _head_travel=SimpleNamespace(unknown=lambda *args: None))
+        result=feed(fake,ace,0,0,100,80,0)
+        self.assertEqual(stops,[1])
+        self.assertNotIn('get_feed_info',sent)
+        return result,sent
+
+    def test_head_switch_completes_normal_feed(self):
+        self.assertEqual(self.simulate(lambda t:'feeding',lambda t:t>101,{'code':0})[0], 'ok')
+
+    def test_native_fault_or_lost_ack_preserves_route(self):
+        for lane,ack in [('feed_error',{'code':0}),('ready',None)]:
+            with self.subTest(lane=lane):
+                self.assertEqual(self.simulate(lambda t:lane,lambda t:False,ack),('uncertain',['feed_filament']))
+
+    def test_clean_no_arrival_retains_bounded_assist_rescue(self):
+        self.assertEqual(self.simulate(lambda t:'ready',lambda t:t>106,{'code':0}),
+                         ('ok',['feed_filament','start_feed_assist']))
