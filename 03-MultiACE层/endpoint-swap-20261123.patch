+"""Normal unload decisions must use endpoints, not in-flight decoder spans."""
+import ast
+from pathlib import Path
+import unittest
+
+import test_fixed_park
+
+
+class EndpointUnloadTests(unittest.TestCase):
+    def fixture(self):
+        return test_fixed_park.FixedParkTests().incident_fixture()
+
+    def test_direct_park_defers_to_head_clear_probe(self):
+        h, a, _ = self.fixture()
+        a.position = 5
+        self.assertFalse(h._finish_fixed_unload(0, 0, 0, 150, 80, direct=True))
+        self.assertEqual(a.motion_commands, [])
+        self.assertFalse(a._head_travel.status()['0']['pending'])
+
+    def test_known_decoder_and_saved_target_use_commanded_return(self):
+        h, a, saved = self.fixture()
+        row = a._head_travel.records['0']
+        row.update(known=True, loaded_mm=1725.0, remaining_mm=1575.0, samples=2,
+                   load_receipt={'uid': saved['scope']['uid'], 'ace': 0, 'slot': 0,
+                                 'head': 0, 'insert_epoch': 1, 'forward_decoder_sign': 1})
+        a.decoder_present = True
+        self.assertTrue(h._finish_fixed_unload(0, 0, 0, 150, 80))
+        self.assertEqual([cmd['params']['length'] for cmd in a.motion_commands], [1330])
+        self.assertNotIn('get_feed_info', [method for method, _, _ in a.calls])
+        row = a._head_travel.status()['0']
+        self.assertFalse(row['known'])
+        self.assertEqual(row['reason'], 'commanded_return')
+        self.assertFalse(row['park_reference_reached'])
+
+    def foreground_fixture(self):
+        h, a, saved = self.fixture()
+        a._swap_in_progress = True
+        a._swap_phase = 'unload'
+        a.print.state = 'printing'
+        a._retract_length_override = 900
+        a.get_swap_retract_length = lambda idx, slot: 900
+        a._source_insertion_matches = lambda source, idx, slot: True
+        h._finish_fixed_unload.__func__.__globals__['unload_source_matches'] = lambda *args: True
+        return h, a, saved
+
+    def test_foreground_saved_target_precedes_config_and_keeps_distance_unknown(self):
+        h, a, saved = self.foreground_fixture()
+        self.assertTrue(h._finish_fixed_unload(0, 0, 0, 150, 80))
+        self.assertEqual([x['params']['length'] for x in a.motion_commands], [1330])
+        self.assertNotIn('get_feed_info', [method for method, _, _ in a.calls])
+        row = a._head_travel.status()['0']
+        self.assertFalse(row['known'])
+        self.assertFalse(row['park_reference_reached'])
+        self.assertEqual(row['reason'], 'commanded_return')
+        self.assertEqual(a._head_travel.fixed_park_references['0:0:0'], saved)
+        self.assertTrue(a._swap_in_progress)
+
+    def test_foreground_configured_fallback_debits_short_command(self):
+        h, a, _ = self.foreground_fixture()
+        a._head_travel.fixed_park_references.clear()
+        self.assertTrue(h._finish_fixed_unload(0, 0, 0, 150, 80))
+        self.assertEqual([x['params']['length'] for x in a.motion_commands], [750])
+        self.assertFalse(a._head_travel.status()['0']['known'])
+        self.assertFalse(a._head_travel.fixed_park_references)
+
+    def test_foreground_rejects_unconfirmed_source_and_non_swap(self):
+        h, a, _ = self.foreground_fixture()
+        a._source_insertion_matches = lambda *args: False
+        with self.assertRaises(RuntimeError):
+            h._finish_fixed_unload(0, 0, 0, 150, 80)
+        self.assertEqual(a.motion_commands, [])
+        h, a, _ = self.foreground_fixture()
+        a._swap_in_progress = False
+        self.assertFalse(h._finish_fixed_unload(0, 0, 0, 150, 80))
+        self.assertEqual(a.motion_commands, [])
+
+    def test_foreground_no_reference_and_no_config_fails_closed(self):
+        h, a, _ = self.foreground_fixture()
+        a._head_travel.fixed_park_references.clear()
+        a._retract_length_override = None
+        self.assertFalse(h._finish_fixed_unload(0, 0, 0, 150, 80))
+        self.assertEqual(a.motion_commands, [])
+        self.assertFalse(a._head_travel.status()['0']['pending'])
+
+    def test_foreground_refuses_head_present_and_stop_fault(self):
+        h, a, _ = self.foreground_fixture()
+        a.position = 1
+        with self.assertRaisesRegex(RuntimeError, '尚未清空'):
+            h._finish_fixed_unload(0, 0, 0, 150, 80)
+        self.assertEqual(a.motion_commands, [])
+        h, a, _ = self.foreground_fixture()
+        a.faults.append({'fault': 'stop'})
+        with self.assertRaises(RuntimeError):
+            h._finish_fixed_unload(0, 0, 0, 150, 80)
+        self.assertEqual(a.motion_commands, [])
+
+    def test_wrong_scope_uses_config_without_overwriting_reference(self):
+        h, a, saved = self.foreground_fixture()
+        saved['scope'] = dict(saved['scope'], port='another-port')
+        self.assertTrue(h._finish_fixed_unload(0, 0, 0, 150, 80))
+        self.assertEqual([x['params']['length'] for x in a.motion_commands], [750])
+        self.assertEqual(a._head_travel.fixed_park_references['0:0:0'], saved)
+
+    def test_foreground_swap_phase_change_stops_move(self):
+        h, a, _ = self.foreground_fixture()
+        original = a.advance
+        def change(reactor, target):
+            original(reactor, target)
+            if a.active_move is not None:
+                a._swap_phase = 'load'
+        a.advance = change
+        with self.assertRaises(RuntimeError):
+            h._finish_fixed_unload(0, 0, 0, 150, 80)
+        self.assertIsNone(a.active_move)
+        self.assertFalse(a._head_travel.status()['0']['known'])
+
+    def test_unload_branches_do_not_use_decoder_span_or_stall_gate(self):
+        path = Path(__file__).resolve().parents[1] / 'runtime/klipper/extras/filament_feed_ace.py'
+        source = path.read_text()
+        tree = ast.parse(source)
+        method = next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == '_do_feed')
+        # Load seat press and both unload branches are endpoint-only.
+        calls = [n for n in ast.walk(method) if isinstance(n, ast.Call)
+                 and isinstance(n.func, ast.Attribute)]
+        spans = [n for n in calls if n.func.attr == '_retract_with_decoder_span']
+        self.assertEqual(spans, [])
+        self.assertFalse(any(n.func.attr == '_unload_dec_stalled' for n in calls))
+        fixed_calls = [n for n in calls if n.func.attr == '_finish_fixed_unload']
+        self.assertEqual(len(fixed_calls), 4)  # direct probe and final return, in both branches
+        press_calls = [n for n in ast.walk(method) if isinstance(n, ast.Call)
+                       and isinstance(n.func, ast.Name) and n.func.id == '_do_press']
+        self.assertEqual(len(press_calls), 1)
+        self.assertFalse(any(n.func.attr == 'note_seat_press_span' for n in calls))
+
+
+if __name__ == '__main__':
+    unittest.main()
