--- /dev/null
+++ b/tests/test_endpoint_aux.py
@@ -0,0 +1,213 @@
+"""Bounded operational eject and short recovery use stopped endpoints only."""
+from types import SimpleNamespace
+import unittest
+
+from test_recovery_ui import SlotActions, Reactor
+
+
+class InletEjectTests(unittest.TestCase):
+    def run_eject(self, *, clear_at=6.5, fault_at=None, ready_at=None, stop_fault=False):
+        reactor = Reactor()
+        reactor.pause = lambda until: setattr(reactor, 'now', until)
+        transport = object()
+        recovery = SimpleNamespace(begin=lambda *a, **kw: object(), end=lambda *_: None)
+        ace = SimpleNamespace(reactor=reactor, _error_recovery=recovery, _path_operations=None,
+            _stop_guard=SimpleNamespace(recovery_snapshot=lambda: (1, [])),
+            _insert_epochs={(0, 0): 7}, _swap_in_progress=True)
+        actions = object.__new__(SlotActions)
+        actions.ace, actions.state, actions.cancel = ace, {'state': 'running'}, False
+        actions._eject_peers = {}
+        actions._check = lambda *a, **kw: None
+        def bind(*args, **kwargs):
+            actions._eject_identity = ('port', (1, 2, 3))
+            actions._eject_epoch, actions._eject_heads = 7, ()
+        actions._bind_legacy_route = bind
+        actions._loaded_assist_head = lambda *a: None
+        actions._release_verified_stop_fault = lambda *a, **kw: None
+        actions._other_routes_ready = lambda *a, **kw: None
+        def monitor(idx, slot, original, deadline, **kwargs):
+            if original is not transport or reactor.monotonic() >= deadline:
+                raise RuntimeError('本次操作超过时限')
+        actions._original_monitor = monitor
+        actions._arm_route_hold = lambda *a: None
+        motions = []
+        actions._send_eject_motion = lambda idx, slot, length, speed, monitor: motions.append((length, speed))
+        def status(*args, **kwargs):
+            if fault_at is not None and reactor.now >= fault_at:
+                return {0: 'motor_error'}
+            return {0: 'ready' if ready_at is not None and reactor.now >= ready_at else 'rollback'}
+        actions._lane_states = status
+        actions._gate = lambda *a, **kw: clear_at is None or reactor.now < clear_at
+        actions._feed_row = lambda *a, **kw: self.fail('CMD76 queried during eject')
+        committed = []
+        actions._commit_ejected = lambda *a: committed.append(True)
+        def stop(*args, **kwargs):
+            gate = clear_at is None or reactor.now < clear_at
+            stopped_state = 'motor_error' if stop_fault and not gate else 'ready'
+            actions._last_eject_stop = dict(status=stopped_state, gate=gate, decoder_present=False)
+            return gate
+        actions._eject_stop_ready = stop
