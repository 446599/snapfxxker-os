#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
DAEMON=/opt/u1-interface/device-service/device_service.py
PIDFILE=/var/run/u1-device-service.pid
case "${1:-}" in
  start)
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/bin/python3 -- "$DAEMON"
    ;;
  stop)
    start-stop-daemon -K -p "$PIDFILE"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *) printf 'Usage %s {start|stop|restart}\n' "$0"; exit 2 ;;
esac
