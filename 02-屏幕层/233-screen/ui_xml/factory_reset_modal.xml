<component>
  <!-- The navigation stack sizes the overlay. The warning card fits inside it. -->
  <view name="factory_reset_modal" extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_border_width="0" style_bg_color="#screen_bg" style_bg_opa="255" scrollable="false">
    <ui_dialog name="factory_reset_card" width="90%" height="content" style_max_width="#u1_modal_width" style_max_height="94%" align="center"
               flex_flow="column" style_pad_gap="0" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border" scrollable="false">
      <modal_header icon_src="alert_octagon" icon_variant="danger" title="Factory Reset"/>
      <lv_obj name="content_container" width="100%" height="content" style_pad_hor="#u1_card_pad_roomy" style_pad_top="0"
              style_pad_bottom="#u1_card_pad_roomy" style_max_height="80" style_bg_opa="0" style_border_width="0"
              scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
        <text_body name="dialog_message" width="100%" text="This will reset all settings to defaults. This action cannot be undone." style_text_font="#u1_body_font" style_text_line_space="#u1_compact_gap" style_text_align="left" long_mode="wrap"/>
      </lv_obj>
      <modal_button_row primary_text="Reset" secondary_text="Cancel" primary_variant="danger" primary_callback="on_factory_reset_confirm" secondary_callback="on_factory_reset_cancel"/>
    </ui_dialog>
  </view>
</component>
