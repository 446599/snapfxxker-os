<!-- Notification History Panel - Review past notifications -->
<component>
  <view name="notification_history_panel" extends="lv_obj" width="100%" height="100%" style_bg_color="#text" style_bg_opa="90" style_border_width="0" style_pad_all="8" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center">
    <lv_obj name="notification_card" width="100%" height="100%" flex_flow="column" style_bg_color="#card_bg" style_bg_opa="255" style_radius="10" style_border_width="1" style_border_color="#border" style_pad_all="0" style_shadow_width="16" style_shadow_opa="40" style_shadow_offset_y="3" style_shadow_color="#text" scrollable="false">
      <lv_obj name="overlay_title_row" width="100%" height="40" flex_flow="row" style_pad_hor="14" style_pad_ver="0" style_flex_cross_place="center" style_flex_track_place="center" style_border_width="1" style_border_side="bottom" style_border_color="#border" style_bg_opa="0" scrollable="false">
        <text_body text="通知" style_text_font="#u1_body_font"/>
        <lv_obj width="0" flex_grow="1" height="1" style_bg_opa="0" style_border_width="0" clickable="false"/>
        <lv_obj name="overlay_close" width="56" height="36" style_pad_all="0" style_bg_opa="0" style_border_width="0" clickable="true" scrollable="false">
          <event_cb trigger="clicked" callback="on_notification_history_close"/>
          <text_small align="center" text="关闭" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
        </lv_obj>
      </lv_obj>
      <lv_obj name="overlay_content" width="100%" flex_grow="1" scroll_dir="ver" style_pad_all="0" style_pad_gap="8" flex_flow="column" scrollbar_mode="active" style_pad_top="8" style_pad_bottom="8" style_pad_left="12" style_pad_right="12">
        <bind_flag_if_eq subject="notification_has_entries" flag="hidden" ref_value="0"/>
        <repeat count="notification_row_count">
          <notification_history_item severity_subject="notification_row_severity_${i}" title_subject="notification_row_title_${i}" message_subject="notification_row_message_${i}" has_message_subject="notification_row_has_message_${i}" timestamp_subject="notification_row_time_${i}" has_action_subject="notification_row_has_action_${i}" action_label_subject="notification_row_action_label_${i}" click_callback="on_notification_item_clicked" row_index="${i}"/>
        </repeat>
      </lv_obj>
      <lv_obj name="empty_state" width="100%" flex_grow="1" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" scrollable="false">
        <bind_flag_if_eq subject="notification_has_entries" flag="hidden" ref_value="1"/>
        <icon src="bell" size="lg" variant="muted"/>
        <text_muted width="100%" text="暂无通知" style_pad_top="#space_md" style_text_align="center"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
