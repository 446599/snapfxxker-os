<!-- Advanced > HelixPrint Plugin: read-only. PluginOverviewOverlay fills it
     with the plugin's version and one line per feature in its status map;
     a feature with a setting leads to the page that holds it. -->
<component>
  <api>
    <prop name="title" type="string" default="HelixPrint Plugin"/>
    <prop name="title_tag" type="string" default="HelixPrint Plugin"/>
  </api>
  <view name="plugin_overview_overlay" extends="overlay_panel" title="$title" title_tag="$title_tag" bg_color="#screen_bg" title_transform="none" title_font="#font_heading" title_color="#text">
    <lv_obj name="overlay_content" width="100%" flex_grow="1" style_pad_top="8" style_pad_left="12" style_pad_right="12" style_pad_bottom="8" scrollable="true" flex_flow="column" style_pad_all="#u1_page_pad" style_pad_gap="8" scrollbar_mode="auto">
      <lv_obj name="overview_rows" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="column"/>
    </lv_obj>
  </view>
</component>
