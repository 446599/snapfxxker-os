<component>
  <!-- Print Select Panel - Dual view: Card grid or List view -->
  <!-- Panel-specific constants -->
  <consts>
    <!-- List view dimensions -->
    <px name="list_row_gap" value="4"/>
    <px name="list_header_padding" value="8"/>
    <px name="list_sort_icon_size" value="16"/>
    <!-- Metadata dimensions for cards -->
    <px name="metadata_row_height" value="24"/>
    <!-- Minimum widths to prevent text crushing -->
    <px name="metadata_label_min_width" value="30"/>
  </consts>
  <view name="print_select_panel_root" extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_pad_top="0" style_pad_gap="0" style_border_width="0" flex_flow="column" style_bg_color="#screen_bg" scrollable="false">
    <!-- Disable all controls when printer not connected or klippy not ready -->
    <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>

    <lv_obj name="files_toolbar" width="100%" height="#u1_touch_target" style_pad_all="0" style_pad_hor="#u1_page_pad" style_border_width="0" style_bg_opa="0" flex_flow="row" style_flex_cross_place="center" scrollable="false">
      <bind_flag_if cond="print_select_header_toggle and (not print_source_usb_present or print_source_moonraker_usb_access)" flag="hidden"/>

      <!-- Source selector (left side) - Segmented tab control -->
      <!-- Hidden unless a USB drive is present AND Moonraker doesn't already
           expose USB files via symlink (in which case our own picker is
           redundant) — see PrintSelectUsbSource in ui_print_select_usb_source.cpp,
           which owns print_source_usb_present / print_source_moonraker_usb_access. -->
      <!-- hidden="true" base attribute is redundant once bind_flag_if fires at
           creation (both subjects default to 0, which evaluates hidden too) —
           kept as a failure-safe default matching the sibling buttons below,
           not a Rule #6 inline-vs-binding conflict. -->
      <!-- No vertical padding: the selector must be exactly as tall as
           view_toggle_btn, so showing it never changes the header's height.
           The card grid is sized from that height when it populates, and a
           drive can be reported after that. -->
      <lv_obj name="source_selector" width="content" height="content" hidden="true" style_radius="#space_sm" style_pad_all="0" flex_flow="row" style_pad_gap="#u1_card_gap" scrollable="false">
        <bind_flag_if cond="not print_source_usb_present or print_source_moonraker_usb_access" flag="hidden"/>

        <!-- Printer tab: filled (active) when source=printer -->
        <ui_button name="source_printer_active" width="#u1_print_list_size_width" style_min_width="0" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" height="#u1_touch_target" text="Printer" hidden="true" style_pad_top="#u1_compact_gap" style_pad_bottom="#u1_compact_gap">
          <bind_flag_if_not_eq subject="print_source_is_usb" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_print_select_source_printer"/>
        </ui_button>
        <!-- Printer tab: outline (inactive) when source=usb -->
        <ui_button name="source_printer_inactive" width="#u1_print_list_size_width" style_min_width="0" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" height="#u1_touch_target" variant="outline" text="Printer" hidden="true" style_pad_top="#u1_compact_gap" style_pad_bottom="#u1_compact_gap">
          <bind_flag_if_not_eq subject="print_source_is_usb" flag="hidden" ref_value="1"/>
          <event_cb trigger="clicked" callback="on_print_select_source_printer"/>
        </ui_button>

        <!-- USB tab: filled (active) when source=usb -->
        <ui_button name="source_usb_active" width="#u1_print_list_size_width" style_min_width="0" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" height="#u1_touch_target" text="USB" hidden="true" style_pad_top="#u1_compact_gap" style_pad_bottom="#u1_compact_gap">
          <bind_flag_if_not_eq subject="print_source_is_usb" flag="hidden" ref_value="1"/>
          <event_cb trigger="clicked" callback="on_print_select_source_usb"/>
        </ui_button>
        <!-- USB tab: outline (inactive) when source=printer -->
        <ui_button name="source_usb_inactive" width="#u1_print_list_size_width" style_min_width="0" style_radius="#u1_card_radius" style_pad_hor="#u1_compact_gap" height="#u1_touch_target" variant="outline" text="USB" hidden="true" style_pad_top="#u1_compact_gap" style_pad_bottom="#u1_compact_gap">
          <bind_flag_if_not_eq subject="print_source_is_usb" flag="hidden" ref_value="0"/>
          <event_cb trigger="clicked" callback="on_print_select_source_usb"/>
        </ui_button>
      </lv_obj>

      <lv_obj width="0" height="0" flex_grow="1" scrollable="false"/>
      <ui_button name="view_toggle_btn" width="#u1_touch_target" height="#u1_touch_target" style_min_width="0" style_pad_all="0" icon="list" variant="ghost">
        <bind_flag_if_eq subject="print_select_header_toggle" flag="hidden" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_print_select_view_toggle"/>
      </ui_button>
    </lv_obj>
    <!-- header -->

    <!-- Context banner (shown when entering via Library > Recent) -->
    <lv_obj name="context_banner" width="100%" height="content" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_xxs" style_pad_bottom="#space_xxs" hidden="true" scrollable="false">
      <text_small name="context_banner_text" text="Recently Printed"/>
    </lv_obj>

    <!-- Card view container (visible when view_mode == 0) -->
    <!-- Note: style_pad_gap controls spacing between cards, used by C++ layout calculations -->
    <lv_obj name="card_view_container" width="100%" height="0" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" flex_flow="row_wrap" scrollable="true" scroll_dir="ver" flex_grow="1">
      <bind_flag_if_eq subject="print_select_view_mode" flag="hidden" ref_value="1"/>
      <!-- Cards will be dynamically added here via C++ -->
    </lv_obj>
    <!-- List view container (visible when view_mode == 1) -->
    <lv_obj name="list_view_container" width="100%" height="0" style_pad_all="0" style_pad_hor="#u1_page_pad" style_pad_gap="0" flex_flow="column" flex_grow="1" scrollable="false">
      <bind_flag_if_eq subject="print_select_view_mode" flag="hidden" ref_value="0"/>
      <!-- Column headers -->
      <lv_obj name="list_header" width="100%" height="#u1_touch_target" style_pad_all="0" style_pad_hor="#u1_card_pad" style_border_width="#u1_border" style_border_opa="0" style_pad_gap="#u1_compact_gap" style_bg_opa="0" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" scrollable="false">
        <!-- Filename header (flex-grow) -->
        <lv_obj width="0" height="100%" flex_grow="1" style_min_width="#u1_print_list_name_min_width" style_pad_all="0" style_border_width="0" style_bg_opa="0" flex_flow="row" scrollable="false">
          <ui_button name="header_filename" height="100%" text="Filename" variant="ghost" flex_grow="1" flex_flow="row" style_pad_column="#u1_compact_gap" style_flex_main_place="start" style_flex_cross_place="center" style_pad_hor="0" style_min_width="0">
            <event_cb trigger="clicked" callback="on_print_select_header_filename"/>
            <icon name="header_filename_icon_up" src="arrow_up" size="xs" variant="primary" hidden="true"/>
            <icon name="header_filename_icon_down" src="arrow_down" size="xs" variant="primary" hidden="true"/>
          </ui_button>
        </lv_obj>
        <!-- Status header (non-sortable) -->
        <lv_obj name="header_status" width="#u1_print_list_status_width" height="100%" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" scrollable="false">
          <text_body name="header_status_label" text="Status" style_text_align="center"/>
        </lv_obj>
        <!-- Size header -->
        <ui_button name="header_size" width="#u1_print_list_size_width" height="100%" text="Size" variant="ghost" flex_flow="row" style_pad_column="#u1_compact_gap" style_flex_main_place="end" style_flex_cross_place="center" style_pad_hor="0" style_min_width="0">
          <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
          <event_cb trigger="clicked" callback="on_print_select_header_size"/>
          <icon name="header_size_icon_up" src="arrow_up" size="xs" variant="primary" hidden="true"/>
          <icon name="header_size_icon_down" src="arrow_down" size="xs" variant="primary" hidden="true"/>
        </ui_button>
        <!-- Modified header -->
        <ui_button name="header_modified" width="#u1_print_list_modified_width" height="100%" text="Modified" variant="ghost" flex_flow="row" style_pad_column="#u1_compact_gap" style_flex_main_place="end" style_flex_cross_place="center" style_pad_hor="0" style_min_width="0">
          <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
          <event_cb trigger="clicked" callback="on_print_select_header_modified"/>
          <icon name="header_modified_icon_up" src="arrow_up" size="xs" variant="primary" hidden="true"/>
          <icon name="header_modified_icon_down" src="arrow_down" size="xs" variant="primary" hidden="true"/>
        </ui_button>
        <!-- Print Time header -->
        <ui_button name="header_print_time" width="#u1_print_list_time_width" height="100%" text="Time" variant="ghost" flex_flow="row" style_pad_column="#u1_compact_gap" style_flex_main_place="end" style_flex_cross_place="center" style_pad_hor="0" style_min_width="0">
          <event_cb trigger="clicked" callback="on_print_select_header_print_time"/>
          <icon name="header_print_time_icon_up" src="arrow_up" size="xs" variant="primary" hidden="true"/>
          <icon name="header_print_time_icon_down" src="arrow_down" size="xs" variant="primary" hidden="true"/>
        </ui_button>
      </lv_obj>
      <!-- Scrollable list rows container -->
      <lv_obj name="list_rows_container" width="100%" height="0" style_pad_all="0" style_pad_bottom="#u1_page_pad" style_pad_gap="#list_row_gap" flex_flow="column" scrollable="true" scroll_dir="ver" flex_grow="1">
        <!-- List rows will be dynamically added here via C++ -->
      </lv_obj>
    </lv_obj>
    <!-- Empty state message (shared, initially hidden) -->
    <lv_obj name="empty_state_container" width="100%" height="0" style_pad_all="0" flex_grow="1" hidden="true" scrollable="false">
      <centered_column width="content" height="content" style_pad_all="#space_xl" align="center" pad_gap="#space_sm">
        <text_heading text="No files available for printing" style_text_align="center"/>
        <text_body text="Upload gcode files to get started" style_text_align="center"/>
      </centered_column>
    </lv_obj>
  </view>
</component>
