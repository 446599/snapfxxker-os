<component>
  <!-- First-Run Wizard: AMS Identification Screen (Informational) -->
  <!-- Displays detected AMS system type and lane count -->
  <consts>
    <!-- Step metadata (read by wizard orchestrator) -->
    <str name="step_title" value="Multi-Filament System Detected" value_tag="Multi-Filament System Detected"/>
    <str name="step_subtitle" value="Your printer has an automatic filament changer" value_tag="Your printer has an automatic filament changer"/>
    <int name="step_order" value="6"/>
  </consts>
  <view name="wizard_ams_identify_root" extends="lv_obj" width="100%" height="100%" style_bg_opa="0" style_border_width="0" style_pad_all="0" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#u1_card_gap">

    <!-- Info card -->
    <ui_card width="100%" flex_grow="1" style_radius="#u1_card_radius" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center" style_border_width="#u1_border" style_border_color="#border" style_border_opa="255" style_bg_color="#card_bg" style_bg_opa="255" style_shadow_width="0" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">

      <!-- Logo image - 64x64 icons, use min_width/min_height to prevent clipping -->
      <lv_image name="ams_logo" width="64" height="64" style_min_width="64" style_min_height="64" inner_align="center" hidden="true">
        <bind_style_if_eq name="styles.ams_logo_mono" subject="wizard_ams_logo_color" ref_value="0"/>
      </lv_image>

      <!-- Spacer between logo and text -->
      <lv_obj width="1" height="#space_md"/>

      <!-- AMS Type name - REACTIVE BINDING -->
      <text_heading name="ams_type_label" bind_text="wizard_ams_type" style_text_align="center"/>

      <!-- Details: "4 lanes • Turtle_1" - REACTIVE BINDING -->
      <text_muted name="ams_details_label" bind_text="wizard_ams_details" style_text_align="center"/>

      <!-- Spacer between content and message -->
      <lv_obj width="1" height="#space_lg"/>

      <!-- Integration message - static text -->
      <text_muted width="85%" style_text_align="center" text="HelixScreen will integrate with your filament changer for multi-spool/color print operations."/>

    </ui_card>

  </view>
</component>
