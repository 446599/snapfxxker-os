<!-- Reusable Settings Dropdown Row Component -->
<!-- Responsive: compact padding on micro breakpoint, info icon for descriptions -->
<component>
  <api>
    <prop name="label" type="string" default="Setting"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
    <prop name="description" type="string" default=""/>
    <prop name="description_tag" type="string" default=""/>
    <prop name="options" type="string" default=""/>
    <prop name="options_tag" type="string" default=""/>
    <prop name="bind_selected" type="string"/>
    <prop name="callback" type="string" default=""/>
    <prop name="disabled" type="string" default=""/>
    <prop name="dropdown_width" type="string" default="33%"/>
    <prop name="hide_description" type="string" default="false"/>
  </api>
  <styles>
    <style name="label_enabled" text_color="#text"/>
    <style name="label_disabled" text_color="#text_subtle"/>
  </styles>
  <view name="dropdown_row" extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_bg_opa="0" style_border_width="0" scrollable="false" style_flex_track_place="center">
    <bind_style_if_le name="styles.setting_row_compact" subject="ui_breakpoint" ref_value="1"/>
    <bind_style_if_ge name="styles.setting_row_standard" subject="ui_breakpoint" ref_value="2"/>
    <!-- Left side: Optional icon — hidden (no broken-glyph fallback) when none given -->
    <lv_obj scrollable="false">
      <style name="styles.u1_setting_icon_slot"/>
      <icon hidden_if_empty="$icon" name="row_icon" src="$icon" size="sm" variant="secondary" align="center"/>
    </lv_obj>
    <!-- Middle: Label and optional description -->
    <lv_obj width="0" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" flex_grow="1" scrollable="false">
      <text_body name="label" width="100%" text="$label" translation_tag="$label_tag" long_mode="wrap" style_text_font="#font_body_bold">
        <bind_style name="label_enabled" subject="$disabled" ref_value="0"/>
        <bind_style name="label_disabled" subject="$disabled" ref_value="1"/>
      </text_body>
      <!-- Description wrapper: collapsed at parse time when there is no description or
           hide_description="true", so the reactive breakpoint bind below cannot bring back
           an empty line. The label then centers vertically against the dropdown. -->
      <lv_obj width="100%" height="content" style_pad_all="0" style_border_width="0" scrollable="false" hidden_if_empty="$description" hidden_if_prop_eq="$hide_description|true">
        <!-- Description: hidden on micro/tiny by default -->
        <text_small name="description" style_text_font="#u1_aux_font" width="100%" text="$description" translation_tag="$description_tag" long_mode="wrap" style_pad_top="#u1_compact_gap">
          <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="2"/>
        </text_small>
      </lv_obj>
    </lv_obj>
    <!-- Info icon: hidden if no description, hidden on medium+ -->
    <lv_obj width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" hidden_if_empty="$description">
      <lv_obj name="info_btn" width="#u1_touch_target" height="#u1_touch_target" style_pad_all="0" style_bg_opa="0" style_border_width="0" clickable="true" event_bubble="false" scrollable="false" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
        <bind_flag_if_gt subject="ui_breakpoint" flag="hidden" ref_value="1"/>
        <icon src="info_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
        <event_cb trigger="clicked" callback="on_setting_info_clicked"/>
      </lv_obj>
    </lv_obj>
    <!-- Right side: Dropdown -->
    <lv_dropdown name="dropdown" width="$dropdown_width" height="content" options="$options" options_tag="$options_tag" bind_selected="$bind_selected" style_radius="#u1_card_radius" style_min_height="#u1_touch_target" style_margin_top="2" style_margin_bottom="2">
      <style name="styles.u1_settings_control"/>
      <style name="styles.u1_settings_control_focus" selector="focused"/>
      <bind_state_if_eq subject="$disabled" state="disabled" ref_value="1"/>
      <event_cb trigger="value_changed" callback="$callback"/>
    </lv_dropdown>
    <!-- Content-height flex rows need a real track height to center short labels. -->
    <lv_obj name="row_height_anchor" width="0" height="#u1_touch_target" style_pad_all="0" style_border_width="0" style_bg_opa="0" scrollable="false" clickable="false">
      <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="2"/>
    </lv_obj>
  </view>
</component>
