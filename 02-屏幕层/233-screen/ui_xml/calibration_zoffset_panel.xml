<!-- Z-Offset Calibration Panel -->
<!-- Interactive calibration using PROBE_CALIBRATE, TESTZ, ACCEPT, ABORT commands -->
<component>
  <view name="calibration_zoffset_panel" extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255" style_bg_color="#screen_bg" style_pad_all="0" style_border_width="0" scrollable="false" flex_flow="column">
    <!-- Header Bar -->
    <header_bar name="overlay_header" title="Z-Offset Calibration" title_font="#font_heading" title_color="#text"/>
    <!-- Content Area -->
    <lv_obj name="overlay_content" width="100%" flex_grow="1" style_pad_all="#u1_page_pad" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="false" style_pad_top="8" style_pad_bottom="8" style_pad_left="12" style_pad_right="12">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- STATE: IDLE (0) - Instructions and Start Button -->
      <!-- ================================================================== -->
      <lv_obj name="state_idle" width="100%" flex_grow="1" style_pad_all="8" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="zoffset_cal_state" flag="hidden" ref_value="0"/>
        <!-- Instructions -->
        <!-- Two-column layout: Steps (left) | Warm Bed (right) -->
        <!-- Start Button -->
        <lv_obj name="state_idle_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <lv_obj width="100%" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm">
            <text_heading width="100%" text="Paper Test Calibration" style_text_align="center"/>
            <text_small width="100%" text="This calibration uses the paper friction method to set your Z-offset." style_text_align="center"/>
          </lv_obj>
          <lv_obj width="100%" flex_grow="0" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false" height="content">
            <!-- Left: Steps Preview -->
            <lv_obj height="content" flex_grow="1" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="#space_lg" flex_flow="column" style_pad_gap="#space_xs" style_border_color="#border" style_border_width="1">
              <text_small text="Have a piece of paper ready." style_text_color="#text_muted"/>
              <lv_obj width="100%" height="4" style_pad_all="0"/>
              <text_small width="100%" text="1. Printer homes and probes the bed"/>
              <text_small width="100%" text="2. Place paper between nozzle and bed"/>
              <text_small width="100%" text="3. Lower nozzle until paper drags slightly"/>
              <text_small width="100%" text="4. Paper should move but with resistance"/>
            </lv_obj>
            <!-- Divider -->
            <divider_vertical height="80%"/>
            <!-- Right: Warm Bed Option (only visible when printer has a heated bed) -->
            <lv_obj height="content" flex_grow="1" style_pad_all="#space_lg" style_bg_color="#card_bg" style_radius="#border_radius" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false" style_border_color="#border" style_border_width="1">
              <bind_flag_if_not_eq subject="printer_has_heater_bed" flag="hidden" ref_value="1"/>
              <!-- Left: icon + text -->
              <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
                <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
                  <icon src="thermometer" size="sm" variant="secondary"/>
                  <text_body text="Warm Bed"/>
                </lv_obj>
                <text_small width="100%" text="Heat bed before calibrating for accurate offset with thermal expansion." style_text_color="#text_muted"/>
              </lv_obj>
              <!-- Right: switch -->
              <ui_switch name="warm_bed_switch" size="small">
                <bind_state_if_eq subject="zoffset_warm_bed" state="checked" ref_value="1"/>
                <event_cb trigger="value_changed" callback="on_zoffset_warm_bed_toggled"/>
              </ui_switch>
            </lv_obj>
          </lv_obj>
        </lv_obj>
        <ui_button name="btn_start" width="100%" text="Start Calibration" style_min_height="#u1_touch_target" style_radius="8" height="44" style_margin_top="0" style_margin_bottom="0">
          <event_cb trigger="clicked" callback="on_zoffset_start_clicked"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: PROBING (1) - Waiting for probe to complete -->
      <!-- ================================================================== -->
      <lv_obj name="state_probing" width="100%" flex_grow="1" style_pad_all="8" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="zoffset_cal_state" flag="hidden" ref_value="1"/>
        <!-- Abort Button -->
        <lv_obj name="state_probing_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <spinner size="lg"/>
          <text_heading width="100%" text="Probing Bed..." style_text_align="left" long_mode="wrap"/>
          <text_small width="100%" text="Please wait while the printer homes and probes." style_text_align="left" long_mode="wrap"/>
        </lv_obj>
        <ui_button name="btn_abort_probing" width="100%" text="Abort" variant="danger" style_min_height="#u1_touch_target" style_radius="8" height="44" style_margin_top="0" style_margin_bottom="0">
          <event_cb trigger="clicked" callback="on_zoffset_abort_clicked"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: ADJUSTING (2) - Interactive Z adjustment -->
      <!-- ================================================================== -->
      <lv_obj name="state_adjusting" width="100%" flex_grow="1" style_pad_all="8" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="zoffset_cal_state" flag="hidden" ref_value="2"/>
        <!-- Z Position + Indicator side by side -->
        <!-- Instructions -->
        <!-- Adjustment Buttons Grid (Mainsail-style: top=farther, bottom=closer) -->
        <!-- Accept / Abort Buttons -->
        <lv_obj name="state_adjusting_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="4" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <lv_obj width="100%" flex_grow="0" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md" scrollable="false" height="64">
            <!-- Z Position Display (left) -->
            <lv_obj height="100%" flex_grow="2" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="4" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="4" scrollable="false" style_border_color="#border" style_border_width="1" width="0">
              <!-- Saved Z-Offset (left side) -->
              <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false">
                <text_small text="Saved Z-Offset" style_text_color="#text_muted"/>
                <text_heading name="saved_z_offset_display" text=""/>
              </lv_obj>
              <!-- Vertical divider -->
              <divider_vertical height="80%"/>
              <!-- Current Z Position (right side) -->
              <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false">
                <text_small text="Current Z Position" style_text_color="#text_muted"/>
                <text_heading name="z_position_display" text="Z: 0.000"/>
              </lv_obj>
            </lv_obj>
            <!-- Vertical meter indicator (right) -->
            <z_offset_indicator name="z_offset_indicator" height="100%" flex_grow="1" width="0"/>
          </lv_obj>
          <text_small width="100%" text="Move paper back and forth while adjusting. Stop when paper catches slightly but still slides." style_text_align="left" long_mode="wrap"/>
          <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm" scrollable="false">
            <!-- Row 1: Farther from bed (positive Z) — smallest to largest -->
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
              <text_small width="60" text="Farther"/>
              <ui_button name="btn_z_farther_0_005" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="+.005" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="0.005"/>
              </ui_button>
              <ui_button name="btn_z_farther_0_01" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="+.01" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="0.01"/>
              </ui_button>
              <ui_button name="btn_z_farther_0_05" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="+.05" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="0.05"/>
              </ui_button>
              <ui_button name="btn_z_farther_0_1" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="+.1" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="0.1"/>
              </ui_button>
              <ui_button name="btn_z_farther_1" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="+1" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="1"/>
              </ui_button>
            </lv_obj>
            <!-- Row 2: Closer to bed (negative Z) — smallest to largest magnitude -->
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
              <text_small width="60" text="Closer"/>
              <ui_button name="btn_z_closer_0_005" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="-.005" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="-0.005"/>
              </ui_button>
              <ui_button name="btn_z_closer_0_01" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="-.01" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="-0.01"/>
              </ui_button>
              <ui_button name="btn_z_closer_0_05" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="-.05" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="-0.05"/>
              </ui_button>
              <ui_button name="btn_z_closer_0_1" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="-.1" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="-0.1"/>
              </ui_button>
              <ui_button name="btn_z_closer_1" width="0" flex_grow="1" style_min_width="0" style_pad_hor="0" text="-1" style_min_height="#u1_touch_target" style_radius="8">
                <event_cb trigger="clicked" callback="on_zoffset_z_adjust" user_data="-1"/>
              </ui_button>
            </lv_obj>
          </lv_obj>
        </lv_obj>
        <lv_obj width="100%" height="44" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_margin_top="0" style_margin_bottom="0">
          <ui_button name="btn_abort" flex_grow="1" text="Abort" variant="danger" style_min_height="#u1_touch_target" style_radius="8" width="0" height="44" style_min_width="0">
            <event_cb trigger="clicked" callback="on_zoffset_abort_clicked"/>
          </ui_button>
          <ui_button name="btn_accept" flex_grow="1" text="Accept" variant="primary" style_min_height="#u1_touch_target" style_radius="8" width="0" height="44" style_min_width="0">
            <event_cb trigger="clicked" callback="on_zoffset_accept_clicked"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: SAVING (3) - Saving configuration -->
      <!-- ================================================================== -->
      <lv_obj name="state_saving" width="100%" flex_grow="1" style_pad_all="8" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="true" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver">
        <bind_flag_if_not_eq subject="zoffset_cal_state" flag="hidden" ref_value="3"/>
        <spinner size="lg"/>
        <text_heading text="Saving Configuration..." style_text_align="left" width="100%" long_mode="wrap"/>
        <text_small width="100%" text="Klipper will restart to apply changes." style_text_align="left" long_mode="wrap"/>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: COMPLETE (4) - Calibration finished -->
      <!-- ================================================================== -->
      <lv_obj name="state_complete" width="100%" flex_grow="1" style_pad_all="8" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="zoffset_cal_state" flag="hidden" ref_value="4"/>
        <lv_obj name="state_complete_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <lv_label text="#icon_check_circle" style_text_font="mdi_icons_48" style_text_color="#success"/>
          <text_heading text="Calibration Complete!" style_text_align="left" width="100%" long_mode="wrap"/>
          <text_body name="final_offset_label" text="Accepted Z Position: 0.000" width="100%" long_mode="wrap" style_text_align="left"/>
          <text_small name="not_saved_note" width="100%" style_text_align="left" long_mode="wrap" text="Z-offset saving is off, so HelixScreen did not save this. Klipper holds it until the next config save.">
            <bind_flag_if cond="z_offset_save_enabled eq 1 or z_offset_can_save eq 0" flag="hidden"/>
          </text_small>
        </lv_obj>
        <ui_button name="btn_done" width="100%" text="Done" style_min_height="#u1_touch_target" style_radius="8" height="44" style_margin_top="0" style_margin_bottom="0">
          <event_cb trigger="clicked" callback="on_zoffset_done_clicked"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: ERROR (5) - Something went wrong -->
      <!-- ================================================================== -->
      <lv_obj name="state_error" width="100%" flex_grow="1" style_pad_all="8" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="zoffset_cal_state" flag="hidden" ref_value="5"/>
        <lv_obj name="state_error_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <lv_label text="#icon_close_circle" style_text_font="mdi_icons_48" style_text_color="#danger"/>
          <text_heading text="Calibration Failed" style_text_align="left" width="100%" long_mode="wrap"/>
          <text_muted name="error_message" width="100%" text="An error occurred during calibration." style_text_align="left" long_mode="wrap"/>
        </lv_obj>
        <lv_obj width="100%" height="44" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_margin_top="0" style_margin_bottom="0">
          <ui_button name="btn_close_error" flex_grow="1" text="Close" style_min_height="#u1_touch_target" style_radius="8" width="0" height="44" style_min_width="0">
            <event_cb trigger="clicked" callback="on_zoffset_done_clicked"/>
          </ui_button>
          <ui_button name="btn_retry" flex_grow="1" text="Retry" style_min_height="#u1_touch_target" style_radius="8" width="0" height="44" style_min_width="0">
            <event_cb trigger="clicked" callback="on_zoffset_retry_clicked"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: WARMING (6) - Bed warming before calibration -->
      <!-- ================================================================== -->
      <lv_obj name="state_warming" width="100%" flex_grow="1" style_pad_all="8" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="zoffset_cal_state" flag="hidden" ref_value="6"/>
        <!-- Abort Button -->
        <lv_obj name="state_warming_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <spinner size="lg"/>
          <text_heading width="100%" text="Warming Bed..." style_text_align="left" long_mode="wrap"/>
          <temp_display name="warming_bed_temp" size="lg" show_target="true" bind_current="bed_temp" bind_target="bed_target"/>
          <text_small width="100%" text="Waiting for bed to reach temperature for accurate calibration." style_text_align="left" style_text_color="#text_muted" long_mode="wrap"/>
        </lv_obj>
        <ui_button name="btn_abort_warming" width="100%" text="Abort" variant="danger" style_min_height="#u1_touch_target" style_radius="8" height="44" style_margin_top="0" style_margin_bottom="0">
          <event_cb trigger="clicked" callback="on_zoffset_abort_clicked"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
