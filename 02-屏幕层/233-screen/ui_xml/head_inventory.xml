<?xml version='1.0' encoding='UTF-8'?>
<component>
  <consts>
    <px name="inventory_compact_card_h" value="102" />
    <px name="inventory_spool_w" value="40" />
    <px name="inventory_max_width" value="680" />
    <px name="inventory_selected_border" value="2" />
  </consts>
  <styles>
    <style name="tab_idle" bg_color="#elevated_bg" bg_opa="0" border_width="0" />
    <style name="tab_selected" bg_color="#card_bg" bg_opa="255" border_width="0" />
    <style name="card_idle" bg_color="#card_bg" bg_opa="255" border_color="#border" border_width="#inventory_selected_border" />
    <style name="card_viewed" bg_color="#card_bg" bg_opa="255" border_color="#primary" border_width="#inventory_selected_border" />
    <style name="card_loaded_light" bg_color="#u1_selection_light" bg_opa="255" border_color="#primary" border_width="#inventory_selected_border" />
    <style name="card_loaded_dark" bg_color="#u1_selection_dark" bg_opa="255" border_color="#primary" border_width="#inventory_selected_border" />
  </styles>
  <view name="head_inventory" extends="lv_obj" width="100%" height="#u1_overlay_height" align="top_left" flex_flow="column" style_flex_cross_place="center" style_pad_all="0" style_pad_gap="0" style_border_width="0" style_bg_color="#screen_bg" style_bg_opa="255" scrollable="false">
    <lv_obj name="overlay_header" width="100%" style_max_width="#inventory_max_width" height="#u1_header_height" flex_flow="row" style_pad_hor="#u1_page_pad" style_pad_ver="0" style_pad_gap="#u1_nav_icon_gap" style_flex_cross_place="center" scrollable="false">
      <text_heading text="耗材" width="0" flex_grow="1" style_text_font="#u1_heading_font" style_text_color="#text" />
      <text_small bind_text="inventory_group_0" style_text_color="#text_muted">
        <bind_flag_if cond="inventory_selected_group ne 0" flag="hidden" />
      </text_small>
      <text_small bind_text="inventory_group_1" style_text_color="#text_muted">
        <bind_flag_if cond="inventory_selected_group ne 1" flag="hidden" />
      </text_small>
      <text_small bind_text="inventory_group_2" style_text_color="#text_muted">
        <bind_flag_if cond="inventory_selected_group ne 2" flag="hidden" />
      </text_small>
      <text_small bind_text="inventory_group_3" style_text_color="#text_muted">
        <bind_flag_if cond="inventory_selected_group ne 3" flag="hidden" />
      </text_small>
    </lv_obj>
    <path_calibration_banner />
    <lv_obj name="overlay_content" width="100%" style_max_width="#inventory_max_width" height="0" flex_grow="1" flex_flow="column" style_pad_hor="#u1_page_pad" style_pad_ver="#u1_compact_gap" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver">
      <lv_obj name="inventory_browser" width="100%" height="#u1_touch_target" flex_flow="row" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false">
        <lv_obj name="inventory_modes" width="176" height="100%" flex_flow="row" style_pad_all="0" style_pad_gap="0" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#u1_card_radius" scrollable="false">
          <bind_flag_if cond="inventory_external" flag="hidden" />
          <ui_button name="inventory_view_ace" text="ACE" variant="ghost" width="88" height="100%" style_pad_hor="0" style_text_font="#u1_body_font">
            <bind_flag_if cond="inventory_external" flag="hidden" />
            <bind_style_if name="tab_selected" cond="inventory_view eq 0" />
            <event_cb trigger="clicked" callback="inventory_view_select" user_data="0" />
          </ui_button>
          <ui_button name="inventory_view_head" text="喷头" variant="ghost" width="88" height="100%" style_pad_hor="0" style_text_font="#u1_body_font">
            <bind_flag_if cond="inventory_external" flag="hidden" />
            <bind_style_if name="tab_selected" cond="inventory_view eq 1" />
            <event_cb trigger="clicked" callback="inventory_view_select" user_data="1" />
          </ui_button>
        </lv_obj>
        <lv_obj name="inventory_heads" width="0" height="100%" flex_flow="row" style_pad_all="0" style_pad_gap="0" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#u1_card_radius" scrollable="false" flex_grow="1">
          <repeat count="4">
            <lv_obj name="inventory_head_${i}" width="0" flex_grow="1" height="100%" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="0" style_radius="#u1_nav_radius" clickable="true" scrollable="false">
              <bind_flag_if cond="inventory_group_count le ${i}" flag="hidden" />
              <bind_style_if name="tab_idle" cond="inventory_selected_group ne ${i}" />
              <bind_style_if name="tab_selected" cond="inventory_selected_group eq ${i}" />
              <style name="styles.press_wash" selector="pressed" />
              <text_body long_mode="dots" clickable="false" event_bubble="true" style_text_font="#u1_body_font" text="${i + 1}" />
              <event_cb trigger="clicked" callback="inventory_select_head" user_data="${i}" />
            </lv_obj>
          </repeat>
        </lv_obj>
      </lv_obj>
      <lv_obj name="inventory_external_card" width="100%" height="#inventory_compact_card_h" flex_flow="row" style_pad_all="#u1_page_pad" style_pad_gap="#u1_page_pad" style_flex_cross_place="center" style_radius="#u1_card_radius" scrollable="false">
        <bind_flag_if cond="not inventory_external" flag="hidden" />
        <bind_style_if name="card_loaded_light" cond="settings_dark_mode eq 0" />
        <bind_style_if name="card_loaded_dark" cond="settings_dark_mode eq 1" />
        <icon src="filament" size="lg" width="#inventory_spool_w" variant="text">
          <bind_style_prop prop="text_color" subject="inventory_external_color" />
        </icon>
        <lv_obj width="0" flex_grow="1" height="content" flex_flow="column" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false">
          <text_heading name="inventory_external_material" width="100%" bind_text="inventory_external_material" long_mode="dots" />
          <text_small width="100%" bind_text="inventory_external_name" style_text_color="#text_muted" long_mode="dots" />
        </lv_obj>
        <icon src="check" size="sm" variant="text">
          <bind_flag_if cond="not inventory_external_loaded" flag="hidden" />
        </icon>
      </lv_obj>
      <lv_obj name="inventory_cards" width="100%" height="content" flex_flow="row_wrap" style_flex_main_place="center" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false">
        <bind_flag_if cond="inventory_external" flag="hidden" />
        <repeat count="inventory_card_count">
          <lv_obj name="inventory_card_${i}" width="23%" height="#inventory_compact_card_h" flex_flow="column" style_pad_all="#u1_compact_gap" style_pad_gap="0" style_flex_main_place="space_between" style_radius="#u1_card_radius" clickable="true" scrollable="false">
            <bind_flag_if cond="inventory_card_count le ${i}" flag="hidden" />
            <bind_style_if name="card_idle" cond="inventory_selected_card ne ${i} and not inventory_unit_${i}_current" />
            <bind_style_if name="card_viewed" cond="inventory_selected_card eq ${i} and not inventory_unit_${i}_current" />
            <bind_style_if name="card_loaded_light" cond="inventory_unit_${i}_current and settings_dark_mode eq 0" />
            <bind_style_if name="card_loaded_dark" cond="inventory_unit_${i}_current and settings_dark_mode eq 1" />
            <style name="styles.press_wash" selector="pressed" />
            <lv_obj width="100%" height="44" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xs" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
              <text_small name="inventory_unit_name_${i}" width="0" flex_grow="1" bind_text="inventory_unit_${i}_name" long_mode="wrap" clickable="false" event_bubble="true" />
            </lv_obj>
            <text_body name="inventory_material_${i}" width="100%" bind_text="inventory_unit_${i}_material" long_mode="dots" clickable="false" event_bubble="true" style_text_align="center" style_text_font="#u1_body_font" />
            <event_cb trigger="clicked" callback="inventory_select_unit" user_data="${i}" />
            <lv_obj width="100%" height="#u1_text_line" flex_flow="row" style_pad_all="0" style_pad_gap="#u1_compact_gap" style_flex_cross_place="center" scrollable="false" clickable="false" event_bubble="true">
              <text_small name="inventory_weight_${i}" width="0" flex_grow="1" bind_text="inventory_unit_${i}_weight" long_mode="dots" style_text_color="#text_muted" clickable="false" event_bubble="true" />
              <lv_obj width="16" height="#u1_text_line" flex_flow="row" style_pad_all="0" style_flex_main_place="center" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false">
                <icon name="inventory_current_${i}" src="check" size="xs" clickable="false" event_bubble="true">
                  <bind_flag_if cond="not inventory_unit_${i}_current" flag="hidden" />
                </icon>
                <lv_obj name="inventory_color_${i}" width="#u1_status_dot" height="#u1_status_dot" style_bg_opa="255" style_radius="#u1_status_dot" style_pad_all="0" style_border_width="0" clickable="false" event_bubble="true" scrollable="false">
                  <bind_flag_if cond="inventory_unit_${i}_current" flag="hidden" />
                  <bind_style_prop prop="bg_color" subject="inventory_unit_${i}_color" />
                </lv_obj>
              </lv_obj>
            </lv_obj>
          </lv_obj>
        </repeat>
      </lv_obj>
      <lv_obj name="inventory_external_actions" width="100%" height="#u1_touch_target" flex_flow="row" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false">
        <bind_flag_if cond="not inventory_external" flag="hidden" />
        <ui_button name="inventory_edit" text="编辑耗材" icon="pencil" variant="outline" width="0" flex_grow="1" height="100%" style_bg_color="#elevated_bg" style_border_width="0" style_shadow_width="0" style_text_font="#u1_body_font">
          <bind_state_if cond="not inventory_can_manage" state="disabled" />
          <event_cb trigger="clicked" callback="inventory_action" user_data="edit" />
        </ui_button>
        <ui_button name="inventory_manual" text="进退料" icon="swap_vertical" variant="primary" style_text_color="#FFFFFF" width="0" flex_grow="1" height="100%" style_border_width="0" style_shadow_width="0" style_text_font="#u1_body_font">
          <bind_state_if cond="not inventory_can_manage" state="disabled" />
          <event_cb trigger="clicked" callback="inventory_action" user_data="manual" />
        </ui_button>
      </lv_obj>
      <text_small name="inventory_notice" width="100%" bind_text="inventory_notice" style_text_color="#text_muted" long_mode="wrap">
        <bind_flag_if cond="not inventory_external and inventory_online and not inventory_hold" flag="hidden" />
      </text_small>
      <text_small name="inventory_source" width="100%" bind_text="inventory_source" style_text_color="#text_muted" long_mode="wrap">
        <bind_flag_if cond="inventory_external or not inventory_online or inventory_hold" flag="hidden" />
      </text_small>
      <lv_obj name="inventory_ace_actions" width="100%" height="#u1_touch_target" flex_flow="row" style_pad_all="0" style_pad_gap="#u1_card_gap" scrollable="false">
        <bind_flag_if cond="inventory_external" flag="hidden" />
        <ui_button name="inventory_details" text="详情" variant="outline" width="0" flex_grow="1" height="100%" style_bg_color="#elevated_bg" style_border_width="0" style_shadow_width="0" style_text_font="#u1_body_font">
          <bind_state_if cond="not inventory_can_manage" state="disabled" />
          <event_cb trigger="clicked" callback="inventory_manage" />
        </ui_button>
        <ui_button name="inventory_load" bind_text="inventory_load_label" variant="primary" style_text_color="#FFFFFF" width="0" flex_grow="1" height="100%" style_border_width="0" style_shadow_width="0" style_pad_hor="#space_sm" style_text_font="#u1_body_font">
          <bind_state_if cond="not inventory_can_load" state="disabled" />
          <event_cb trigger="clicked" callback="inventory_action" user_data="load" />
        </ui_button>
      </lv_obj>
      <lv_obj name="inventory_more" width="100%" height="46" flex_flow="row" style_pad_all="0" style_pad_gap="#u1_card_gap" style_border_width="1" style_border_side="top" style_border_color="#border" scrollable="false">
        <bind_flag_if cond="inventory_external" flag="hidden" />
        <ui_button name="inventory_library" text="耗材库" variant="ghost" height="#u1_touch_target" style_pad_hor="0" style_text_font="#u1_body_font" width="0" flex_grow="1" style_bg_opa="0">
          <bind_flag_if cond="inventory_external" flag="hidden" />
          <bind_state_if cond="not inventory_online" state="disabled" />
          <event_cb trigger="clicked" callback="inventory_library" />
        </ui_button>
        <ui_button name="inventory_read_tag" text="识别" variant="ghost" width="0" flex_grow="1" height="#u1_touch_target" style_bg_color="#elevated_bg" style_border_width="0" style_shadow_width="0" style_text_font="#u1_body_font" style_bg_opa="0">
          <bind_state_if cond="not inventory_can_read" state="disabled" />
          <event_cb trigger="clicked" callback="inventory_action" user_data="read_tag" />
        </ui_button>
        <ui_button name="inventory_calibrate" text="校准" variant="ghost" width="0" flex_grow="1" height="#u1_touch_target" style_bg_color="#elevated_bg" style_border_width="0" style_shadow_width="0" style_text_font="#u1_body_font" style_bg_opa="0">
          <bind_state_if cond="not inventory_can_manage" state="disabled" />
          <event_cb trigger="clicked" callback="inventory_calibrate" />
        </ui_button>
      </lv_obj>
    </lv_obj>
  </view>
</component>
