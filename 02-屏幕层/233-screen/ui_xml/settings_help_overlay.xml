<!-- U1 local help and display component attribution -->
<component>
  <view name="settings_help_overlay" extends="overlay_panel" title="233 screen · 帮助" bg_color="#screen_bg" title_transform="none" title_color="#text">
    <!-- On-device quick reference -->
    <lv_obj name="overlay_content" width="100%" height="0" flex_grow="1" flex_flow="column" scrollable="true" scroll_dir="ver" scrollbar_mode="auto" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap">
      <lv_obj name="u1_local_guide" width="100%" height="content" flex_flow="column" style_pad_all="#u1_card_pad_roomy" style_pad_gap="#u1_card_gap" scrollable="false">
        <style name="styles.u1_card"/>
        <text_body text="233 screen 使用说明" width="100%" style_text_font="#font_body_bold"/>
        <text_small text="耗材：选择 ACE 和槽位，查看在用来源。" width="100%" long_mode="wrap"/>
        <text_small text="进退料：按当前槽位页面的提示操作。" width="100%" long_mode="wrap"/>
        <text_small text="校准：从设置的「校准与诊断」进入。" width="100%" long_mode="wrap"/>
      </lv_obj>
      <setting_group style_margin_left="0" style_margin_right="0" style_margin_bottom="0">
        <style name="styles.u1_card"/>
        <setting_action_row name="row_about" label="版本与许可" icon="info_outline" callback="on_about_clicked"/>
      </setting_group>
    </lv_obj>
  </view>
</component>
