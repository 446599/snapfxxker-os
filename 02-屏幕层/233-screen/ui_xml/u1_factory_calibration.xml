<?xml version="1.0" encoding="UTF-8"?>
<component>
  <view name="u1_factory_calibration" extends="overlay_panel" title="原厂校准" bg_color="#screen_bg" title_transform="none" title_color="#text">
    <lv_obj name="factory_scroll" width="100%" height="0" flex_grow="1" scrollable="true" flex_flow="column" scrollbar_mode="auto" style_pad_all="#u1_page_pad" style_pad_gap="#u1_card_gap" scroll_dir="ver">
      <lv_obj width="100%" height="content" flex_flow="column" scrollable="false">
        <style name="styles.u1_card"/>
        <text_heading name="factory_heading" text="" width="100%" long_mode="wrap"/>
        <text_body name="factory_status" text="" width="100%" long_mode="wrap"/>
        <text_body name="factory_instruction" text="" width="100%" long_mode="wrap"/>
        <lv_image name="factory_illustration" hidden="true"/>
        <text_body name="factory_feedback" text="" width="100%" long_mode="wrap"/>
      </lv_obj>
      <setting_action_row name="factory_enter" label="进入校准" icon="chevron_right" callback="u1_factory_enter"/>
      <setting_action_row name="factory_motors" label="释放电机，开始张紧同步带" icon="chevron_right" callback="u1_factory_motors"/>
      <setting_action_row name="factory_next" label="下一步" icon="chevron_right" callback="u1_factory_next"/>
      <setting_action_row name="factory_home" label="测量回零原点" icon="chevron_right" callback="u1_factory_home"/>
      <setting_action_row name="factory_tool" label="选择下一个打印头" icon="chevron_right" callback="u1_factory_tool"/>
      <setting_action_row name="factory_move" label="移动至所选停靠位" icon="chevron_right" callback="u1_factory_move"/>
      <setting_action_row name="factory_left" label="向左微调 0.1 mm" icon="chevron_right" callback="u1_factory_left"/>
      <setting_action_row name="factory_right" label="向右微调 0.1 mm" icon="chevron_right" callback="u1_factory_right"/>
      <setting_action_row name="factory_capture" label="记录当前位置" icon="chevron_right" callback="u1_factory_capture"/>
      <setting_action_row name="factory_verify" label="验证候选取放坐标" icon="chevron_right" callback="u1_factory_verify"/>
      <setting_action_row name="factory_save" label="保存已验证坐标" icon="chevron_right" callback="u1_factory_save"/>
      <setting_action_row name="factory_noise" label="开始电机降噪校准" icon="chevron_right" callback="u1_factory_noise"/>
      <setting_action_row name="factory_exit" label="结束并退出校准" icon="chevron_right" callback="u1_factory_exit"/>
      <setting_action_row name="factory_refresh" label="刷新设备状态" icon="chevron_right" callback="u1_factory_refresh"/>
    </lv_obj>
  </view>
</component>