<component>
  <styles>
    <style name="heaters_rows" layout="flex" flex_flow="column" min_height="90"/>
    <style name="heaters_columns" layout="flex" flex_flow="row" min_height="#u1_touch_target"/>
    <style name="heater_row" width="100%" height="0" min_height="#u1_touch_target"
           layout="flex" flex_flow="row" flex_main_place="space_between" flex_cross_place="center"/>
    <style name="heater_column" width="0" height="100%" layout="flex" flex_flow="column"
           flex_main_place="center"/>
  </styles>
  <view extends="ui_card" style_pad_hor="#u1_card_pad" style_pad_ver="#u1_compact_gap"
        style_radius="#u1_card_radius" style_border_width="0" flex_flow="column"
        style_pad_gap="#space_xxs" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
    <lv_obj name="ps_temperatures" width="100%" height="0" flex_grow="1" style_pad_all="0"
            style_pad_gap="#space_xxs" style_bg_opa="0" style_border_width="0" scrollable="false">
      <bind_style_if name="heaters_rows" cond="not ui_is_portrait and ui_breakpoint eq 1"/>
      <bind_style_if name="heaters_columns" cond="ui_is_portrait or ui_breakpoint ne 1"/>

      <lv_obj name="ps_chip_nozzle" flex_grow="1" style_pad_all="0" style_pad_gap="#space_xxs"
              style_bg_opa="0" style_border_width="0" style_radius="#u1_card_radius"
              clickable="true" scrollable="false">
        <style name="styles.press_wash" selector="pressed"/>
        <bind_style_if name="heater_row" cond="not ui_is_portrait and ui_breakpoint eq 1"/>
        <bind_style_if name="heater_column" cond="ui_is_portrait or ui_breakpoint ne 1"/>
        <text_small text="Nozzle" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
        <temp_display name="ps_nozzle_value" size="md" show_target="false" bind_current="extruder_temp"/>
        <nozzle_icon size="xs" hidden="true"/>
        <event_cb trigger="clicked" callback="on_temp_card_clicked"/>
      </lv_obj>

      <lv_obj name="ps_chip_bed" flex_grow="1" style_pad_all="0" style_pad_gap="#space_xxs"
              style_bg_opa="0" style_border_width="0" style_radius="#u1_card_radius"
              clickable="true" scrollable="false">
        <style name="styles.press_wash" selector="pressed"/>
        <bind_style_if name="heater_row" cond="not ui_is_portrait and ui_breakpoint eq 1"/>
        <bind_style_if name="heater_column" cond="ui_is_portrait or ui_breakpoint ne 1"/>
        <text_small text="Bed" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
        <temp_display name="ps_bed_value" size="md" show_target="false" bind_current="bed_temp"/>
        <heater_icon src="radiator" glyph_name="bed_icon_glyph" size="xs" hidden="true"/>
        <event_cb trigger="clicked" callback="on_print_status_bed_temp_clicked"/>
      </lv_obj>
    </lv_obj>

    <lv_obj name="ps_motion_readings" width="100%" height="0" flex_grow="1" style_min_height="#u1_touch_target"
            flex_flow="row" style_pad_all="0" style_pad_gap="#u1_card_gap" style_bg_opa="0"
            style_border_width="1" style_border_side="top" style_border_color="#border"
            scrollable="false">
      <lv_obj name="ps_fan_reading" width="0" flex_grow="1" height="100%" flex_flow="column"
              style_flex_main_place="center" style_pad_all="0" style_pad_gap="#space_xxs"
              style_bg_opa="0" style_border_width="0" style_radius="#u1_card_radius"
              clickable="true" scrollable="false">
        <style name="styles.press_wash" selector="pressed"/>
        <text_small text="Fan" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
        <text_body bind_text="fan_speed" bind_text-fmt="%d%%" clickable="false" event_bubble="true"/>
        <event_cb trigger="clicked" callback="on_print_status_fans_clicked"/>
      </lv_obj>

      <lv_obj name="ps_speed_reading" width="0" flex_grow="1" height="100%" flex_flow="column"
              style_flex_main_place="center" style_pad_all="0" style_pad_gap="#space_xxs"
              style_bg_opa="0" style_border_width="0" style_radius="#u1_card_radius"
              clickable="true" scrollable="false">
        <style name="styles.press_wash" selector="pressed"/>
        <text_small text="Speed" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
        <text_body bind_text="speed_factor" bind_text-fmt="%d%%" clickable="false" event_bubble="true"/>
        <event_cb trigger="clicked" callback="on_print_status_tune"/>
      </lv_obj>
    </lv_obj>
    <lv_obj name="ps_environment" width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_xxs" style_border_width="1" style_border_side="top" style_border_color="#border" style_flex_cross_place="center" style_flex_main_place="end" scrollable="false">
      <bind_flag_if cond="not printer_has_chamber and (not led_controllable or ui_is_portrait)" flag="hidden"/>
      <lv_obj name="ps_chip_chamber" width="0" flex_grow="1" height="content" flex_flow="row" style_pad_hor="0" style_pad_ver="0" style_pad_gap="#space_xxs" style_flex_cross_place="center" scrollable="false">
        <bind_flag_if_eq subject="printer_has_chamber" flag="hidden" ref_value="0"/>
        <heater_icon src="fridge_industrial" glyph_name="chamber_icon_glyph" size="xs">
          <bind_flag_if cond="not ui_is_portrait and ui_breakpoint le 1" flag="hidden"/>
        </heater_icon>
        <text_small text="仓温"/>
        <temp_display size="sm" show_target="false" bind_current="chamber_temp"/>
      </lv_obj>
      <ui_button name="btn_status_light" width="content" height="#u1_touch_target" style_min_width="82" style_pad_hor="#u1_compact_gap"
                 bind_icon="light_button_icon" text="Case light" icon_size="xs" variant="ghost">
        <bind_flag_if cond="not led_controllable or ui_is_portrait" flag="hidden"/>
        <event_cb trigger="clicked" callback="on_print_status_light"/>
      </ui_button>
    </lv_obj>
    <!-- Filament: the runout glyph without an AMS, the active lane with one,
         and tool changes done of expected. -->
    <lv_obj name="filament_ams_status_row" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
      <!-- Stands down whenever ams_status_row shows, which carries the same
           glyph beside its lane; an AMS printer between lanes (no active
           tool) shows it here instead. -->
      <lv_obj name="filament_status_row" width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm">
        <bind_flag_if cond="filament_sensor_count eq 0 or (ams_slot_count gt 0 and ams_current_tool ge 0)" flag="hidden"/>
        <filament_sensor_indicator subject="filament_runout_scoped"/>
      </lv_obj>
      <lv_obj name="ams_status_row" height="content" flex_grow="1" style_min_width="0" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm">
        <bind_flag_if_eq subject="ams_slot_count" flag="hidden" ref_value="0"/>
        <ams_current_tool name="ams_current_tool_indicator" runout_subject="filament_runout_scoped"/>
      </lv_obj>
      <lv_obj name="toolchange_status" width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs">
        <bind_flag_if_eq subject="toolchange_visible" flag="hidden" ref_value="0"/>
        <icon src="swap_vertical" size="xs" variant="muted"/>
        <text_small name="toolchange_label" bind_text="toolchange_text" style_text_color="#text_muted"/>
      </lv_obj>
      <bind_flag_if cond="ui_breakpoint le 1 or (filament_sensor_count eq 0 and ams_slot_count eq 0 and toolchange_visible eq 0)" flag="hidden"/>
    </lv_obj>
    <!-- Up next: the first queued job, up while the queue is not empty. Tap
         starts it when the printer is free, otherwise opens the job queue. -->
    <lv_obj name="up_next_row" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false" clickable="true" style_radius="#border_radius">
      <style name="styles.press_wash" selector="pressed"/>
      <bind_flag_if cond="job_queue_count eq 0 or ui_breakpoint le 1" flag="hidden"/>
      <!-- A micro landscape strip gives its height to the tiles; the queue
           stays reachable from the job queue. -->
      <event_cb trigger="clicked" callback="on_up_next_tap"/>
      <icon src="progress_clock" size="xs" variant="muted" clickable="false" event_bubble="true"/>
      <text_small name="up_next_label" flex_grow="1" bind_text="job_queue_up_next_text" style_text_color="#text_muted" long_mode="dots" clickable="false" event_bubble="true"/>
    </lv_obj>
    <chamber_fault_banner name="chamber_fault_banner"/>
  </view>
</component>
