<!--
  Print Status preview card - the art band and everything that stacks over it.

  ONE definition for both orientations; the host passes the sizing at the
  instance site and nothing else.

  Layout: flex column with preview_art (flex_grow) above and metadata_clip
  (content-sized) below. The split is COMPUTED, not reserved - the strip has two
  stable heights (it gains a text_small line + space_xs when Klipper publishes an
  M117), so no constant is correct. pad_gap=0 keeps the strip flush against the
  art; ui_card's create handler defaults pad_gap to space_md. Every other child
  is absolutely aligned over the card and carries ignore_layout="true" so the
  column does not reflow it. Progress and pre-print state live in the footer and checklist.
-->
<component>
  <styles>
    <style name="lcd_summary" pad_all="#u1_card_pad" pad_bottom="0" flex_main_place="center"/>
    <style name="terminal_summary" pad_all="#space_lg" pad_bottom="#metadata_clip_height"/>
    <style name="preview_regular" radius="#u1_card_radius"/>
    <style name="preview_lcd" radius="0"/>
    <style name="paused_summary_short" pad_all="#u1_compact_gap" flex_main_place="start"/>
    <style name="paused_summary_roomy" pad_all="#space_lg" pad_bottom="#metadata_clip_height" flex_main_place="center"/>
  </styles>
  <view name="thumbnail_section" extends="ui_card" style_pad_all="0" style_border_width="0" style_clip_corner="true" flex_flow="column" style_pad_gap="0">
    <bind_style_if name="preview_regular" cond="not print_status_lcd_layout"/>
    <bind_style_if name="preview_lcd" cond="print_status_lcd_layout"/>

    <!-- The art band: whatever the column leaves above the strip. It holds
         the preview and, over it in exactly the same box, the live camera. -->
    <lv_obj name="preview_art" width="100%" flex_grow="1" style_pad_all="0" style_bg_opa="255" style_border_width="0" style_radius="0" clickable="false" scrollable="false">
      <bind_style_if_eq name="styles.print_preview_light" subject="settings_dark_mode" ref_value="0"/>
      <bind_style_if_eq name="styles.print_preview_dark" subject="settings_dark_mode" ref_value="1"/>
      <preview_stack name="preview_clear_area" width="100%" height="100%" gradient_name="gradient_background" viewer_name="print_gcode_viewer" thumbnail_name="print_thumbnail" hint_name="rotate_hint" gradient_hidden="1 eq 1" viewer_hidden="gcode_viewer_mode eq 0" thumbnail_hidden="gcode_viewer_mode gt 0 or exclude_map_active eq 1 or print_has_thumbnail eq 0" hint_hidden="gcode_viewer_mode ne 1"/>
      <icon src="cube_outline" size="lg" variant="muted" align="center" clickable="false">
        <bind_flag_if cond="gcode_viewer_mode gt 0 or print_has_thumbnail eq 1 or exclude_map_active eq 1 or print_status_camera_showing eq 1 or show_complete_overlay or show_cancelled_overlay or show_error_overlay or show_paused_overlay or preparing_visible" flag="hidden"/>
      </icon>
      <!-- Live camera in place of the preview, cover-fit and clipped to the
           band. It takes taps so they do nothing rather than reach the paused
           viewer underneath. -->
      <lv_obj name="preview_camera" width="100%" height="100%" align="center" style_pad_all="0" style_bg_color="#card_bg" style_bg_opa="255" style_border_width="0" style_radius="0" style_clip_corner="true" clickable="true" scrollable="false" hidden="true">
        <bind_flag_if_eq subject="print_status_camera_showing" flag="hidden" ref_value="0"/>
        <lv_image name="preview_camera_image" width="100%" height="100%" align="center" inner_align="cover" clickable="false" event_bubble="true"/>
        <lv_obj name="preview_camera_connecting" width="content" height="content" align="center" style_bg_opa="0" style_border_width="0" style_pad_all="#space_md" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_pad_gap="#space_sm" clickable="false" event_bubble="true" scrollable="false">
          <bind_flag_if_not_eq subject="print_status_camera_has_frame" flag="hidden" ref_value="0"/>
          <spinner size="md"/>
          <text_small text="Connecting Camera..." style_text_align="center"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>

    <!-- Preview mode controls leave the art available for rotation. -->
    <print_status_preview_controls name="preview_corner_buttons"/>

    <!-- PRINT COMPLETE OVERLAY: Shown when print finishes successfully -->
    <!-- Single derived subject show_complete_overlay = (outcome==COMPLETE && !dismissed). -->
    <!-- Two independent bind_flag observers on hidden raced at startup (L042). -->
    <lv_obj name="print_complete_overlay" width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="false" clickable="true" hidden="true">
      <bind_style_if name="terminal_summary" cond="not print_status_lcd_layout"/>
      <bind_style_if name="lcd_summary" cond="print_status_lcd_layout"/>
      <bind_flag_if_eq subject="show_complete_overlay" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="on_print_status_dismiss_overlay"/>
      <!-- Green success badge with checkmark (animated on appearance) -->
      <!-- Uses ui_button for auto-contrast text via update_button_text_contrast() -->
      <ui_button name="success_badge" width="content" height="content" variant="success" icon="check_circle" text="Print Complete!" clickable="false" focusable="false" style_radius="#space_lg" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm"/>
    </lv_obj>

    <!-- PRINT CANCELLED OVERLAY: shown via show_cancelled_overlay (see COMPLETE above). -->
    <lv_obj name="print_cancelled_overlay" width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="false" clickable="true" hidden="true">
      <bind_style_if name="terminal_summary" cond="not print_status_lcd_layout"/>
      <bind_style_if name="lcd_summary" cond="print_status_lcd_layout"/>
      <bind_flag_if_eq subject="show_cancelled_overlay" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="on_print_status_dismiss_overlay"/>
      <!-- Orange warning badge with cancel icon (animated on appearance) -->
      <!-- Uses ui_button for auto-contrast text via update_button_text_contrast() -->
      <ui_button name="cancel_badge" width="content" height="content" variant="warning" icon="cancel" text="Print Canceled" clickable="false" focusable="false" style_radius="#space_lg" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm"/>
      <!-- Why it ended, hidden when nothing says; wraps under the badge -->
      <text_small name="cancel_reason_label" width="100%" bind_text="print_stop_reason" long_mode="wrap" style_text_align="center" style_bg_color="#card_bg" style_bg_opa="180" style_radius="#space_sm" style_pad_all="#space_xs">
        <bind_flag_if_eq subject="print_stop_reason_visible" flag="hidden" ref_value="0"/>
      </text_small>
    </lv_obj>

    <!-- PRINT ERROR OVERLAY: shown via show_error_overlay (see COMPLETE above). -->
    <lv_obj name="print_error_overlay" width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="false" clickable="true" hidden="true">
      <bind_style_if name="terminal_summary" cond="not print_status_lcd_layout"/>
      <bind_style_if name="lcd_summary" cond="print_status_lcd_layout"/>
      <bind_flag_if_eq subject="show_error_overlay" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="on_print_status_dismiss_overlay"/>
      <!-- Red danger badge with alert icon (animated on appearance) -->
      <!-- Uses ui_button for auto-contrast text via update_button_text_contrast() -->
      <ui_button name="error_badge" width="content" height="content" variant="danger" icon="alert_circle" text="Print Failed" clickable="false" focusable="false" style_radius="#space_lg" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm"/>
      <!-- Why it ended, hidden when nothing says; wraps under the badge -->
      <text_small name="error_reason_label" width="100%" bind_text="print_stop_reason" long_mode="wrap" style_text_align="center" style_bg_color="#card_bg" style_bg_opa="180" style_radius="#space_sm" style_pad_all="#space_xs">
        <bind_flag_if_eq subject="print_stop_reason_visible" flag="hidden" ref_value="0"/>
      </text_small>
    </lv_obj>

    <!-- Metadata strip - the second (content-sized) child of thumbnail_section's
         flex column, sitting flush under preview_art. Grows when the
         optional M117 (display_message) row becomes visible; the column hands
         the difference straight back to the preview above. -->
    <lv_obj name="metadata_clip" width="100%" height="content" style_radius="0" style_pad_all="0" scrollable="false">
      <bind_flag_if cond="print_status_lcd_layout" flag="hidden"/>
      <!-- Keep the named occluder for C++, but do not instantiate duplicate
           layer/object actions when the LCD overview owns those controls. -->
      <if cond="not print_status_lcd_layout">
        <!-- Inner overlay with semi-transparent background and rounded corners -->
        <lv_obj name="metadata_overlay" width="100%" height="content" align="bottom_mid" style_pad_ver="#u1_compact_gap" flex_flow="row" style_flex_cross_place="center" scrollable="false">
          <!-- Translucency, radius, side padding and row gap come from the shared
               style so this strip and the file detail view's cannot drift apart. -->
          <style name="styles.metadata_strip"/>
          <lv_obj name="metadata_text" width="0" height="content" flex_grow="1"
                  flex_flow="column" style_pad_all="0" style_pad_gap="#space_xxs" style_bg_opa="0"
                  style_border_width="0" scrollable="false">
            <!-- Layer / objects / filament as icon clusters, not prose. The prose
                 row ("Layer 474 / 1334 (55.4mm)" + "12 of 12 objects" + "92.6m
                 used") measured 393px in the 363px strip an 800x480 panel
                 produces, and its width changes with every translation of
                 Layer/of/objects/used; icons carry the words and the bound
                 strings are bare numbers, so the row is language-neutral and
                 fits every tier. The layer cluster grows and dots as the floor:
                 a pathological count degrades instead of overlapping
                 (space_between derives its gap as (row - content) / (n-1) with
                 no floor at zero - lv_flex.c place_content). -->
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
              <!-- On printers with the layer-pause macros, a tap during a print
                   opens the Pause at Layer modal (layer_pause_modal.xml): a muted
                   pause glyph marks it as tappable, and turns into the pending
                   layer number while a pause is scheduled. -->
              <lv_obj name="layer_cluster" height="content" flex_grow="1" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false" clickable="false" style_radius="#border_radius">
                <style name="styles.press_wash" selector="pressed"/>
                <bind_flag_if cond="printer_has_layer_pause and layer_pause_availability gt 0" flag="clickable"/>
                <event_cb trigger="clicked" callback="on_layer_pause_open"/>
                <icon name="layer_icon" src="layers" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
                <text_small name="layer_progress_label" text="0 / 0" bind_text="print_layer_text" style_text_align="left" flex_grow="1" long_mode="dots" event_bubble="true"/>
                <icon name="layer_pause_hint" src="pause" size="xs" variant="muted" clickable="false" event_bubble="true" hidden="true">
                  <bind_flag_if cond="printer_has_layer_pause and layer_pause_availability gt 0 and layer_pause_layer eq 0" flag="hidden" invert="true"/>
                </icon>
                <lv_obj name="layer_pause_chip" width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xxs" scrollable="false" clickable="false" event_bubble="true" hidden="true">
                  <bind_flag_if cond="printer_has_layer_pause and layer_pause_layer gt 0" flag="hidden" invert="true"/>
                  <icon src="pause" size="xs" variant="warning" clickable="false" event_bubble="true"/>
                  <text_small name="layer_pause_chip_label" bind_text="layer_pause_layer" style_text_color="#warning" event_bubble="true"/>
                </lv_obj>
              </lv_obj>
              <lv_obj name="objects_cluster" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false">
                <bind_flag_if_eq subject="exclude_objects_available" flag="hidden" ref_value="0"/>
                <icon name="objects_icon" src="cube_outline" size="xs" variant="secondary" clickable="false"/>
                <text_small name="objects_count_label" text="" bind_text="print_objects_text"/>
              <bind_flag_if cond="ui_breakpoint le 1" flag="hidden"/></lv_obj>
              <lv_obj name="filament_cluster" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_xs" scrollable="false">
                <icon name="filament_icon" src="filament" size="xs" variant="secondary" clickable="false"/>
                <text_small name="filament_used_label" text="" bind_text="print_filament_used_text"/>
              <bind_flag_if cond="ui_breakpoint le 1" flag="hidden"/></lv_obj>
            </lv_obj>
            <!-- Klipper display_status.message (M117) — collapses to zero height -->
            <!-- when empty. -->
            <text_small name="display_message" width="100%" bind_text="display_message" style_text_align="left" long_mode="scroll_circular" style_text_color="#text_muted" hidden="true">
              <bind_flag_if_eq subject="display_message_visible" flag="hidden" ref_value="0"/>
            </text_small>
          </lv_obj>
          <exclude_objects_button name="btn_objects" callback="on_print_status_objects"
                                  hidden_when="exclude_objects_available eq 0"/>
        </lv_obj>
        <!-- metadata_overlay -->
      </if>
    </lv_obj>
    <!-- metadata_clip -->

    <!-- PRINT PAUSED OVERLAY: shown while print is in PAUSED state. Driven by   -->
    <!-- show_paused_overlay (1 when print_state_enum==PAUSED). Unlike the three -->
    <!-- terminal overlays above, this is NOT dismissible — the badge stays up  -->
    <!-- until the print resumes or terminates, so the paused condition is      -->
    <!-- always visually obvious. Resume/Cancel controls live in the strip.    -->
    <!-- Title is static; reason is an optional second label hidden when         -->
    <!-- print_pause_reason_visible == 0 (set by recompute_paused_overlay_*).    -->
    <lv_obj name="print_paused_overlay" width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" flex_flow="column" style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#u1_compact_gap" scrollable="false" clickable="false" hidden="true">
      <bind_style_if name="paused_summary_short" cond="not print_status_lcd_layout and not ui_is_portrait and ui_breakpoint le 1"/>
      <bind_style_if name="paused_summary_roomy" cond="not print_status_lcd_layout and (ui_is_portrait or ui_breakpoint gt 1)"/>
      <bind_style_if name="lcd_summary" cond="print_status_lcd_layout"/>
      <bind_flag_if_eq subject="show_paused_overlay" flag="hidden" ref_value="0"/>
      <!-- Badge carries the title; the reason is a wrapping label under it, as on   -->
      <!-- the canceled and failed overlays, so a long firmware or filament-system  -->
      <!-- error wraps inside the card instead of widening the badge past it.       -->
      <ui_button name="paused_badge" width="content" height="content" variant="primary" icon="pause" text="Print Paused" clickable="false" focusable="false" style_radius="#space_lg" style_pad_hor="#u1_card_pad" style_pad_ver="#u1_compact_gap"/>
      <text_small name="paused_badge_reason" width="100%" bind_text="print_pause_reason" long_mode="wrap" style_text_align="center" style_bg_color="#card_bg" style_bg_opa="180" style_radius="#space_sm" style_pad_all="#space_xs">
        <bind_flag_if_eq subject="print_pause_reason_visible" flag="hidden" ref_value="0"/>
      </text_small>
    </lv_obj>

    <!-- Compact mode hides metadata_clip, so retain real M117 messages here.
         This overlay stays inside the preview, above its other overlays; it
         neither takes footer space nor covers the lower preview controls.
         Circular scrolling exposes the entire message without truncation. -->
    <lv_obj name="ps_lcd_display_message" width="100%" height="content" ignore_layout="true" align="top_mid"
            style_pad_hor="#u1_page_pad" style_pad_ver="#u1_compact_gap"
            style_bg_color="#card_bg" style_bg_opa="230" style_border_width="0" style_radius="0"
            hidden="true" clickable="false" scrollable="false">
      <bind_flag_if cond="not print_status_lcd_layout or display_message_visible eq 0" flag="hidden"/>
      <text_small name="lcd_display_message" width="100%" bind_text="display_message"
                  long_mode="scroll_circular" style_text_color="#text" clickable="false"/>
    </lv_obj>
  </view>
</component>
