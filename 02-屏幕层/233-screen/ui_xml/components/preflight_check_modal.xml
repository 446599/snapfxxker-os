<!-- NOTE: Backdrop is created programmatically by the Modal class in C++. -->
<!-- Buttons are wired programmatically in PreflightCheckModal::on_show() via -->
<!-- wire_ok_button / wire_cancel_button / wire_tertiary_button. -->
<!-- Enriched pre-flight filament check modal. Shown before a print starts when
     the cached PreflightResult reports a blocking condition (a required tool
     maps to an empty slot). Per-tool rows are populated dynamically in C++. -->
<component>
  <view name="preflight_check_modal" extends="ui_dialog" width="94%" height="94%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" style_max_height="360" style_max_width="600" style_pad_all="0" style_bg_color="#card_bg" style_bg_opa="255" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Header row with warning icon + title -->
    <modal_header icon_src="alert" icon_variant="warning" title="Check filament"/>
    <!-- Scroll tool rows, explanation and the contextual repair together. -->
    <lv_obj name="preflight_scroll_body" width="100%" height="0" flex_grow="1" flex_flow="column" style_pad_all="#u1_card_pad_roomy" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
      <lv_obj name="preflight_tool_list" width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="false">
        <!-- Rows populated dynamically in C++ -->
      </lv_obj>
      <text_body name="preflight_explanation" width="100%" long_mode="wrap" style_text_color="#text_muted" style_text_align="left"/>
      <lv_obj name="preflight_material_fix_row" width="100%" height="content" style_pad_all="0" style_border_width="0" style_bg_opa="0" scrollable="false" flex_flow="row" style_flex_main_place="center">
        <bind_flag_if_eq subject="preflight_material_fix_shown" flag="hidden" ref_value="0"/>
        <ui_button name="btn_set_material" variant="secondary" bind_text="preflight_material_fix_text" height="#u1_touch_target" style_min_height="#u1_touch_target" width="100%" style_text_font="#u1_aux_font" style_radius="#u1_card_radius">
          <event_cb trigger="clicked" callback="on_preflight_set_material"/>
        </ui_button>
      </lv_obj>
    </lv_obj>
    <!-- Keep the bypass visible without giving it the visual weight of a recovery action.
         PreflightCheckModal wires the three named controls programmatically. -->
    <lv_obj width="100%" height="content" flex_flow="row" scrollable="false">
      <style name="styles.u1_footer"/>
      <ui_button name="btn_primary" text="Print Anyway" variant="outline" width="0" flex_grow="1"
                 height="#u1_touch_target" style_text_font="#u1_aux_font" style_radius="#u1_card_radius"
                 style_pad_all="#u1_compact_gap" style_shadow_width="0" style_border_color="#border" focusable="false"/>
      <ui_button name="btn_secondary" text="Cancel" variant="secondary" width="0" flex_grow="1"
                 height="#u1_touch_target" style_text_font="#u1_aux_font" style_radius="#u1_card_radius"
                 style_pad_all="#u1_compact_gap" style_shadow_width="0" focusable="false"/>
      <ui_button name="btn_tertiary" text="Map Filament…" variant="primary" style_text_color="#FFFFFF" width="0" flex_grow="1"
                 height="#u1_touch_target" style_text_font="#u1_aux_font" style_radius="#u1_card_radius"
                 style_pad_all="#u1_compact_gap" style_shadow_width="0" focusable="false"/>
    </lv_obj>
  </view>
</component>
