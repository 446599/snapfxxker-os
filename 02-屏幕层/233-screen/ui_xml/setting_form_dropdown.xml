<!-- Compact form row: label and dropdown -->
<!-- Used in macro edit forms for Type, On, Off, Toggle fields -->
<!-- C++ sets dropdown options, name, selection, and event callbacks -->
<component>
  <api>
    <prop name="label" type="string" default="Field:"/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" scrollable="false">
    <style name="styles.u1_form_row"/>
    <text_muted name="label" width="33%" long_mode="wrap" text="$label"/>
    <lv_dropdown name="dropdown" width="0" flex_grow="1" style_min_height="#u1_touch_target">
      <style name="styles.u1_settings_control"/>
      <style name="styles.u1_settings_control_focus" selector="focused"/>
    </lv_dropdown>
  </view>
</component>
