<!-- Timelapse Install Wizard Overlay -->
<!-- Step-progress wizard guiding users through moonraker-timelapse installation -->
<component>
  <view name="timelapse_install_overlay" extends="overlay_panel" title="Setup Timelapse" bg_color="#screen_bg" title_transform="none" title_font="#font_heading" title_color="#text">
    <lv_obj name="overlay_content" width="100%" flex_grow="1" style_pad_all="#u1_page_pad" scrollable="true" flex_flow="column" style_pad_row="#space_md" style_pad_top="8" style_pad_bottom="8" style_pad_left="12" style_pad_right="12" style_pad_gap="8" scrollbar_mode="auto">
      <!-- Step progress container (populated programmatically) -->
      <lv_obj name="step_container" width="100%" height="content" style_pad_all="#space_sm" style_bg_opa="0"/>
      <!-- Status text area -->
      <lv_obj name="status_container" width="100%" height="content" style_pad_all="#space_md" style_bg_color="#card_bg" style_radius="#border_radius" style_bg_opa="255">
        <text_body name="status_text" width="100%" text="Initializing..." style_text_color="#text" long_mode="wrap"/>
      </lv_obj>
      <!-- SSH instructions (hidden by default, shown in Step 3) -->
      <lv_obj name="ssh_instructions_container" width="100%" height="content" style_pad_all="#space_md" style_bg_color="#card_bg" style_radius="#border_radius" style_bg_opa="255" hidden="true">
        <lv_obj width="100%" height="content" flex_flow="column" style_pad_row="#space_sm" style_bg_opa="0">
          <text_body width="100%" text="Connect to your printer via SSH and run:" style_text_color="#text_muted" long_mode="wrap"/>
          <lv_obj width="100%" height="content" style_bg_color="#overlay_bg" style_radius="#border_radius" style_pad_all="#space_sm" style_bg_opa="255">
            <text_small name="ssh_commands" width="100%" text="cd ~&#10;git clone https://github.com/mainsail-crew/moonraker-timelapse.git&#10;cd moonraker-timelapse&#10;make install" style_text_color="#text" long_mode="wrap"/>
          </lv_obj>
          <text_small width="100%" text="After running the commands, tap Check Again below." style_text_color="#text_muted" long_mode="wrap"/>
        </lv_obj>
      </lv_obj>
      <!-- Action button (hidden by default, shown contextually) -->
    </lv_obj>
    <lv_obj width="100%" height="content" style_pad_left="12" style_pad_right="12" style_pad_bottom="8" style_pad_top="0" scrollable="false">
      <ui_button name="timelapse_setup_action" width="100%" text="Check Again" variant="primary" hidden="true" style_min_height="#u1_touch_target" style_radius="8" height="44" style_margin_bottom="0">
        <event_cb trigger="clicked" callback="on_timelapse_install_action"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
