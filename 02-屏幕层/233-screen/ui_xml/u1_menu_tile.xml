<component>
  <api>
    <prop name="label" type="string" default=""/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
    <prop name="description" type="string" default=""/>
    <prop name="description_tag" type="string" default=""/>
    <prop name="bind_description" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
    <prop name="disabled" type="string" default=""/>
    <prop name="description_min_bp" type="int" default="0"/>
    <prop name="bind_label" type="string"/>
  </api>
  <view name="u1_menu_tile" extends="lv_button" width="48%" height="#u1_menu_tile_height" flex_grow="1" flex_flow="column" style_flex_main_place="space_between" style_pad_all="#u1_page_pad" style_pad_gap="#space_xs" scrollable="false" style_min_width="48%">
    <style name="styles.u1_card"/>
    <style name="styles.press_wash" selector="pressed"/>
    <bind_state_if_eq subject="$disabled" state="disabled" ref_value="1"/>
    <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" clickable="false" event_bubble="true" scrollable="false" style_flex_track_place="center">
      <icon name="row_icon" src="$icon" size="sm" variant="text" hidden_if_empty="$icon" clickable="false" event_bubble="true"/>
      <text_body name="label" width="0" flex_grow="1" text="$label" translation_tag="$label_tag" style_text_font="#font_body_bold" long_mode="dots" max_lines="2" clickable="false" event_bubble="true" bind_text="$bind_label"/>
    </lv_obj>
    <lv_obj name="description_wrap" width="100%" height="#u1_text_line" style_pad_all="0" hidden_if_empty="$description" scrollable="false" clickable="false" event_bubble="true">
      <text_small name="description" width="100%" text="$description" translation_tag="$description_tag" long_mode="dots" clickable="false" event_bubble="true"/>
    </lv_obj>
    <lv_obj name="status_wrap" width="100%" height="#u1_text_line" style_pad_all="0" hidden_if_empty="$bind_description" scrollable="false" clickable="false" event_bubble="true">
      <text_small name="status" width="100%" bind_text="$bind_description" long_mode="dots" clickable="false" event_bubble="true"/>
    </lv_obj>
    <event_cb trigger="clicked" callback="$callback"/>
  </view>
</component>
