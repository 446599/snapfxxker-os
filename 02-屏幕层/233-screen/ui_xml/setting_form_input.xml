<!-- Compact form row: label and text input -->
<!-- Used in macro edit forms for Name fields -->
<!-- C++ sets textarea text, name, and registers keyboard -->
<component>
  <api>
    <prop name="label" type="string" default="Field:"/>
    <prop name="placeholder" type="string" default=""/>
  </api>
  <view extends="lv_obj"
        width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" scrollable="false">
    <style name="styles.u1_form_row"/>
    <text_muted name="label" width="33%" long_mode="wrap" text="$label"/>
    <text_input name="input" width="0" style_min_height="#u1_touch_target" placeholder_text="$placeholder" one_line="true" flex_grow="1">
      <style name="styles.u1_settings_control"/>
      <style name="styles.u1_settings_control_focus" selector="focused"/>
    </text_input>
  </view>
</component>
