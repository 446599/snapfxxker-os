     ASSERT_TRUE(!pop(&w, &e));
 }
 
+static void follow_with_finite_move(uint8_t follower, uint8_t mover, bool reverse)
+{
+    struct world w;
+    world_init(&w);
+    uint8_t follower_bit = (uint8_t)(1u << follower);
+    w.in.insert = (uint8_t)(follower_bit | (1u << mover));
+    w.in.rest = (uint8_t)(0x0Fu ^ follower_bit);
+    w.in.pushed = follower_bit;
+    step(&w, 0, 0);
+    ASSERT_EQ(ace2k_feed_start(&w.feed, follower, ACE2K_FEED_CMD_ASSIST_BOTH, 0, 50000,
+                               22, w.now),
+              ACE2K_FEED_ACCEPTED);
+    step(&w, 0, 0);
+    ASSERT_TRUE(w.run[follower] && !w.reverse[follower]);
+    uint8_t command = reverse ? ACE2K_FEED_CMD_ROLLBACK : ACE2K_FEED_CMD_FEED;
+    ASSERT_EQ(ace2k_feed_start(&w.feed, mover, command, 40000, 30000, 37, w.now),
+              ACE2K_FEED_ACCEPTED);
+    step(&w, 0, 0);
+    ASSERT_TRUE(w.run[follower] && !w.reverse[follower]);
+    ASSERT_TRUE(w.run[mover] && w.reverse[mover] == reverse);
+    ace2k_feed_stop(&w.feed, mover, w.now);
+    ASSERT_TRUE(!w.run[mover]);
+    ASSERT_TRUE(w.run[follower] && !w.reverse[follower]);
+    ASSERT_EQ(ace2k_feed_mode(&w.feed, follower), ACE2K_FEED_FOLLOWING);
+    ASSERT_EQ(ace2k_feed_seq(&w.feed, follower), 22);
+    struct ace2k_feed_event event;
+    ASSERT_TRUE(pop(&w, &event));
+    ASSERT_EQ(event.lane, mover);
+    ASSERT_EQ(event.seq, 37);
+    ASSERT_EQ(event.kind, ACE2K_FEED_STOPPED);
+    ASSERT_TRUE(!pop(&w, &event));
+    ace2k_feed_stop(&w.feed, follower, w.now);
+}
+
+TEST(all_distinct_lane_pairs_keep_following_through_finite_feed_and_rollback)
+{
+    for (uint8_t follower = 0; follower < ACE2K_LANE_COUNT; follower++) {
+        for (uint8_t mover = 0; mover < ACE2K_LANE_COUNT; mover++) {
+            if (follower != mover) {
+                follow_with_finite_move(follower, mover, false);
+                follow_with_finite_move(follower, mover, true);
+            }
+        }
+    }
+}
