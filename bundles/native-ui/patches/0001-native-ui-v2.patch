+    CHECK(slot.get_remaining_percent() == -1.0f);
+    slot = SlotInfo{};
+    apply_spool_weights(slot, spools, json::object(), 1, 2);
+    CHECK(slot.remaining_weight_g == -1.0f);
+    CHECK(slot.total_weight_g == SlotInfo{}.total_weight_g);
+    slot.remaining_weight_g = 125.0f;
+    slot.total_weight_g = 500.0f;
+    apply_spool_weights(slot, spools, json::object(), 1, 2);
+    CHECK(slot.remaining_weight_g == 125.0f);
+    CHECK(slot.total_weight_g == 500.0f);
+    apply_spool_weights(slot, {{"5", {{"weight_g", -4}, {"weight_initial_g", "1000"}}}}, bindings, 1, 2);
+    CHECK(slot.remaining_weight_g == -1.0f);
+    CHECK(slot.get_remaining_percent() == -1.0f);
+}
+
+TEST_CASE("multiace location hold distinguishes delta omission from explicit clear", "[multiace][inventory]") {
+    CHECK_FALSE(parse_ace_status(json::object()).location_hold);
+    const auto held = parse_ace_status({{"location_hold", {{"active", true}, {"head", 3},
+        {"reason", "position_unconfirmed_after_seek"}}}});
+    REQUIRE(held.location_hold);
+    CHECK(held.location_hold->active);
+    CHECK(held.location_hold->head == 3);
+    const auto clear = parse_ace_status({{"location_hold", {{"active", false}}}});
+    REQUIRE(clear.location_hold);
+    CHECK_FALSE(clear.location_hold->active);
+    EnvironmentData environment;
+    environment.temperature_c = 0;
+    environment.temperature_available = true;
+    CHECK(environment.has_temperature());
+}
