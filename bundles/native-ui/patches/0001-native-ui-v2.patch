+    const json bindings = {{"1_2", "5"}, {"0_2", "6"}};
+    apply_spool_weights(slot, spools, bindings, 1, 2);
+    CHECK(slot.remaining_weight_g == 240.0f);
+    CHECK(slot.get_remaining_percent() == Catch::Approx(30.0f));
