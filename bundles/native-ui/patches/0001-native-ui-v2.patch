+void apply_spool_weights(SlotInfo& slot, const json& spools, const json& bindings,
+                         int ace, int bay) {
+    const std::string key = std::to_string(ace) + "_" + std::to_string(bay);
+    const auto* binding = field(bindings, key.c_str());
+    if (!binding || !binding->is_string()) {
+        return;
+    }
+    slot.remaining_weight_g = -1;
+    slot.total_weight_g = 0;
+    const auto* spool = field(spools, binding->get<std::string>().c_str());
+    if (!spool || !spool->is_object()) {
+        return;
+    }
+    if (const auto weight = float_of(field(*spool, "weight_g"));
+        weight && std::isfinite(*weight) && *weight >= 0) {
+        slot.remaining_weight_g = *weight;
+    }
+    if (const auto initial = float_of(field(*spool, "weight_initial_g"));
+        initial && std::isfinite(*initial) && *initial > 0) {
+        slot.total_weight_g = *initial;
+    }
+}
