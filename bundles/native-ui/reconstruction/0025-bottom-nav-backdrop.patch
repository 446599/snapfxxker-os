+/// A bottom navbar remains live while an ordinary destination overlay is open.
+/// Its dismiss backdrop must stop at the same content boundary as the overlay.
+/// This belongs to navigation's backdrop only: confirmation modals still cover
+/// the full screen and deliberately intercept taps on the navbar.
+void fit_above_bottom_nav(lv_obj_t* backdrop, lv_obj_t* screen) {
+    if (!backdrop || !screen)
+        return;
+    lv_obj_t* navbar = lv_obj_find_by_name(screen, "navbar");
+    if (!navbar || lv_obj_get_width(navbar) < lv_obj_get_width(screen))
+        return;
+
+    // DECLARATIVE_OK: this snapshot/dim object has no XML component. Use the
+    // same live geometry resolver as the overlay rather than another 46px rule.
+    ui_set_overlay_geometry(backdrop, true);
+    if (is_snapshot_backdrop(backdrop)) {
+        // TILE draws the full-size snapshot 1:1 and clips to the smaller object
+        // rectangle. STRETCH would compress the navbar into the content image;
+        // TOP_LEFT alone can draw beyond the image widget's bounds in LVGL.
+        lv_image_set_inner_align(backdrop, LV_IMAGE_ALIGN_TILE);
+    }
+}
+
 /// Longest transition, delay included, among the shown widgets on @p screen that
 /// are mid-transition right now; 0 when none is.
 uint32_t longest_running_transition(lv_obj_t* screen) {
@@ -79,6 +101,7 @@ void OverlayBackdrop::adopt(lv_obj_t* screen, lv_obj_t* arriving, lv_event_cb_t
