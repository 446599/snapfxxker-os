+TEST_CASE_METHOD(TempGraphOverlayPickFixture,
+                 "TempGraphOverlay: bed edits send nothing until a ready Apply",
+                 "[temp_graph_overlay][bed-draft]") {
+    TempGraphOverlay overlay;
+    overlay.init_subjects();
+    TempGraphOverlayTestAccess::set_deps(overlay, &state, &service);
+    TempGraphOverlayTestAccess::set_mode(overlay, TempGraphOverlay::Mode::Bed);
+    auto* ready = state.network_state().get_nav_buttons_enabled_subject();
+    auto* reported_target = state.temperature_state().get_bed_target_subject();
+    helix::ui::UpdateQueue::instance().drain();
+    lv_subject_set_int(ready, 1);
+    lv_subject_set_int(reported_target, 550);
+    client.clear_gcode_script_history();
+
+    // Steppers and material presets share this draft entry point. Neither
+    // edits the reported target or emits a heater command.
+    TempGraphOverlayTestAccess::stage_bed_target(overlay, 600);
+    TempGraphOverlayTestAccess::stage_bed_target(overlay, 650);
+    CHECK(TempGraphOverlayTestAccess::bed_draft(overlay) == 650);
+    CHECK(lv_subject_get_int(reported_target) == 550);
+    CHECK(client.gcode_script_history().empty());
+
+    // A keypad stacks above the overlay. Its confirmation must remain a
+    // draft update even after that deactivation, never a hidden heater send.
+    TempGraphOverlayTestAccess::capture_bed_keypad(overlay);
+    overlay.on_deactivate(DeactivateReason::NavigateAway);
+    TempGraphOverlayTestAccess::keypad_confirm(overlay, 72.0f);
+    CHECK(TempGraphOverlayTestAccess::bed_draft(overlay) == 720);
+    CHECK(lv_subject_get_int(reported_target) == 550);
+    CHECK(client.gcode_script_history().empty());
+
+    // Losing readiness between edit and Apply cannot bypass the send guard.
+    lv_subject_set_int(ready, 0);
+    TempGraphOverlayTestAccess::stage_bed_target(overlay, 800);
+    TempGraphOverlayTestAccess::apply_bed_target(overlay);
+    CHECK(TempGraphOverlayTestAccess::bed_draft(overlay) == 720);
+    CHECK(client.gcode_script_history().empty());
+
+    lv_subject_set_int(ready, 1);
+    TempGraphOverlayTestAccess::apply_bed_target(overlay);
+    const auto& history = client.gcode_script_history();
+    REQUIRE(history.size() == 1);
+    CHECK(history.front().find("SET_HEATER_TEMPERATURE HEATER=heater_bed TARGET=72") !=
+          std::string::npos);
+}
