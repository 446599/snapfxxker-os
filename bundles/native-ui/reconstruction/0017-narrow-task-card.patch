@@ -639,6 +642,33 @@ void PrintStatusWidget::on_size_changed(int /*colspan*/, int /*rowspan*/, int wi
                   height_px, use_column ? "column" : "row", is_compact_);
 }
 
+void PrintStatusWidget::update_task_preview_fit() {
+    const int inset = theme_manager_get_spacing("u1_page_pad");
+    const int border = theme_manager_get_spacing("u1_border");
+    const int gap = theme_manager_get_spacing("u1_card_gap");
+    const int target = theme_manager_get_spacing("u1_touch_target");
+    const int button_pad = theme_manager_get_spacing("space_xs");
+    const lv_font_t* body_font = theme_manager_get_font("font_body");
+    const lv_font_t* icon_font = theme_manager_get_font("icon_font_sm");
+    const int icon_width = icon_font ? lv_font_get_line_height(icon_font) : target / 2;
+    const int files_width = ui::measure_text_px(lv_tr("选择文件"), body_font) + icon_width +
+                            button_pad + 2 * (button_pad + border);
+    const int reprint_width = ui::measure_text_px(lv_tr("重新打印"), body_font) +
+                              2 * (button_pad + border);
+    // The two text buttons share the available width equally. A queue button
+    // costs its own touch target only while the queue is visible.
+    int idle_actions_width = 2 * std::max(files_width, reprint_width) + gap;
+    if (lv_subject_get_int(&queue_hidden_subject_) == 0) {
+        idle_actions_width += target + gap;
+    }
+    const int print_actions_width = 2 * target + 3 * gap + icon_width +
+        ui::measure_text_px("999 / 999", body_font);
+    const int required_data_width = std::max(idle_actions_width, print_actions_width);
+    const int preview_width = theme_manager_get_spacing("u1_model_width");
+    const int data_width = last_width_px_ - 2 * (inset + border) - preview_width - inset;
+    lv_subject_set_int(&task_preview_visible_subject_, data_width >= required_data_width ? 1 : 0);
+}
