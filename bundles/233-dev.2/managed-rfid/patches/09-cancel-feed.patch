+                    gcmd.get_int('AUTO', None) is not None):
+                raise gcmd.error('无效的取消清理请求')
+            self._protected_unload_cancel(gcmd.get_int('CHANNEL'), gcmd.get_int('EXTRUDER'), gcmd)
+            return
         if action.get('kind') in ('measure', 'roundtrip', 'hotpark') and action.get('state') == 'running':
             raise gcmd.error('测量会话进行中，送料命令已拒绝')
