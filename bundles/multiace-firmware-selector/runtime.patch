+async def _acefw_verify_reconnected(ace, port, target):
+    import ace2k_update
+    _, version, protocol, _ = ace2k_update.IMAGES[target]
+    expected = "ace2k " + version if target == "ace2k" else version
+    deadline = time.monotonic() + 30
+    while True:
+        state = _parse_state(await _query_state())
+        for unit in state.get("aces", []):
+            if (unit["idx"] == ace and unit.get("connected") and unit.get("protocol") == protocol
+                    and os.path.realpath(unit.get("serial_path") or "") == os.path.realpath(port)
+                    and unit.get("firmware_live") == expected):
+                return expected
+        if time.monotonic() >= deadline:
+            raise RuntimeError(f"设备重连后未在原端口读到目标固件 {expected}")
+        await asyncio.sleep(0.5)
+
+
+async def _acefw_run_cross(ace, port, target):
+    import ace2k_update
+
+    def progress(pct, msg):
+        _acefw.update(pct=pct, msg=msg)
+        _trace.info("acefw: ACE %s: %s", ace, msg)
+
+    _, _, protocol, _ = ace2k_update.IMAGES[target]
+    handoff = ""
+    try:
+        _acefw["state"] = "flashing"
+        await ace2k_update.flash(
+            target, port, Path(_CFG_EXT_DIR) / "multiace" / "ace-calibration",
+            MOONRAKER_URL, progress)
+        handoff = f" PROTOCOL={protocol}"
+    except Exception as exc:
+        _acefw["error"] = str(exc)
+        _trace.warning("acefw: ACE %s update failed: %s", ace, exc)
+    finally:
+        _acefw["state"] = "resuming"
+        try:
+            await _mr_post("/printer/gcode/script",
+                           {"script": f"ACE_FW_RESUME ACE={ace}{handoff}"}, timeout=60.0)
+            if handoff:
+                version = await _acefw_verify_reconnected(ace, port, target)
+                _acefw["result"] = {"new": version, "verified": True, "app_alive": True}
+        except Exception as exc:
+            _acefw["error"] = " / ".join(filter(None, (_acefw["error"], f"重连验证: {exc}")))
+        _acefw["state"] = "error" if _acefw["error"] else "done"
+
+
