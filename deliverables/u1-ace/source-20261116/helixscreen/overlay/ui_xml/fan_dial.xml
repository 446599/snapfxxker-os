<!-- FanDial: Reusable Bambu-style 270-degree rotary arc fan control widget -->
<!-- Usage: <fan_dial fan_name="Part Fan" fan_id="fan" initial_value="0"/> -->
<component>
  <!-- Responsive fan tokens live in fan_tokens.xml (separate file to avoid
       component-scope conflicts with responsive suffix resolution) -->
  <api>
    <prop name="fan_name" type="string" default="Fan"/>
    <prop name="fan_id" type="string" default="fan"/>
    <prop name="initial_value" type="number" default="0"/>
  </api>
  <view name="fan_dial_root" extends="ui_card" width="#fan_card_base_width" height="#fan_card_height" style_min_width="#fan_card_min_width" style_max_width="#fan_card_max_width" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="center" style_pad_all="#u1_card_pad" style_pad_gap="0" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_radius="#u1_card_radius" style_border_width="1" style_border_color="#border">
    <!-- Fan name label at top (hidden via C++ when label_bottom=true) — non-clickable for event bubble -->
    <text_body name="name_label" width="100%" text="$fan_name" long_mode="dots" style_text_align="center" clickable="false" event_bubble="true"/>
    <!-- Arc dial core - shared component with arc + icon + speed label -->
    <fan_arc_core initial_value="$initial_value"/>
    <!-- Fan name label at bottom (hidden by default, shown via C++ when label_bottom=true) -->
    <text_tiny name="name_label_bottom" width="100%" text="$fan_name" long_mode="clip" style_text_align="center" hidden="true" style_pad_all="0" clickable="false" event_bubble="true"/>
    <!-- Off/On switch row at bottom. Height is content-sized so the
         switch's intrinsic height (which varies by screen breakpoint) doesn't
         clip against the card. Column-flex pad_gap is zeroed on the parent
         so this row sits flush against the arc above. -->
    <lv_obj name="button_row" width="100%" height="#u1_touch_target" style_pad_all="0" scrollable="false" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_sm">
      <ui_switch name="onoff_switch" size="tiny">
        <event_cb trigger="value_changed" callback="on_fan_dial_switch_changed"/>
      </ui_switch>
      <text_small name="onoff_label" text="Off" clickable="false" event_bubble="true"/>
    </lv_obj>
  </view>
</component>
