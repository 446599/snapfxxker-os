<!-- Reusable empty state placeholder component (icon + text) -->
<!-- Usage: <empty_state icon="wifi_off" text="No networks found" text_tag="No networks found"/> -->
<component>
  <api>
    <prop name="icon" type="string" default="inbox_outline"/>
    <prop name="text" type="string" default="No items"/>
    <prop name="text_tag" type="string" default=""/>
    <prop name="icon_size" type="string" default="lg"/>
    <prop name="icon_variant" type="string" default="secondary"/>
  </api>
  <view extends="lv_obj" width="100%" height="100%" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_pad_all="#u1_page_pad" style_bg_color="#screen_bg" style_bg_opa="255">
    <icon src="$icon" size="$icon_size" variant="$icon_variant"/>
    <text_muted text="$text" translation_tag="$text_tag" style_text_align="center" width="100%" style_max_width="#u1_modal_width" long_mode="wrap" style_text_font="#u1_body_font" style_text_color="#text"/>
  </view>
</component>
