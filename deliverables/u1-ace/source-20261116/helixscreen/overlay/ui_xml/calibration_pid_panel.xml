<!-- PID Tuning Calibration Panel -->
<!-- Interactive calibration using PID_CALIBRATE command for extruder or bed -->
<component>
  <styles>
    <style name="pid_heater_selected" bg_color="#primary" bg_opa="40" border_color="#primary"/>
    <style name="pid_heater_unselected" bg_color="#elevated_bg" bg_opa="255" border_color="#border"/>
    <!-- Material preset row.

         Four equal-width buttons cannot hold an arbitrary material name: the
         names come from subjects (preset_material_N_name), so their length is
         data, not layout. At MICRO a button is 46px and "Generic TPU" measures
         57px, which clipped to "eneric TP" — chopped at BOTH ends, because the
         label is centred and wider than the button that clips it
         (prestonbrown/helixscreen#1204). 800x480 clipped too (99px label, 73px button).

         Up to and including MEDIUM the row wraps to 2x2, which roughly doubles
         each button's width so the name fits on one line. MEDIUM needs it as
         much as MICRO does: font_small scales with the breakpoint (10px at
         MICRO, 16px at MEDIUM) while the button only reaches 73px, so a single
         row of four cannot hold a long name at any size below LARGE.

         layout="flex" must accompany flex_flow in a style — flex_flow alone is
         inert, since it is lv_obj_set_flex_flow() that sets both. -->
    <style name="presets_wrapped" layout="flex" flex_flow="row_wrap" flex_main_place="space_between"/>
    <style name="presets_single_row" layout="flex" flex_flow="row" flex_main_place="start"/>
    <!-- 48% (not 50%) leaves room for the inter-column gap.

         The tight horizontal padding matters: ui_button's default padding ate
         26px of an 87px button at TINY, leaving the label only 61px. "Generic
         TPU" needs ~63px at the TINY font (noto_sans_light_11), so it wrapped to
         a second line and the wrapped label — 30px in a 28px button — had "TPU"
         clipped off the bottom. Note long_mode="dots" does NOT save this case:
         LVGL only draws the ellipsis when the label's HEIGHT is bounded, and an
         auto-height label wraps instead. Reclaiming the padding keeps the name
         on one line and costs no vertical space. -->
    <style name="preset_btn_half" width="48%" flex_grow="0" pad_left="#space_xs" pad_right="#space_xs"/>
    <style name="preset_btn_grow" flex_grow="1" pad_left="#space_xs" pad_right="#space_xs"/>
  </styles>
  <view name="calibration_pid_panel" extends="lv_obj" width="#overlay_width_transient" height="100%" align="right_mid" style_bg_opa="255" style_bg_color="#screen_bg" style_pad_all="0" style_border_width="0" scrollable="false" flex_flow="column">
    <!-- Header Bar -->
    <header_bar name="overlay_header" title="Heater Calibration" hide_action_button="false" action_button_text="Start" action_button_callback="on_pid_start" action_button_disabled_cond="pid_cal_not_idle or nav_buttons_enabled eq 0" title_font="#u1_heading_font" title_color="#text"/>
    <!-- Content Area -->
    <lv_obj name="overlay_content" width="100%" flex_grow="1" style_pad_all="#u1_page_pad" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="false">
      <!-- Disable content when printer not connected or klippy not ready -->
      <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
      <!-- ================================================================== -->
      <!-- STATE: IDLE - Heater selection and target temperature -->
      <!-- ================================================================== -->
      <lv_obj name="state_idle" width="100%" flex_grow="1" style_pad_all="#u1_card_pad" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_pad_gap="#space_sm" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="0"/>
        <!-- Scrollable content -->
        <lv_obj name="idle_scroll" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <!-- Description -->
          <text_small width="100%" text="Optimizes temperature control for stable, consistent heating." style_text_color="#text_muted" long_mode="wrap"/>
          <!-- Method + Heater Selection, and the tool row under it -->
          <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_compact_gap" scrollable="false">
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_compact_gap" scrollable="false">
              <!-- Method selector (shown only on firmware with MPC support) -->
              <lv_obj name="method_selector" width="100%" height="#u1_touch_target" style_pad_all="0" flex_flow="row" style_pad_gap="#u1_compact_gap" style_flex_cross_place="center" scrollable="false" style_flex_track_place="center">
                <bind_flag_if_eq subject="cal_supports_mpc" flag="hidden" ref_value="0"/>
                <text_small width="#u1_header_back_width" text="Method" style_text_font="#u1_aux_font"/>
                <ui_button name="btn_method_mpc" width="0" height="100%" flex_grow="1" style_pad_ver="#u1_compact_gap" style_min_width="0" style_pad_hor="#u1_compact_gap" style_border_width="#u1_border" text="MPC" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style name="pid_heater_selected" subject="cal_method_is_mpc" ref_value="1"/>
                  <bind_style name="pid_heater_unselected" subject="cal_method_is_mpc" ref_value="0"/>
                  <event_cb trigger="clicked" callback="on_cal_method_mpc"/>
                </ui_button>
                <ui_button name="btn_method_pid" width="0" height="100%" flex_grow="1" style_pad_ver="#u1_compact_gap" style_min_width="0" style_pad_hor="#u1_compact_gap" style_border_width="#u1_border" text="PID" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style name="pid_heater_selected" subject="cal_method_is_mpc" ref_value="0"/>
                  <bind_style name="pid_heater_unselected" subject="cal_method_is_mpc" ref_value="1"/>
                  <event_cb trigger="clicked" callback="on_cal_method_pid"/>
                </ui_button>
              </lv_obj>
              <!-- Heater selector -->
              <lv_obj width="100%" height="#u1_touch_target" style_pad_all="0" flex_flow="row" style_pad_gap="#u1_compact_gap" style_flex_cross_place="center" scrollable="false">
                <text_small width="#u1_header_back_width" text="Heater" style_text_font="#u1_aux_font"/>
                <ui_button name="btn_heater_extruder" width="0" height="100%" flex_grow="1" style_pad_ver="#u1_compact_gap" style_min_width="0" style_pad_hor="#u1_compact_gap" style_border_width="#u1_border" text="Extruder" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style name="pid_heater_selected" subject="pid_heater_is_extruder" ref_value="1"/>
                  <bind_style name="pid_heater_unselected" subject="pid_heater_is_extruder" ref_value="0"/>
                  <event_cb trigger="clicked" callback="on_pid_heater_extruder"/>
                </ui_button>
                <ui_button name="btn_heater_bed" width="0" height="100%" flex_grow="1" style_pad_ver="#u1_compact_gap" style_min_width="0" style_pad_hor="#u1_compact_gap" style_border_width="#u1_border" text="Heated Bed" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style name="pid_heater_selected" subject="pid_heater_is_extruder" ref_value="0"/>
                  <bind_style name="pid_heater_unselected" subject="pid_heater_is_extruder" ref_value="1"/>
                  <event_cb trigger="clicked" callback="on_pid_heater_bed"/>
                </ui_button>
              </lv_obj>
            </lv_obj>
            <!-- Which extruder, on a printer with several heated heads -->
            <lv_obj name="pid_tool_row" width="100%" height="#u1_touch_target" style_pad_all="0" flex_flow="row" style_pad_gap="#u1_compact_gap" style_flex_cross_place="center" scrollable="false">
              <bind_flag_if cond="pid_cal_multi_tool eq 0 or pid_heater_is_extruder eq 0" flag="hidden"/>
              <text_small width="#u1_header_back_width" text="Tool" style_text_font="#u1_aux_font"/>
              <repeat count="pid_cal_tool_count">
                <ui_button name="pid_tool_${i}" style_min_width="0" style_pad_hor="#u1_compact_gap" style_border_width="#u1_border" width="0" height="#u1_touch_target" flex_grow="1" bind_text="pid_cal_tool_label_${i}" style_min_height="#u1_touch_target" style_radius="#u1_card_radius" style_pad_top="#u1_compact_gap" style_pad_bottom="#u1_compact_gap">
                  <bind_style name="pid_heater_selected" subject="pid_cal_tool_selected_${i}" ref_value="1"/>
                  <bind_style name="pid_heater_unselected" subject="pid_cal_tool_selected_${i}" ref_value="0"/>
                  <event_cb trigger="clicked" callback="on_pid_cal_tool" user_data="$i"/>
                </ui_button>
              </repeat>
            </lv_obj>
          </lv_obj>
          <!-- Two-column row: Temperature (left) + Fan slider (right) -->
          <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_md" scrollable="false">
            <!-- Left column: Target Temperature -->
            <lv_obj height="content" flex_grow="1" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_sm" style_border_color="#border" style_border_width="1">
              <text_body text="Target Temperature"/>
              <!-- Material Presets (Extruder) -->
              <lv_obj name="extruder_presets" width="100%" height="content" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false">
                <bind_style_if_le name="presets_wrapped" subject="ui_breakpoint" ref_value="3"/>
                <bind_style_if_ge name="presets_single_row" subject="ui_breakpoint" ref_value="4"/>
                <bind_flag_if_eq subject="pid_heater_is_extruder" flag="hidden" ref_value="0"/>
                <ui_button name="btn_preset_m0" height="#u1_touch_target" bind_text="preset_material_0_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_material"/>
                </ui_button>
                <ui_button name="btn_preset_m1" height="#u1_touch_target" bind_text="preset_material_1_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_material"/>
                </ui_button>
                <ui_button name="btn_preset_m2" height="#u1_touch_target" bind_text="preset_material_2_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_material"/>
                </ui_button>
                <ui_button name="btn_preset_m3" height="#u1_touch_target" bind_text="preset_material_3_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_material"/>
                </ui_button>
              </lv_obj>
              <!-- Material Presets (Bed) -->
              <lv_obj name="bed_presets" width="100%" height="content" style_pad_all="0" style_pad_gap="#space_xs" scrollable="false">
                <bind_style_if_le name="presets_wrapped" subject="ui_breakpoint" ref_value="3"/>
                <bind_style_if_ge name="presets_single_row" subject="ui_breakpoint" ref_value="4"/>
                <bind_flag_if_not_eq subject="pid_heater_is_extruder" flag="hidden" ref_value="0"/>
                <ui_button name="btn_preset_bed_m0" height="#u1_touch_target" bind_text="preset_material_0_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_bed_material"/>
                </ui_button>
                <ui_button name="btn_preset_bed_m1" height="#u1_touch_target" bind_text="preset_material_1_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_bed_material"/>
                </ui_button>
                <ui_button name="btn_preset_bed_m2" height="#u1_touch_target" bind_text="preset_material_2_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_bed_material"/>
                </ui_button>
                <ui_button name="btn_preset_bed_m3" height="#u1_touch_target" bind_text="preset_material_3_name" style_text_font="#font_small" long_mode="dots" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <bind_style_if_le name="preset_btn_half" subject="ui_breakpoint" ref_value="3"/>
                  <bind_style_if_ge name="preset_btn_grow" subject="ui_breakpoint" ref_value="4"/>
                  <event_cb trigger="clicked" callback="on_pid_preset_bed_material"/>
                </ui_button>
              </lv_obj>
              <!-- Temperature: [-] 200°C [+] -->
              <lv_obj width="100%" height="#button_height" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
                <ui_button name="btn_temp_down" width="#button_height" height="#button_height" text="-" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <event_cb trigger="clicked" callback="on_pid_temp_down"/>
                </ui_button>
                <lv_label name="temp_display" flex_grow="1" text="200°C" style_text_font="#font_heading" style_text_align="center" bind_text="pid_temp_display"/>
                <ui_button name="btn_temp_up" width="#button_height" height="#button_height" text="+" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                  <event_cb trigger="clicked" callback="on_pid_temp_up"/>
                </ui_button>
              </lv_obj>
            </lv_obj>
            <!-- Vertical divider -->
            <divider_vertical/>
            <!-- Right column: Fan + Warning (always visible) -->
            <lv_obj height="content" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm">
              <!-- Part Cooling Fan (PID + extruder only) -->
              <lv_obj name="fan_speed_section" width="100%" height="content" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_sm" style_flex_main_place="center" style_border_color="#border" style_border_width="1">
                <bind_flag_if_eq subject="cal_show_pid_fan" flag="hidden" ref_value="0"/>
                <text_body text="Part Cooling Fan"/>
                <lv_obj width="100%" height="content" style_pad_top="#space_md" style_pad_bottom="#space_md" style_pad_left="#space_lg" style_pad_right="#space_md" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
                  <lv_slider name="fan_speed_slider" flex_grow="1" min_value="0" max_value="100" value="0"/>
                  <lv_label name="fan_speed_label" width="40" text="0%" style_text_font="#font_small" style_text_align="right" bind_text="cal_fan_speed_text"/>
                </lv_obj>
                <text_small width="100%" text="Match your typical print fan speed" long_mode="wrap" style_text_color="#text_muted"/>
              </lv_obj>
              <!-- Fan Calibration (MPC + extruder only) -->
              <lv_obj name="fan_calibration_section" width="100%" height="content" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_sm" style_border_color="#border" style_border_width="1">
                <bind_flag_if_eq subject="cal_show_fan_config" flag="hidden" ref_value="0"/>
                <text_body text="Fan Calibration"/>
                <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_xs" scrollable="false">
                  <ui_button name="btn_fan_quick" height="#u1_touch_target" flex_grow="1" text="Quick" style_text_font="#font_small" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                    <bind_style name="pid_heater_selected" subject="cal_fan_is_quick" ref_value="1"/>
                    <bind_style name="pid_heater_unselected" subject="cal_fan_is_quick" ref_value="0"/>
                    <event_cb trigger="clicked" callback="on_cal_fan_quick"/>
                  </ui_button>
                  <ui_button name="btn_fan_detailed" height="#u1_touch_target" flex_grow="1" text="Detailed" style_text_font="#font_small" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                    <bind_style name="pid_heater_selected" subject="cal_fan_is_detailed" ref_value="1"/>
                    <bind_style name="pid_heater_unselected" subject="cal_fan_is_detailed" ref_value="0"/>
                    <event_cb trigger="clicked" callback="on_cal_fan_detailed"/>
                  </ui_button>
                  <ui_button name="btn_fan_thorough" height="#u1_touch_target" flex_grow="1" text="Thorough" style_text_font="#font_small" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                    <bind_style name="pid_heater_selected" subject="cal_fan_is_thorough" ref_value="1"/>
                    <bind_style name="pid_heater_unselected" subject="cal_fan_is_thorough" ref_value="0"/>
                    <event_cb trigger="clicked" callback="on_cal_fan_thorough"/>
                  </ui_button>
                </lv_obj>
                <text_small width="100%" text="More points = more accurate, but takes longer." style_text_color="#text_muted" long_mode="wrap"/>
              </lv_obj>
              <!-- Heater Wattage (MPC migration only) -->
              <lv_obj name="wattage_section" width="100%" height="content" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_sm" style_border_color="#border" style_border_width="1">
                <bind_flag_if_eq subject="cal_show_wattage" flag="hidden" ref_value="0"/>
                <text_body text="Heater Power"/>
                <lv_obj width="100%" height="#button_height" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
                  <ui_button name="btn_wattage_down" width="#button_height" height="#button_height" text="-" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                    <event_cb trigger="clicked" callback="on_cal_wattage_down"/>
                  </ui_button>
                  <lv_label name="wattage_display" flex_grow="1" text="50W" style_text_font="#font_heading" style_text_align="center" bind_text="cal_wattage_display"/>
                  <ui_button name="btn_wattage_up" width="#button_height" height="#button_height" text="+" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
                    <event_cb trigger="clicked" callback="on_cal_wattage_up"/>
                  </ui_button>
                </lv_obj>
                <text_small text="Check your heater's rating (typically 40-60W for hotends)" style_text_color="#text_muted"/>
              </lv_obj>
            </lv_obj>
          </lv_obj>
        </lv_obj>
        <!-- Footer warnings (outside scroll, always at bottom) -->
        <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_xs" scrollable="false">
          <!-- Migration warning (MPC needs config change) -->
          <lv_obj name="migration_warning" width="100%" height="content" style_pad_all="#space_xs" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <bind_flag_if_eq subject="cal_needs_migration" flag="hidden" ref_value="0"/>
            <icon src="alert" size="sm" variant="warning"/>
            <text_small bind_text="cal_migration_notice" style_text_color="#text_muted" flex_grow="1" long_mode="wrap"/>
          </lv_obj>
          <!-- Duration warning (always visible) -->
          <lv_obj width="100%" height="content" style_pad_all="#space_xs" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <icon src="alert" size="sm" variant="warning"/>
            <text_small text="Takes 3-5 min. Do not interrupt." style_text_color="#text_muted" flex_grow="1"/>
          </lv_obj>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: CALIBRATING - Progress display -->
      <!-- ================================================================== -->
      <lv_obj name="state_calibrating" width="100%" flex_grow="1" style_pad_all="#u1_card_pad" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="1"/>
        <!-- Top row: spinner+status (left) | graph+temp (right) -->
        <!-- Abort Button -->
        <lv_obj name="state_calibrating_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver">
          <lv_obj width="100%" flex_grow="0" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#u1_card_gap" scrollable="false" height="124">
            <!-- Left: progress + labels -->
            <lv_obj height="100%" style_pad_all="4" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_flex_track_place="center" style_pad_gap="4" flex_grow="1" width="0">
              <text_heading text="Calibrating..." style_text_align="center"/>
              <text_muted name="calibrating_heater" text="Extruder PID Tuning" translation_tag="Extruder PID Tuning" bind_text="pid_calibrating_heater"/>
              <progress_bar name="pid_progress_bar" width="80%" bind_value="pid_cal_progress"/>
              <text_small name="pid_progress_text" bind_text="pid_progress_text" text="Starting..." style_text_color="#text_muted"/>
              <text_small name="pid_eta_text" bind_text="pid_cal_eta" text="" style_text_color="#text_muted"/>
            </lv_obj>
            <!-- Right: temperature graph + live display -->
            <lv_obj height="100%" flex_grow="1" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="4" flex_flow="column" style_flex_cross_place="center" style_pad_gap="4" style_border_color="#border" style_border_width="1" width="0">
              <!-- Temperature graph (populated by C++) -->
              <lv_obj name="pid_temp_graph_container" width="100%" flex_grow="1" style_pad_all="0" scrollable="false"/>
              <!-- Extruder temp (shown when extruder selected) -->
              <lv_obj width="content" height="content" style_pad_all="0" scrollable="false">
                <bind_flag_if_eq subject="pid_heater_is_extruder" flag="hidden" ref_value="0"/>
                <temp_display name="pid_temp_extruder" size="lg" show_target="true" bind_current="extruder_temp" bind_target="extruder_target"/>
              </lv_obj>
              <!-- Bed temp (shown when bed selected) -->
              <lv_obj width="content" height="content" style_pad_all="0" scrollable="false">
                <bind_flag_if_not_eq subject="pid_heater_is_extruder" flag="hidden" ref_value="0"/>
                <temp_display name="pid_temp_bed" size="lg" show_target="true" bind_current="bed_temp" bind_target="bed_target"/>
              </lv_obj>
              <text_small text="Current Temperature" style_text_color="#text_muted"/>
            </lv_obj>
          </lv_obj>
          <text_small width="100%" text="The heater will cycle on and off several times." style_text_align="left" style_text_color="#text_muted" long_mode="wrap"/>
        </lv_obj>
        <ui_button name="btn_abort" width="100%" icon="alert_octagon" text="Stop" variant="danger" style_min_height="#u1_touch_target" style_radius="#u1_card_radius" height="#u1_touch_target">
          <event_cb trigger="clicked" callback="on_pid_abort"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: SAVING - Saving configuration -->
      <!-- ================================================================== -->
      <lv_obj name="state_saving" width="100%" flex_grow="1" style_pad_all="#u1_card_pad" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="true" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="2"/>
        <spinner size="lg"/>
        <text_heading text="Saving Configuration..." style_text_align="left" width="100%" long_mode="wrap"/>
        <text_small width="100%" text="Klipper will restart to apply new settings." style_text_align="left" long_mode="wrap"/>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: COMPLETE - Results display -->
      <!-- ================================================================== -->
      <lv_obj name="state_complete" width="100%" flex_grow="1" style_pad_all="#u1_card_pad" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="3"/>
        <!-- Title row: icon + heading inline -->
        <!-- PID Technical details (hidden when MPC) -->
        <!-- MPC Technical details (shown when MPC) -->
        <!-- Spacer pushes Done button to bottom -->
        <lv_obj name="state_complete_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <lv_obj width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
            <icon src="check_circle" size="md" variant="success"/>
            <text_heading text="Calibration Complete!"/>
          </lv_obj>
          <text_body name="pid_result_summary" width="100%" bind_text="pid_result_summary" text="Temperature control has been optimized." style_text_align="left" style_text_color="#text_muted" long_mode="wrap"/>
          <lv_obj name="pid_results" width="70%" height="content" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_xs" style_border_color="#border" style_border_width="1">
            <bind_flag_if_eq subject="cal_method_is_mpc" flag="hidden" ref_value="1"/>
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" scrollable="false">
              <text_small text="Response (Kp)" style_text_color="#text_muted"/>
              <text_small name="pid_kp" bind_text="pid_kp" text="0.000"/>
            </lv_obj>
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" scrollable="false">
              <text_small text="Correction (Ki)" style_text_color="#text_muted"/>
              <text_small name="pid_ki" bind_text="pid_ki" text="0.000"/>
            </lv_obj>
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" scrollable="false">
              <text_small text="Damping (Kd)" style_text_color="#text_muted"/>
              <text_small name="pid_kd" bind_text="pid_kd" text="0.000"/>
            </lv_obj>
          </lv_obj>
          <lv_obj name="mpc_results" width="70%" height="content" style_bg_color="#card_bg" style_radius="#border_radius" style_pad_all="#space_md" flex_flow="column" style_pad_gap="#space_xs" style_border_color="#border" style_border_width="1">
            <bind_flag_if_eq subject="cal_method_is_mpc" flag="hidden" ref_value="0"/>
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" scrollable="false">
              <text_small text="Heat Capacity" style_text_color="#text_muted"/>
              <text_small bind_text="mpc_block_heat_capacity" text="0.0000 J/K"/>
            </lv_obj>
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" scrollable="false">
              <text_small text="Sensor Response" style_text_color="#text_muted"/>
              <text_small bind_text="mpc_sensor_responsiveness" text="0.000000 K/s/K"/>
            </lv_obj>
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" scrollable="false">
              <text_small text="Ambient Transfer" style_text_color="#text_muted"/>
              <text_small bind_text="mpc_ambient_transfer" text="0.000000 W/K"/>
            </lv_obj>
            <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="space_between" scrollable="false">
              <text_small text="Fan Transfer" style_text_color="#text_muted"/>
              <text_small bind_text="mpc_fan_ambient_transfer" text=""/>
            </lv_obj>
          </lv_obj>
          <text_small width="100%" text="Saved to printer configuration." style_text_align="left" style_text_color="#text_muted" long_mode="wrap"/>
          <lv_obj width="0" flex_grow="0" style_pad_all="0" scrollable="false" height="content"/>
        </lv_obj>
        <ui_button name="btn_done" width="100%" height="#u1_touch_target" text="Done" style_min_height="#u1_touch_target" style_radius="#u1_card_radius" style_margin_top="0" style_margin_bottom="0">
          <event_cb trigger="clicked" callback="on_pid_done"/>
        </ui_button>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: ERROR - Something went wrong -->
      <!-- ================================================================== -->
      <lv_obj name="state_error" width="100%" flex_grow="1" style_pad_all="#u1_card_pad" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver" height="0">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="4"/>
        <lv_obj name="state_error_scroll_body" width="100%" height="0" flex_grow="1" style_pad_all="0" flex_flow="column" style_pad_gap="#u1_card_gap" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
          <icon src="close_circle" size="lg" variant="danger"/>
          <text_heading text="Calibration Failed" style_text_align="left" width="100%" long_mode="wrap"/>
          <text_muted name="error_message" width="100%" text="An error occurred during calibration." translation_tag="An error occurred during calibration." style_text_align="left" long_mode="wrap" bind_text="pid_error_message"/>
        </lv_obj>
        <lv_obj width="100%" height="#u1_touch_target" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_margin_top="0" style_margin_bottom="0">
          <ui_button name="btn_close_error" width="0" text="Close" style_min_height="#u1_touch_target" style_radius="#u1_card_radius" flex_grow="1" height="#u1_touch_target" style_min_width="0">
            <event_cb trigger="clicked" callback="on_pid_done"/>
          </ui_button>
          <ui_button name="btn_retry" width="0" text="Retry" variant="primary" style_min_height="#u1_touch_target" style_radius="#u1_card_radius" flex_grow="1" height="#u1_touch_target" style_min_width="0">
            <event_cb trigger="clicked" callback="on_pid_retry"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <!-- ================================================================== -->
      <!-- STATE: MIGRATING - Updating config for MPC -->
      <!-- ================================================================== -->
      <lv_obj name="state_migrating" width="100%" flex_grow="1" style_pad_all="#u1_card_pad" flex_flow="column" style_flex_main_place="start" style_flex_cross_place="start" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="true" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_border_width="1" style_radius="#u1_card_radius" scroll_dir="ver">
        <bind_flag_if_not_eq subject="pid_cal_state" flag="hidden" ref_value="5"/>
        <spinner size="lg"/>
        <text_heading text="Updating Configuration..." style_text_align="left" width="100%" long_mode="wrap"/>
        <text_small width="100%" text="Switching heater control to MPC. Klipper will restart." style_text_align="left" style_text_color="#text_muted" long_mode="wrap"/>
      </lv_obj>
    </lv_obj>
  </view>
</component>
