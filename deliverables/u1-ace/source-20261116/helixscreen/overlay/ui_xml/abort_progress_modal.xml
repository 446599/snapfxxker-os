<!-- Abort Progress Modal - Shows progress during abort state machine execution -->
<!-- NOTE: Backdrop created manually on lv_layer_top() to survive screen changes -->
<!-- (Cannot use Modal::show() which defaults to lv_screen_active()) -->
<component>
  <view name="abort_progress_modal" extends="ui_dialog" width="90%" height="content" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" style_max_height="94%" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Content area with spinner and message -->
    <lv_obj width="100%" height="content" style_pad_left="#u1_page_pad" style_pad_right="#u1_page_pad" style_pad_top="#u1_page_pad" style_pad_bottom="#u1_page_pad" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_flex_track_place="center" style_pad_gap="#u1_card_gap" style_max_height="#dialog_content_max" scrollable="true" scroll_dir="ver" scrollbar_mode="auto">
      <!-- Spinner animation (Material Design style) -->
      <spinner size="lg"/>
      <!-- Progress message (dynamically bound to abort_progress_message subject) -->
      <text_muted name="abort_message_label" width="100%" bind_text="abort_progress_message" text="Processing..." translation_tag="Processing..." long_mode="wrap" style_text_align="center"/>
      <!-- E-Stop escape hatch -->
      <ui_button name="abort_estop_btn" width="100%" height="#button_height_lg" variant="danger" icon="alert_octagon" text="EMERGENCY STOP" style_margin_top="#space_sm" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
        <event_cb trigger="clicked" callback="on_abort_emergency_stop"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
