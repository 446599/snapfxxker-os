<!-- NOTE: Backdrop created programmatically by Modal system -->
<component>
  <view name="job_queue_modal" extends="ui_dialog" width="94%" height="94%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="4" style_pad_all="0" style_radius="8">
    <!-- Header row: icon + title + close button -->
    <lv_obj width="100%" height="44" style_pad_left="12" style_pad_right="12" style_pad_top="0" style_pad_bottom="0" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" scrollable="false">
      <lv_obj width="content" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" style_bg_opa="0%" style_border_width="0" clickable="false" scrollable="false">
        <icon src="progress_clock" size="#icon_size" variant="accent"/>
        <text_heading text="打印队列"/>
      </lv_obj>
      <ui_button name="btn_close" width="#button_height" height="44" variant="ghost" icon="close" focusable="false" style_radius="8">
        <event_cb trigger="clicked" callback="on_jq_modal_close"/>
      </ui_button>
    </lv_obj>
    <divider_horizontal/>
    <!-- Queue state row: shows Ready/Paused with toggle button -->
    <lv_obj width="100%" height="44" style_pad_left="12" style_pad_right="12" style_pad_top="0" style_pad_bottom="0" style_bg_opa="0%" style_border_width="0" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" clickable="false" scrollable="false">
      <text_muted name="queue_state_label" text="Queue: Ready"/>
      <ui_button name="btn_toggle_queue" height="44" text="Pause" variant="outline" style_radius="8">
        <event_cb trigger="clicked" callback="on_jq_modal_toggle_queue"/>
      </ui_button>
    </lv_obj>
    <!-- Scrollable job list container -->
    <lv_obj name="modal_job_list" width="100%" height="0" style_min_height="0" style_pad_left="12" style_pad_right="12" style_pad_top="#space_xs" style_pad_bottom="#space_sm" style_bg_opa="0%" style_border_width="0" flex_flow="column" style_pad_gap="8" scrollbar_mode="auto" clickable="false" flex_grow="1" style_pad_hor="#space_md" scrollable="true"/>
    <!-- Empty state -->
    <text_muted name="modal_empty_state" width="100%" text="No jobs in queue" style_text_align="center" style_pad_top="#space_md" style_pad_bottom="#space_md" hidden="true"/>
  </view>
</component>
