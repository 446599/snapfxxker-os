<!-- Beacon type-specific control panel for probe overlay -->
<component>
  <view name="probe_beacon_panel" extends="lv_obj" width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm" scrollable="false" style_bg_color="#screen_bg">
    <setting_section_header title="BEACON" icon="sine_wave"/>
    <!-- Sensor temperature readout -->
    <ui_card width="100%" height="content" style_border_width="1" style_pad_all="#u1_page_pad" scrollable="false" flex_flow="column" style_pad_gap="#space_sm" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_radius="#u1_card_radius">
      <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
        <icon src="thermometer" size="sm" variant="secondary"/>
        <text_body text="Sensor Temperature" flex_grow="1"/>
        <text_body bind_text="probe_beacon_temp" style_text_color="#primary"/>
      </lv_obj>
      <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md" scrollable="false">
        <icon src="check_circle" size="sm" variant="secondary"/>
        <text_body text="Temp Compensation" flex_grow="1"/>
        <text_small bind_text="probe_beacon_temp_comp_status" style_text_color="#text_muted"/>
      </lv_obj>
    </ui_card>
    <!-- Action buttons — 2 equal-width -->
    <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
      <ui_button name="btn_beacon_calibrate" width="1" height="#u1_touch_target" flex_grow="1" variant="secondary" text="Calibrate" icon="target" moves_machine="true" style_min_height="#u1_touch_target">
        <event_cb trigger="clicked" callback="on_beacon_calibrate"/>
      </ui_button>
      <ui_button name="btn_beacon_auto_cal" width="1" height="#u1_touch_target" flex_grow="1" variant="secondary" text="Auto Cal" icon="tune" moves_machine="true" style_min_height="#u1_touch_target">
        <event_cb trigger="clicked" callback="on_beacon_auto_cal"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
