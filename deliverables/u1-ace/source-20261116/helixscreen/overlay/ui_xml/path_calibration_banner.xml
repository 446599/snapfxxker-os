<component>
  <view extends="lv_obj" width="100%" height="content" style_min_height="#u1_touch_target" flex_flow="row" style_flex_cross_place="center" style_pad_hor="#u1_page_pad" style_pad_ver="#u1_compact_gap" style_pad_gap="#u1_card_gap" style_bg_color="#elevated_bg" style_bg_opa="255" scrollable="false">
    <bind_flag_if cond="not path_calibration_active" flag="hidden"/>
    <ui_button name="path_calibration_banner_return" text="返回校准" icon="chevron_left" icon_position="left" variant="ghost" height="#u1_touch_target" style_pad_hor="0">
      <event_cb trigger="clicked" callback="path_calibration_return"/>
    </ui_button>
    <text_small width="0" flex_grow="1" bind_text="path_calibration_banner_text" long_mode="wrap" style_text_color="#text"/>
    <ui_button name="path_calibration_banner_stop" text="停止" variant="secondary" height="#u1_touch_target">
      <event_cb trigger="clicked" callback="path_calibration_action" user_data="stop"/>
    </ui_button>
  </view>
</component>
