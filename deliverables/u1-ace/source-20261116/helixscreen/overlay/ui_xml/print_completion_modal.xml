<component>
  <!-- Print Completion Modal -->
  <!-- Note: Backdrop is created programmatically by Modal class in C++ -->
  <view name="print_completion_modal" extends="ui_dialog" width="94%" height="94%" align="center" flex_flow="column" style_flex_main_place="start" style_pad_gap="0" style_max_height="94%" style_pad_all="0" style_bg_color="#card_bg" style_bg_opa="255" style_radius="#border_radius" style_border_width="#u1_border" style_border_color="#border">
    <!-- Content area -->
    <lv_obj width="100%" height="0" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_lg" style_pad_bottom="#space_lg" flex_flow="column" style_flex_cross_place="center" style_pad_gap="#space_md" flex_grow="1" scrollable="true" scrollbar_mode="active" style_pad_all="#space_md">
      <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center" scrollable="false">
        <icon name="status_icon" src="check_circle" size="md" variant="success"/>
        <text_heading name="title_label" width="0" bind_text="print_completion_title" style_text_align="left" flex_grow="1"/>
      </lv_obj>
      <!-- Status icon (src/variant set imperatively - no XML binding for icon properties) -->
      <!-- Title bound to completion state subject -->
      <!-- Filename bound to subject -->
      <text_body name="filename_label" width="100%" bind_text="print_completion_filename" long_mode="dots" style_text_align="left" style_text_color="#text" style_text_font="#font_body_bold"/>
      <!-- Why a canceled or failed print ended; hidden when nothing says -->
      <text_body name="stop_reason_label" width="100%" bind_text="print_stop_reason" long_mode="wrap" style_text_align="left" style_text_color="#text_muted">
        <bind_flag_if_eq subject="print_stop_reason_visible" flag="hidden" ref_value="0"/>
      </text_body>
      <!-- Stats grid container -->
      <lv_obj name="stats_grid" width="100%" height="content" style_pad_all="0" flex_flow="row_wrap" style_flex_main_place="center" style_pad_gap="#space_sm">
        <!-- Duration stat -->
        <lv_obj height="content" style_pad_all="#space_sm" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" width="48%" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#border_radius">
          <icon src="clock" size="sm" variant="muted"/>
          <text_small name="duration_label" bind_text="print_completion_duration"/>
        </lv_obj>
        <!-- Slicer estimate stat (hidden when no estimate available) -->
        <lv_obj name="estimate_stat" width="48%" height="content" style_pad_all="#space_sm" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#border_radius">
          <bind_flag_if_eq subject="print_completion_has_estimate" flag="hidden" ref_value="0"/>
          <icon src="progress_clock" size="sm" variant="muted"/>
          <text_small name="estimate_label" bind_text="print_completion_estimate"/>
        </lv_obj>
        <!-- Layers stat -->
        <lv_obj height="content" style_pad_all="#space_sm" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" width="48%" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#border_radius">
          <icon src="layers" size="sm" variant="muted"/>
          <text_small name="layers_label" bind_text="print_completion_layers"/>
        </lv_obj>
        <!-- Filament stat (hidden when no filament data available) -->
        <lv_obj name="filament_stat" width="48%" height="content" style_pad_all="#space_sm" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_sm" style_bg_color="#elevated_bg" style_bg_opa="255" style_radius="#border_radius">
          <bind_flag_if_eq subject="print_completion_has_filament" flag="hidden" ref_value="0"/>
          <icon src="filament" size="sm" variant="muted"/>
          <text_small name="filament_label" bind_text="print_completion_filament"/>
        </lv_obj>
      </lv_obj>
    </lv_obj>
    <!-- Button row: OK always; "Start next: <name>" only while the queue has
         jobs — job_queue_count drives the secondary's visibility, the
         job_queue_start_next_text subject its label. -->
    <modal_button_row primary_text="OK" secondary_variant="primary" primary_callback="on_print_complete_ok" secondary_subject="job_queue_start_next_text" secondary_show_subject="job_queue_count" secondary_callback="on_print_complete_start_next"/>
  </view>
</component>
