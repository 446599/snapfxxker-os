            <lv_obj name="header_pos_x_group" width="0" height="100%" clickable="true" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="column" style_pad_gap="0" style_flex_cross_place="center" style_flex_track_place="center" flex_grow="1" style_flex_main_place="center">
              <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="x"/>
              <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="machine_motion_blocked" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="motion_x_homed" state="disabled" ref_value="0"/>
              <text_body name="header_pos_x_letter" text="X" height="#u1_text_line" clickable="false" event_bubble="true">
                <bind_style name="axis_letter_homed" subject="motion_x_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_x_homed" ref_value="0"/>
              </text_body>
              <text_heading name="header_pos_x" style_text_font="#u1_aux_font" bind_text="motion_pos_x" height="#u1_motion_value_height" clickable="false" event_bubble="true">
                <bind_style name="axis_value_homed" subject="motion_x_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_x_homed" ref_value="0"/>
              </text_heading>
            </lv_obj>
            <lv_obj name="header_pos_y_group" width="0" height="100%" clickable="true" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="column" style_pad_gap="0" style_flex_cross_place="center" style_flex_track_place="center" flex_grow="1" style_flex_main_place="center">
              <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="y"/>
              <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="machine_motion_blocked" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="motion_y_homed" state="disabled" ref_value="0"/>
              <text_body name="header_pos_y_letter" text="Y" height="#u1_text_line" clickable="false" event_bubble="true">
                <bind_style name="axis_letter_homed" subject="motion_y_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_y_homed" ref_value="0"/>
              </text_body>
              <text_heading name="header_pos_y" style_text_font="#u1_aux_font" bind_text="motion_pos_y" height="#u1_motion_value_height" clickable="false" event_bubble="true">
                <bind_style name="axis_value_homed" subject="motion_y_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_y_homed" ref_value="0"/>
              </text_heading>
            </lv_obj>
            <lv_obj name="header_pos_z_group" width="0" height="100%" clickable="true" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="column" style_pad_gap="0" style_flex_cross_place="center" style_flex_track_place="center" flex_grow="1" style_flex_main_place="center">
              <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="z"/>
              <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="machine_motion_blocked" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="motion_z_homed" state="disabled" ref_value="0"/>
              <text_body name="header_pos_z_letter" text="Z" height="#u1_text_line" clickable="false" event_bubble="true">
                <bind_style name="axis_letter_homed" subject="motion_z_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_z_homed" ref_value="0"/>
              </text_body>
              <text_heading name="header_pos_z" style_text_font="#u1_aux_font" bind_text="motion_pos_z" height="#u1_motion_value_height" clickable="false" event_bubble="true">
                <bind_style name="axis_value_homed" subject="motion_z_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_z_homed" ref_value="0"/>
              </text_heading>
            </lv_obj>

          </lv_obj>
            <ui_button name="header_pos_swap_coords" style_radius="#u1_card_radius" width="100%" height="#u1_touch_target" icon="swap_horizontal" text="目标 / 实际" variant="secondary" style_pad_all="0">
              <event_cb trigger="clicked" callback="on_motion_swap_coords_clicked"/>
            </ui_button>
          <text_small name="bed_map_unhomed_hint" width="100%" long_mode="wrap" text="请先归位所有轴以使用地图" style_text_color="#text_muted" style_text_align="center">
            <bind_flag_if cond="motion_tab ne 2 or (motion_x_homed eq 1 and motion_y_homed eq 1 and motion_z_homed eq 1)" flag="hidden"/>
          </text_small>

          <lv_obj name="z_controls" width="100%" height="#u1_touch_target" style_pad_all="0" scrollable="false" flex_flow="row" style_pad_gap="#u1_card_gap">
            <bind_flag_if_eq subject="motion_tab" flag="hidden" ref_value="2"/>
            <motion_jog_button name="z_up_small" width="0" flex_grow="1" height="100%" jog="z_up_fixed" style_radius="#u1_card_radius" icon="arrow_up" bind_icon="motion_z_up_icon" label="motion_z_up_tag" variant="secondary" moves_machine="true">
              <bind_state_if_eq subject="motion_z_up_blocked" state="disabled" ref_value="1"/>
            </motion_jog_button>
            <motion_jog_button name="z_down_small" width="0" flex_grow="1" height="100%" jog="z_down_fixed" style_radius="#u1_card_radius" icon="arrow_down" bind_icon="motion_z_down_icon" label="motion_z_down_tag" variant="secondary" moves_machine="true">
              <bind_state_if_eq subject="motion_z_down_blocked" state="disabled" ref_value="1"/>
            </motion_jog_button>
          </lv_obj>
          <lv_obj name="jog_modes" width="100%" height="#u1_touch_target" style_pad_all="0" scrollable="false" flex_flow="row" style_pad_gap="#u1_nav_icon_gap">
            <bind_flag_if_eq subject="motion_tab" flag="hidden" ref_value="2"/>
            <ui_button name="jog_mode_fine" style_radius="#u1_card_radius" width="0" flex_grow="1" height="100%" text="0.1 mm" style_pad_hor="0" variant="secondary" style_pad_top="#u1_card_pad" style_pad_bottom="#u1_card_pad">
              <bind_style_if_eq name="styles.choice_selected" subject="motion_z_fixed_step" ref_value="1"/>
              <bind_style_if_not_eq name="styles.choice_idle" subject="motion_z_fixed_step" ref_value="1"/>
              <event_cb trigger="clicked" callback="on_motion_fixed_z_step" user_data="1"/>
            </ui_button>
            <ui_button name="jog_mode_coarse" style_radius="#u1_card_radius" width="0" flex_grow="1" height="100%" text="1 mm" style_pad_hor="0" variant="secondary" style_pad_top="#u1_card_pad" style_pad_bottom="#u1_card_pad">
              <bind_style_if_eq name="styles.choice_selected" subject="motion_z_fixed_step" ref_value="10"/>
              <bind_style_if_not_eq name="styles.choice_idle" subject="motion_z_fixed_step" ref_value="10"/>
              <event_cb trigger="clicked" callback="on_motion_fixed_z_step" user_data="10"/>
            </ui_button>
            <ui_button name="jog_mode_turbo" style_radius="#u1_card_radius" width="0" flex_grow="1" height="100%" text="10 mm" style_pad_hor="0" variant="secondary" style_pad_top="#u1_card_pad" style_pad_bottom="#u1_card_pad">
              <bind_style_if_eq name="styles.choice_selected" subject="motion_z_fixed_step" ref_value="100"/>
              <bind_style_if_not_eq name="styles.choice_idle" subject="motion_z_fixed_step" ref_value="100"/>
              <event_cb trigger="clicked" callback="on_motion_fixed_z_step" user_data="100"/>
            </ui_button>
          </lv_obj>
          <lv_obj name="motion_actions" width="100%" height="#u1_touch_target" style_pad_all="0" scrollable="false" flex_flow="row" style_pad_gap="#u1_card_gap">
            <bind_flag_if cond="motion_tab eq 0 or motion_tab eq 2" flag="hidden"/>
            <ui_button name="motion_home_all" width="0" flex_grow="1" height="100%" text="回零" icon="home" variant="primary" moves_machine="true">
              <event_cb trigger="clicked" callback="on_motion_home" user_data="all"/>
            </ui_button>
            <ui_button name="header_pos_swap" width="#u1_touch_target" height="100%" icon="swap_horizontal" variant="secondary" style_pad_all="0">
              <event_cb trigger="clicked" callback="on_motion_swap_coords_clicked"/>
            </ui_button>
