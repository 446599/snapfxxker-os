            <lv_obj name="locate_pos_x_group" width="0" height="100%" clickable="true" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="row" style_pad_gap="#u1_card_gap" style_flex_cross_place="center" flex_grow="1" style_flex_main_place="center">
              <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="x"/>
              <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="machine_motion_blocked" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="motion_x_homed" state="disabled" ref_value="0"/>
              <text_small style_text_font="#u1_aux_font" text="X" clickable="false" event_bubble="true">
                <bind_style name="axis_letter_homed" subject="motion_x_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_x_homed" ref_value="0"/>
              </text_small>
              <text_body style_text_font="#u1_body_font" bind_text="motion_pos_x" clickable="false" event_bubble="true">
                <bind_style name="axis_value_homed" subject="motion_x_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_x_homed" ref_value="0"/>
              </text_body>
            </lv_obj>
            <lv_obj name="locate_pos_y_group" width="0" height="100%" clickable="true" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="row" style_pad_gap="#u1_card_gap" style_flex_cross_place="center" flex_grow="1" style_flex_main_place="center">
              <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="y"/>
              <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="machine_motion_blocked" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="motion_y_homed" state="disabled" ref_value="0"/>
              <text_small style_text_font="#u1_aux_font" text="Y" clickable="false" event_bubble="true">
                <bind_style name="axis_letter_homed" subject="motion_y_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_y_homed" ref_value="0"/>
              </text_small>
              <text_body style_text_font="#u1_body_font" bind_text="motion_pos_y" clickable="false" event_bubble="true">
                <bind_style name="axis_value_homed" subject="motion_y_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_y_homed" ref_value="0"/>
              </text_body>
            </lv_obj>
            <lv_obj name="locate_pos_z_group" width="0" height="100%" clickable="true" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" flex_flow="row" style_pad_gap="#u1_card_gap" style_flex_cross_place="center" flex_grow="1" style_flex_main_place="center">
              <event_cb trigger="clicked" callback="on_motion_pos_clicked" user_data="z"/>
              <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="machine_motion_blocked" state="disabled" ref_value="1"/>
              <bind_state_if_eq subject="motion_z_homed" state="disabled" ref_value="0"/>
              <text_small style_text_font="#u1_aux_font" text="Z" clickable="false" event_bubble="true">
                <bind_style name="axis_letter_homed" subject="motion_z_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_z_homed" ref_value="0"/>
              </text_small>
              <text_body style_text_font="#u1_body_font" bind_text="motion_pos_z" clickable="false" event_bubble="true">
                <bind_style name="axis_value_homed" subject="motion_z_homed" ref_value="1"/>
                <bind_style name="axis_unhomed" subject="motion_z_homed" ref_value="0"/>
              </text_body>
            </lv_obj>
            <ui_button name="locate_pos_swap" style_radius="#u1_card_radius" width="#u1_touch_target" height="#u1_touch_target" icon="swap_horizontal" variant="secondary" style_pad_all="0">
              <event_cb trigger="clicked" callback="on_motion_swap_coords_clicked"/>
            </ui_button>
          </lv_obj>
          <move_preset_grid height="0" flex_grow="1" style_min_height="#u1_locate_preset_min_height" style_max_height="#u1_locate_preset_max_height"/>
        </lv_obj>
        <lv_obj name="left_column" height="100%" style_pad_all="0" scrollable="false" flex_flow="column">
          <bind_flag_if_eq subject="motion_tab" flag="hidden" ref_value="1"/>
          <bind_style_if name="motion_left_ring" cond="motion_tab eq 0 and settings_motion_layout eq 0"/>
          <bind_style_if name="motion_left_full" cond="motion_tab eq 0 and settings_motion_layout ne 0"/>
          <bind_style_if name="motion_left_bed" cond="motion_tab eq 2"/>
          <lv_obj name="jog_row" width="100%" height="100%" style_pad_all="0" scrollable="false">
            <bind_flag_if cond="motion_tab ne 0 or settings_motion_layout ne 0" flag="hidden"/>
            <lv_obj name="jog_pad_wrapper" width="100%" height="100%" style_pad_all="0" scrollable="false">
              <lv_obj name="jog_pad_container" width="content" height="content" style_pad_all="0" scrollable="false" clickable="true" align="center"/>
            </lv_obj>
          </lv_obj>
          <lv_obj name="bed_tab" width="100%" height="100%" style_pad_all="0" scrollable="false">
            <bind_flag_if_not_eq subject="motion_tab" flag="hidden" ref_value="2"/>
            <motion_bed_map/>
          </lv_obj>
          <lv_obj name="jog_layout_slot" width="100%" height="100%" style_pad_all="0" scrollable="false">
            <bind_flag_if cond="motion_tab ne 0 or settings_motion_layout eq 0" flag="hidden"/>
            <motion_jog_layout/>
          </lv_obj>
        </lv_obj>
        <lv_obj name="right_column" width="0" height="100%" flex_grow="1" style_pad_all="0" scrollable="false" flex_flow="column" style_pad_gap="#u1_card_gap" style_flex_main_place="space_evenly">
