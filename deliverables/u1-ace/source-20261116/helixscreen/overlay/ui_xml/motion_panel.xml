            <bind_state_if_eq subject="controls_operation_in_progress" state="disabled" ref_value="1"/>
            <event_cb trigger="clicked" callback="on_motion_z_tilt"/>
          </ui_button>
        </lv_obj>
      </lv_obj>
      <else/>
      <!-- LANDSCAPE: 208px XY ring with compact coordinates and Z controls. -->
      <lv_obj name="overlay_content" width="100%" flex_grow="1" style_pad_hor="#u1_page_pad" style_pad_gap="#u1_card_gap" scrollable="false" flex_flow="row" style_flex_cross_place="center">
        <bind_state_if_not_eq subject="nav_buttons_enabled" state="disabled" ref_value="1"/>
        <bind_state_if_eq subject="machine_motion_blocked" state="disabled" ref_value="1"/>
        <bind_style_if name="motion_body_insets" cond="motion_tab ne 1"/>
        <bind_style_if name="locate_body_insets" cond="motion_tab eq 1"/>
        <lv_obj name="move_tab" width="100%" height="100%" style_pad_all="0" style_pad_gap="#u1_compact_gap" style_flex_main_place="center" scrollable="true" scroll_dir="ver" scrollbar_mode="auto" flex_flow="column">
          <bind_flag_if_not_eq subject="motion_tab" flag="hidden" ref_value="1"/>
