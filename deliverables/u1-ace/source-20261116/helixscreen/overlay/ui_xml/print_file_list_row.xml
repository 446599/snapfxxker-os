<component>
  <api>
    <prop name="filename" type="string"/>
    <prop name="file_size" type="string"/>
    <prop name="modified_date" type="string"/>
    <prop name="print_time" type="string"/>
  </api>
  <!-- List row container (children pass clicks through to parent) -->
  <view name="list_row" extends="lv_obj" width="100%" height="#u1_touch_target" style_bg_color="#card_bg" style_bg_opa="255" style_radius="#u1_card_radius" style_border_width="#u1_border" style_pad_ver="#u1_compact_gap" style_pad_hor="#u1_card_pad" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_flex_track_place="center" clickable="true" style_min_height="#u1_touch_target" style_pad_gap="#u1_compact_gap" style_border_color="#border">
    <style name="styles.press_wash" selector="pressed"/>
    <!-- Filename (flex-grow, left-aligned) -->
    <text_body name="row_filename" text="$filename" width="0" style_text_align="left" long_mode="dots" flex_grow="1" style_min_width="#u1_print_list_name_min_width" style_pad_all="0" clickable="false" style_text_font="filename_cjk"/>
    <!-- Status (centered) - contains icons for print history -->
    <lv_obj name="row_status" width="#u1_print_list_status_width" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_xxs" clickable="false">
      <!-- Currently printing indicator (accent = blue for info) -->
      <icon name="status_printing" src="clock" size="xs" variant="primary" hidden="true"/>
      <!-- Success count (number + checkmark) -->
      <lv_obj name="status_success_container" width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_xxs" hidden="true" clickable="false">
        <text_small name="status_success_count" text="" style_pad_all="0" clickable="false"/>
        <icon name="status_success_icon" src="check" size="xs" variant="success"/>
      </lv_obj>
      <!-- Failed indicator (error - something went wrong) -->
      <icon name="status_failed" src="alert" size="xs" variant="danger" hidden="true"/>
      <!-- Cancelled indicator (user stopped the print) -->
      <icon name="status_cancelled" src="cancel" size="xs" variant="warning" hidden="true"/>
    </lv_obj>
    <!-- Size (right-aligned) - hidden below MEDIUM, in lockstep with its header -->
    <text_small name="row_size" width="#u1_print_list_size_width" text="$file_size" style_text_align="right" flex_grow="0" style_pad_all="0" clickable="false">
      <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
    </text_small>
    <!-- Modified date (right-aligned) - hidden below MEDIUM, in lockstep with its header -->
    <text_small name="row_modified" width="#u1_print_list_modified_width" text="$modified_date" style_text_align="right" flex_grow="0" style_pad_all="0" clickable="false">
      <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="3"/>
    </text_small>
    <text_small name="row_print_time" width="#u1_print_list_time_width" text="$print_time" long_mode="clip" style_text_align="right" flex_grow="0" style_pad_all="0" clickable="false"/>
  </view>
</component>
