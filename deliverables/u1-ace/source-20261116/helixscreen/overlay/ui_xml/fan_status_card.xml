<component>
  <api>
    <prop name="fan_name" type="string" default="Fan"/>
    <prop name="speed_percent" type="number" default="0"/>
  </api>
  <view name="fan_status_card_root" extends="ui_card" width="49%" height="68" flex_flow="column" style_pad_all="0" style_pad_gap="0" scrollable="false" style_bg_color="#card_bg" style_bg_opa="255" style_radius="#u1_card_radius" style_border_width="1" style_border_color="#border">
    <lv_obj width="100%" height="content" flex_flow="row" style_pad_all="0" style_pad_hor="8" style_pad_top="4" style_flex_cross_place="center" scrollable="false">
      <text_body name="name_label" width="0" flex_grow="1" text="$fan_name" long_mode="dots" style_text_font="#u1_body_font" clickable="false" event_bubble="true"/>
      <text_small text="自动调节" style_text_color="#text_muted" clickable="false" event_bubble="true"/>
    </lv_obj>
    <lv_obj width="100%" height="0" flex_grow="1" style_pad_all="0" style_flex_main_place="center" style_flex_cross_place="center" scrollable="false">
      <text_heading name="speed_label" text="关" style_text_align="center" style_text_font="#font_progress" clickable="false" event_bubble="true"/>
    </lv_obj>
    <lv_obj name="auto_row" hidden="true" width="0" height="0"/>
    <lv_arc name="dial_arc" value="$speed_percent" min_value="0" max_value="100" hidden="true"/>
  </view>
</component>
