<component>
  <api>
    <prop name="label" type="string" default=""/>
    <prop name="bind_label" type="string" default=""/>
    <prop name="label_lines" type="int" default="1"/>
    <prop name="icon" type="string" default=""/>
    <prop name="description_lines" type="int" default="1"/>
    <prop name="description" type="string" default=""/>
    <prop name="bind_description" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
  </api>
  <view extends="lv_button" width="48%" height="#u1_menu_tile_height" flex_grow="1" flex_flow="row" style_pad_hor="#u1_card_pad" style_pad_ver="0" style_pad_gap="#u1_card_gap" style_flex_cross_place="center" style_flex_track_place="center" scrollable="false">
    <style name="styles.u1_card"/>
    <style name="styles.press_wash" selector="pressed"/>
    <lv_obj width="#u1_icon_badge" height="#u1_icon_badge" clickable="false" event_bubble="true" scrollable="false">
      <style name="styles.u1_icon_badge"/>
      <icon src="$icon" size="sm" variant="secondary" align="center" clickable="false" event_bubble="true"/>
    </lv_obj>
    <lv_obj width="0" height="content" flex_grow="1" flex_flow="column" style_pad_all="0" style_pad_gap="0" style_bg_opa="0" style_border_width="0" clickable="false" event_bubble="true" scrollable="false">
      <text_body name="label" width="100%" text="$label" bind_text="$bind_label" style_text_font="noto_sans_bold_18" long_mode="dots" max_lines="$label_lines" clickable="false" event_bubble="true"/>
      <text_small name="description" width="100%" text="$description" style_text_font="#u1_aux_font" long_mode="dots" max_lines="$description_lines" hidden_if_empty="$description" clickable="false" event_bubble="true"/>
      <text_small name="status" width="100%" bind_text="$bind_description" style_text_font="#u1_aux_font" long_mode="dots" max_lines="$description_lines" hidden_if_empty="$bind_description" clickable="false" event_bubble="true"/>
    </lv_obj>
    <icon src="chevron_right" size="sm" variant="muted" clickable="false" event_bubble="true"/>
    <event_cb trigger="clicked" callback="$callback"/>
  </view>
</component>
