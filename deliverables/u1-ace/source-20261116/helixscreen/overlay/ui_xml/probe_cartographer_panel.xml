<!-- Cartographer type-specific control panel for probe overlay -->
<component>
  <view name="probe_cartographer_panel" extends="lv_obj" width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm" scrollable="false" style_bg_color="#screen_bg">
    <setting_section_header title="CARTOGRAPHER" icon="sine_wave"/>
    <!-- Coil temperature readout -->
    <ui_card width="100%" height="content" style_border_width="1" style_pad_all="#u1_page_pad" scrollable="false" flex_flow="row" style_flex_cross_place="center" style_pad_gap="#space_md" style_bg_color="#card_bg" style_bg_opa="255" style_border_color="#border" style_radius="#u1_card_radius">
      <icon src="thermometer" size="sm" variant="secondary"/>
      <text_body text="Coil Temperature" flex_grow="1"/>
      <text_body bind_text="probe_carto_coil_temp" style_text_color="#primary"/>
    </ui_card>
    <!-- Action buttons — 2 equal-width -->
    <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
      <ui_button name="btn_carto_scan_cal" width="1" height="#u1_touch_target" flex_grow="1" variant="secondary" text="Scan Cal" icon="target" moves_machine="true" style_min_height="#u1_touch_target">
        <event_cb trigger="clicked" callback="on_carto_scan_cal"/>
      </ui_button>
      <ui_button name="btn_carto_touch_cal" width="1" height="#u1_touch_target" flex_grow="1" variant="secondary" text="Touch Cal" icon="tune" moves_machine="true" style_min_height="#u1_touch_target">
        <event_cb trigger="clicked" callback="on_carto_touch_cal"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
