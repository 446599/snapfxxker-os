<component>
  <api>
    <!-- Per-instance subject names, supplied by the widget at creation. They
         must exist before this component is parsed: a binding whose subject is
         missing at parse time is dropped permanently and silently. -->
    <prop name="tile_icon_subject" type="string" default=""/>
    <prop name="tile_label_subject" type="string" default=""/>
    <prop name="tile_dir_subject" type="string" default=""/>
    <prop name="tile_target_subject" type="string" default=""/>
  </api>
  <view name="panel_widget_bed_temperature"
        extends="lv_obj" height="100%" flex_grow="1" style_pad_all="0" scrollable="false">
    <ui_button name="bed_temp_btn"
               width="100%" height="100%" variant="ghost" style_border_width="0" focusable="false"
               style_flex_main_place="space_between">
      <style name="styles.overview_tile"/>
      <bind_state_if_not_eq subject="printer_connection_state" state="disabled" ref_value="2"/>
      <event_cb trigger="clicked" callback="bed_temp_clicked_cb"/>
      <text_body text="热床" width="100%" height="#u1_text_line" style_text_align="left" style_text_color="#text_muted"
                 clickable="false" event_bubble="true"/>
      <pass_through width="100%" height="#u1_emphasis_line">
        <style name="styles.overview_value_row"/>
        <temp_display name="bed_temp_text_label" size="lg" show_target="false"
                      bind_current="bed_temp"/>
        <icon src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true"/>
      </pass_through>
      <heater_icon src="radiator" glyph_name="bed_icon_glyph" size="xs" hidden="true"/>
    </ui_button>
  </view>
</component>
