<!-- Reusable connecting state component (spinner + text) -->
<!-- Usage: <connecting_state text="Connecting to network..." translation_tag="Connecting to network..."/> -->
<component>
  <api>
    <prop name="text" type="string" default="Connecting..."/>
  </api>
  <view extends="lv_obj" width="100%" height="100%" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#u1_card_gap" scrollable="false" style_pad_all="#u1_page_pad" style_bg_color="#screen_bg" style_bg_opa="255">
    <spinner size="lg"/>
    <text_muted text="$text" width="90%" long_mode="wrap" style_text_align="center" style_text_font="#font_body"/>
  </view>
</component>
