<component>
  <view name="printer_list_overlay" extends="overlay_panel" title="Manage Printers" bg_color="#screen_bg" title_transform="none" title_font="#u1_body_font" title_color="#text">
    <lv_obj name="overlay_content" width="100%" flex_grow="1" style_pad_top="#space_xs" style_pad_left="#space_sm" style_pad_right="#space_sm" style_pad_bottom="#space_xs" flex_flow="column" scrollable="true" style_pad_all="#space_sm" style_pad_gap="#u1_card_gap" scrollbar_mode="auto">
      <setting_group name="group_printer_switcher" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border" style_border_opa="255" style_bg_color="#card_bg" style_bg_opa="255" style_shadow_width="0">
        <!-- Printer Switcher navbar icon toggle -->
        <setting_toggle_row name="row_printer_switcher" label="Show Printer Switcher" icon="printer_3d" description="Show printer icon in navigation bar" subject="show_printer_switcher" callback="on_printer_switcher_changed"/>
      </setting_group>
      <setting_group name="group_printers" style_radius="#u1_card_radius" style_border_width="#u1_border" style_border_color="#border" style_border_opa="255" style_bg_color="#card_bg" style_bg_opa="255" style_shadow_width="0">
        <setting_group_header title="PRINTERS"/>
        <!-- Dynamic printer rows populated by C++ -->
        <lv_obj name="printer_list_container" width="100%" height="content" flex_flow="column" style_pad_left="#space_md" style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="0" style_pad_gap="#space_sm" scrollable="false"/>
        <!-- Add Printer button -->
        <lv_obj width="100%" height="content" style_pad_left="#space_lg" style_pad_right="#space_lg" style_pad_top="#space_md" style_pad_bottom="#space_md" scrollable="false" style_bg_opa="0" style_border_width="0">
          <ui_button name="btn_add_printer" width="100%" text="+ Add Printer" style_min_height="#u1_touch_target" style_radius="#u1_card_radius">
            <event_cb trigger="clicked" callback="printer_list_add_cb"/>
          </ui_button>
        </lv_obj>
      </setting_group>
    </lv_obj>
  </view>
</component>
