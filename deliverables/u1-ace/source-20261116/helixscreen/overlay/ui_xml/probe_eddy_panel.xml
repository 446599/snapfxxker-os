<!-- Eddy current probe type-specific control panel (BTT Eddy, Mellow Fly Eddy, etc.) -->
<component>
  <view name="probe_eddy_panel" extends="lv_obj" width="100%" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="#space_sm" scrollable="false" style_bg_color="#screen_bg">
    <setting_section_header title="EDDY CURRENT" icon="sine_wave"/>
    <!-- Action buttons — 2 equal-width -->
    <lv_obj width="100%" height="content" style_pad_all="0" flex_flow="row" style_pad_gap="#space_sm" scrollable="false">
      <ui_button name="btn_eddy_calibrate" width="1" height="#u1_touch_target" flex_grow="1" variant="secondary" text="Calibrate" icon="target" moves_machine="true" style_min_height="#u1_touch_target" style_radius="8">
        <event_cb trigger="clicked" callback="on_eddy_calibrate"/>
      </ui_button>
      <ui_button name="btn_eddy_drive_current" width="1" height="#u1_touch_target" flex_grow="1" variant="secondary" text="Drive Cal" icon="tune" moves_machine="true" style_min_height="#u1_touch_target" style_radius="8">
        <event_cb trigger="clicked" callback="on_eddy_drive_current"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
