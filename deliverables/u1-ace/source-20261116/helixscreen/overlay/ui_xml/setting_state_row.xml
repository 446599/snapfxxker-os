<!-- Auto-state mapping row: icon + label + dropdown (40% width) -->
<!-- Used in LED settings for each printer state (idle, heating, printing, etc.) -->
<!-- C++ sets dropdown options and event callbacks with state_key user_data -->
<component>
  <api>
    <prop name="label" type="string" default="State"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
  </api>
  <view extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_cross_place="center" style_bg_opa="0" style_border_width="0" scrollable="false" style_min_height="#u1_touch_target" style_flex_track_place="center">
    <bind_style_if_le name="styles.setting_row_compact" subject="ui_breakpoint" ref_value="1"/>
    <bind_style_if_ge name="styles.setting_row_standard" subject="ui_breakpoint" ref_value="2"/>
    <lv_obj scrollable="false">
      <style name="styles.u1_setting_icon_slot"/>
      <icon name="row_icon" src="$icon" size="sm" variant="secondary" align="center" hidden_if_empty="$icon"/>
    </lv_obj>
    <text_body name="label" width="0" long_mode="wrap" text="$label" translation_tag="$label_tag" flex_grow="1" style_text_font="#font_body_bold"/>
    <lv_dropdown name="dropdown" width="33%" style_min_height="#u1_touch_target" style_radius="#u1_card_radius" style_margin_top="2" style_margin_bottom="2">
      <style name="styles.u1_settings_control"/>
      <style name="styles.u1_settings_control_focus" selector="focused"/>
    </lv_dropdown>
  </view>
</component>
