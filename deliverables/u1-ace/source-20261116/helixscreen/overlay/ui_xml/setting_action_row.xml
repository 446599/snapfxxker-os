<!-- Reusable Settings Action Row Component -->
<!-- Responsive: compact padding on micro breakpoint, info icon for descriptions -->
<component>
  <api>
    <prop name="label" type="string" default="Action"/>
    <prop name="label_tag" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
    <prop name="description" type="string" default=""/>
    <prop name="description_tag" type="string" default=""/>
    <prop name="bind_description" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
    <prop name="disabled" type="string" default=""/>
    <!-- Hide static description when ui_breakpoint is below this value. Default 2 hides on
         micro/tiny; set to 0 to force the description visible at all breakpoints
         (also suppresses the (?) info icon). -->
    <prop name="description_min_bp" type="int" default="2"/>
    <!-- A short current value or status shown at the right, before the chevron. -->
    <prop name="value" type="string" default=""/>
    <prop name="value_tag" type="string" default=""/>
    <!-- "false" for a row that opens nothing: no chevron. Pass clickable="false"
         with it so the row takes no press either. -->
    <prop name="chevron" type="string" default="true"/>
  </api>
  <styles>
    <style name="label_enabled" text_color="#text"/>
    <style name="label_disabled" text_color="#text_subtle"/>
  </styles>
  <!-- Root button - receives all bubbled click events -->
  <view name="action_row" extends="lv_button" width="100%" height="content" style_bg_opa="0" style_border_width="0" style_shadow_width="0" style_radius="0" scrollable="false" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center" style_min_height="#u1_touch_target" style_flex_track_place="center">
    <style name="styles.press_wash" selector="pressed"/>
    <bind_state_if_eq subject="$disabled" state="disabled" ref_value="1"/>
    <bind_style_if_le name="styles.setting_row_compact" subject="ui_breakpoint" ref_value="1"/>
    <bind_style_if_ge name="styles.setting_row_standard" subject="ui_breakpoint" ref_value="2"/>
    <!-- Left side: Icon -->
    <lv_obj scrollable="false" clickable="false" event_bubble="true">
      <style name="styles.u1_setting_icon_slot"/>
      <icon hidden_if_empty="$icon" name="row_icon" src="$icon" size="sm" variant="secondary" align="center" clickable="false" event_bubble="true"/>
    </lv_obj>
    <!-- Middle: Label and optional description -->
    <lv_obj width="0" height="content" style_pad_all="0" flex_flow="column" style_pad_gap="0" flex_grow="1" scrollable="false" clickable="false" event_bubble="true">
      <text_body name="label" width="100%" text="$label" translation_tag="$label_tag" long_mode="wrap" style_text_font="#font_body_bold" clickable="false" event_bubble="true">
        <bind_style name="label_enabled" subject="$disabled" ref_value="0"/>
        <bind_style name="label_disabled" subject="$disabled" ref_value="1"/>
      </text_body>
      <!-- Wrappers carry emptiness; no binding writes their HIDDEN flag. -->
      <lv_obj name="description_wrap" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false" event_bubble="true" hidden_if_empty="$description">
        <text_small name="description" style_text_font="#u1_aux_font" width="100%" text="$description" translation_tag="$description_tag" long_mode="wrap" style_pad_top="#u1_compact_gap">
          <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="$description_min_bp"/>
        </text_small>
      </lv_obj>
      <lv_obj name="status_wrap" width="100%" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false" event_bubble="true" hidden_if_empty="$bind_description">
        <text_small name="status" width="100%" bind_text="$bind_description" long_mode="wrap" style_text_font="#u1_aux_font" style_pad_top="#u1_compact_gap"/>
      </lv_obj>
    </lv_obj>
    <!-- Info icon explains a static description; bound values have nothing to explain. -->
    <lv_obj name="info_wrap" width="content" height="content" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false" event_bubble="false" hidden_if_empty="$description">
      <lv_obj name="info_btn" width="#u1_touch_target" height="#u1_touch_target" style_pad_all="0" style_bg_opa="0" style_border_width="0" clickable="true" event_bubble="false" scrollable="false" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center">
        <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="$description_min_bp"/>
        <icon src="info_outline" size="sm" variant="muted" clickable="false" event_bubble="true"/>
        <event_cb trigger="clicked" callback="on_setting_info_clicked"/>
      </lv_obj>
    </lv_obj>
    <!-- The chevron remains at the right edge; long values share the row with the title. -->
    <text_muted name="value" style_max_width="36%" long_mode="wrap" text="$value" translation_tag="$value_tag" style_text_align="right" clickable="false" event_bubble="true" hidden_if_empty="$value"/>
    <icon name="chevron" src="chevron_right" size="xs" variant="muted" clickable="false" event_bubble="true" hidden_if_prop_eq="$chevron|false"/>
    <!-- Declarative event callback -->
    <event_cb trigger="clicked" callback="$callback"/>
    <!-- Content-height flex rows need a real track height to center short labels. -->
    <lv_obj name="row_height_anchor" width="0" height="#u1_touch_target" style_pad_all="0" style_border_width="0" style_bg_opa="0" scrollable="false" clickable="false">
      <bind_flag_if_ge subject="ui_breakpoint" flag="hidden" ref_value="2"/>
    </lv_obj>
  </view>
</component>
